{
  "apiVersion": "contracts.platform/v1alpha1",
  "kind": "AssuranceRegister",
  "metadata": {
    "name": "platform-assurance-register",
    "version": "1.0.0",
    "description": "Evidens- og risikoregister for platformen. Knytter krav til kontroller, ansvarlige personer og verificeret evidens; beskriver DPIA-screening, databehandleraftaler, underdatabehandlere og overførselsvurdering, AI Act-/NIS2-anvendelighed, incidentproces, adgangsrevision, informationspligt og kundens exitprocedure. Registeret er en påstand om mekanismer og beslutninger — ikke en certificering.",
    "accountableHuman": {
      "subject": "oidc|anna.andersen",
      "name": "Anna Andersen",
      "role": "Platform Owner"
    },
    "lastReviewed": "2026-09-24",
    "certificationClaim": false
  },
  "roleStatement": {
    "issuer": "Platformen stiller kontrakter, konformanstests og evidensmaskineri til rådighed og beviser dem i CI. Det gør ikke organisationen compliant.",
    "deployer": "Den ansvarlige organisation konfigurerer, driver og overvåger mekanismen, fører tilsyn og indberetter hændelser. Den bærer det juridiske ansvar.",
    "shared": "Ansvaret er delt: platformen leverer mekanismen, men den virker kun, hvis deployeren aktiverer den og reagerer på signalerne."
  },
  "applicability": [
    {
      "framework": "nis2",
      "use": "Drift af en multi-tenant AI- og automatiseringsplatform for kunder",
      "sector": "digital-infrastructure",
      "role": "deployer",
      "applicable": true,
      "assessedBy": {
        "subject": "oidc|cecilia.christensen",
        "name": "Cecilia Christensen",
        "role": "Security Owner"
      },
      "assessedAt": "2026-09-24",
      "rationale": "Platformen leverer en digital tjeneste i en sektor der er omfattet, og deployeren er en vigtig enhed. Anvendeligheden afhænger af kundens sektor og størrelse."
    },
    {
      "framework": "ai-act",
      "use": "AI-assisteret sagsbehandling og beslutningsstøtte med menneskeligt tilsyn",
      "sector": "horizontal",
      "role": "shared",
      "applicable": true,
      "assessedBy": {
        "subject": "oidc|anna.andersen",
        "name": "Anna Andersen",
        "role": "Platform Owner"
      },
      "assessedAt": "2026-09-24",
      "rationale": "Visse brugsscenarier kan være højrisiko efter brug og rolle; platformen stiller logning, transparens og menneskeligt tilsyn til rådighed, men klassifikationen er kundespecifik."
    },
    {
      "framework": "gdpr",
      "use": "Behandling af persondata på vegne af kunder som databehandler",
      "sector": "cross-sector",
      "role": "deployer",
      "applicable": true,
      "assessedBy": {
        "subject": "oidc|anna.andersen",
        "name": "Anna Andersen",
        "role": "Platform Owner"
      },
      "assessedAt": "2026-09-24",
      "rationale": "Persondata behandles for kunder, så GDPR er anvendelig. Den konkrete behandling, grundlag og retention er dokumenteret i dataregisteret."
    }
  ],
