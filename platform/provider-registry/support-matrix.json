{
  "apiVersion": "contracts.platform/v1alpha1",
  "kind": "ProviderSupportMatrix",
  "metadata": {
    "name": "platform-provider-support-matrix",
    "version": "1.0.0",
    "description": "Supportmatrix for udskiftning af providere. Hver række klassificerer et skift som drop-in, planlagt datamigration eller ikke-understøttet — aldrig som et generelt løfte om frit skift. Et planlagt skift kræver et migrationsbevis, id-/ACL-mapping og en menneskelig godkendelse; et ikke-understøttet skift afvises før ændring.",
    "accountableHuman": {
      "subject": "oidc|anna.andersen",
      "name": "Anna Andersen",
      "role": "Platform Owner",
      "substitute": {
        "subject": "oidc|bo.bertelsen",
        "name": "Bo Bertelsen",
        "role": "Platform Owner"
      }
    },
    "labels": {
      "tier": "provider-registry",
      "wave": "5"
    }
  },
  "modes": [
    { "id": "drop-in", "title": "Drop-in skift", "description": "Samme klasse og version/edition; alle obligatoriske capabilities og sikkerhedssemantikker bevares, så kun forbindelsesoplysningen ændres." },
    { "id": "planned-migration", "title": "Planlagt datamigration", "description": "Skiftet kræver et migrationsbevis med data-, ACL- og id-mapping samt afstemning, rollback og menneskelig godkendelse." },
    { "id": "unsupported", "title": "Ikke-understøttet skift", "description": "Skiftet kan ikke gennemføres uden at bryde en obligatorisk capability eller sikkerhedssemantik, eller uden migrationsbevis." }
  ],
  "rows": [
    {
      "id": "storage-filesystem-to-object-store",
      "class": "storage",
      "from": "filesystem-local",
      "to": "object-store-s3",
      "mode": "planned-migration",
      "reason": "Samme klasse og et stærkere sikkerhedsniveau, men objekter, ACL og id'er skal flyttes og afstemmes; derfor planlagt migration, ikke drop-in.",
      "requiresDataMigration": true,
      "requiresMigrationProof": true,
      "requiresIdMapping": true,
      "requiresAclMapping": true,
      "requiresHumanApproval": true,
      "requiresRollback": true,
      "oldProviderReadOnly": true,
      "revokeCredentials": true,
      "evidenceRef": "docs/spec/provider-contracts.md#backendudskiftning"
    },
    {
      "id": "storage-object-store-to-filesystem",
      "class": "storage",
      "from": "object-store-s3",
      "to": "filesystem-local",
      "mode": "unsupported",
      "reason": "Målet nedgraderer objektlås (WORM) og kryptering i hvile fra håndhævet til rådgivende, hvilket er en sikkerhedsmæssig nedgradering.",
      "requiresDataMigration": false,
      "requiresMigrationProof": false,
      "requiresIdMapping": false,
      "requiresAclMapping": false,
      "requiresHumanApproval": false,
      "requiresRollback": false,
      "oldProviderReadOnly": false,
      "revokeCredentials": false,
      "evidenceRef": "docs/spec/provider-contracts.md#ikke-understoettet-skift"
    },
    {
      "id": "database-sqlite-to-postgres",
      "class": "database",
      "from": "sqlite-local",
      "to": "postgres-managed",
      "mode": "planned-migration",
      "reason": "To forskellige SQL-motorer. Skiftet kræver skema- og datamigrering med afstemning, id-/ACL-bevarelse og rollback; en fælles SQL-dialekt er ikke et bevis.",
      "requiresDataMigration": true,
      "requiresMigrationProof": true,
      "requiresIdMapping": true,
      "requiresAclMapping": true,
      "requiresHumanApproval": true,
      "requiresRollback": true,
      "oldProviderReadOnly": true,
      "revokeCredentials": true,
      "evidenceRef": "docs/spec/provider-contracts.md#ingen-fri-sql-udskiftning"
    },
    {
      "id": "database-sqlite-to-mysql",
      "class": "database",
      "from": "sqlite-local",
      "to": "mysql-managed",
      "mode": "unsupported",
      "reason": "Målet mangler den obligatoriske capability database.row-tenant-isolation og håndhæver ikke kryptering i hvile. En fælles SQL-forbindelsesstreng må ikke omgå capability-gaten.",
      "requiresDataMigration": false,
      "requiresMigrationProof": false,
      "requiresIdMapping": false,
      "requiresAclMapping": false,
      "requiresHumanApproval": false,
      "requiresRollback": false,
      "oldProviderReadOnly": false,
      "revokeCredentials": false,
      "evidenceRef": "docs/spec/provider-contracts.md#manglende-obligatorisk-capability"
    },
    {
      "id": "iam-keycloak-to-entra",
      "class": "iam",
      "from": "keycloak-iam",
      "to": "entra-iam",
      "mode": "planned-migration",
      "reason": "IAM-skift skal bevare entydig menneskelig/agentidentitet og historisk audit-provenance, så det kræver datamigration, id-mapping og cutover.",
      "requiresDataMigration": true,
      "requiresMigrationProof": true,
      "requiresIdMapping": true,
      "requiresAclMapping": false,
      "requiresHumanApproval": true,
      "requiresRollback": true,
      "oldProviderReadOnly": true,
      "revokeCredentials": true,
      "evidenceRef": "docs/spec/provider-contracts.md#iam-skift"
    },
    {
      "id": "iam-keycloak-to-legacy-ldap",
      "class": "iam",
      "from": "keycloak-iam",
      "to": "legacy-ldap-iam",
      "mode": "unsupported",
      "reason": "Målet mangler MFA, entydig agentidentitet og audit-provenance; et IAM-skift må ikke nedgradere disse sikkerhedskritiske semantikker.",
      "requiresDataMigration": false,
      "requiresMigrationProof": false,
      "requiresIdMapping": false,
      "requiresAclMapping": false,
      "requiresHumanApproval": false,
      "requiresRollback": false,
      "oldProviderReadOnly": false,
      "revokeCredentials": false,
      "evidenceRef": "docs/spec/provider-contracts.md#iam-skift"
    },
    {
      "id": "modelprovider-local-to-external",
      "class": "modelprovider",
      "from": "local-llm",
      "to": "external-llm",
      "mode": "drop-in",
      "reason": "Begge providere håndhæver egresskontrol, tenantrouting, forbrugsmåling og streaming på samme niveau; kun forbindelsen skifter.",
      "requiresDataMigration": false,
      "requiresMigrationProof": false,
      "requiresIdMapping": false,
      "requiresAclMapping": false,
      "requiresHumanApproval": false,
      "requiresRollback": false,
      "oldProviderReadOnly": false,
      "revokeCredentials": true,
      "evidenceRef": "docs/spec/provider-contracts.md#drop-in-skift"
    },
    {
      "id": "modelprovider-local-to-basic",
      "class": "modelprovider",
      "from": "local-llm",
      "to": "external-llm-basic",
      "mode": "unsupported",
      "reason": "Målet mangler obligatorisk egresskontrol og tenantrouting og nedgraderer forbrugsmåling; det åbner for ukontrolleret egress.",
      "requiresDataMigration": false,
      "requiresMigrationProof": false,
      "requiresIdMapping": false,
      "requiresAclMapping": false,
      "requiresHumanApproval": false,
      "requiresRollback": false,
      "oldProviderReadOnly": false,
      "revokeCredentials": false,
      "evidenceRef": "docs/spec/provider-contracts.md#manglende-obligatorisk-capability"
    },
    {
      "id": "queue-sqlite-to-nats",
      "class": "queue",
      "from": "sqlite-queue",
      "to": "nats-queue",
      "mode": "planned-migration",
      "reason": "Kødata, outbox-poster og dead-letter skal flyttes og afstemmes; kræver planlagt migration.",
      "requiresDataMigration": true,
      "requiresMigrationProof": true,
      "requiresIdMapping": true,
      "requiresAclMapping": true,
      "requiresHumanApproval": true,
      "requiresRollback": true,
      "oldProviderReadOnly": true,
      "revokeCredentials": true,
      "evidenceRef": "docs/spec/provider-contracts.md#planlagt-datamigration"
    },
    {
      "id": "backup-vault-to-s3-immutable",
      "class": "backup",
      "from": "vault-local",
      "to": "s3-immutable",
      "mode": "planned-migration",
      "reason": "Backupmediet skifter og uforanderlighed håndhæves nu i målet; eksisterende backups skal verificeres i målet.",
      "requiresDataMigration": true,
      "requiresMigrationProof": true,
      "requiresIdMapping": true,
      "requiresAclMapping": false,
      "requiresHumanApproval": true,
      "requiresRollback": true,
      "oldProviderReadOnly": true,
      "revokeCredentials": true,
      "evidenceRef": "docs/spec/provider-contracts.md#planlagt-datamigration"
    },
    {
      "id": "apps-nextcloud-to-dkc-apps",
      "class": "apps",
      "from": "nextcloud",
      "to": "dkc-apps",
      "mode": "planned-migration",
      "reason": "Appmigration fra Nextcloud til platformens apps kræver fuld dækning for data, ACL, id-mapping og funktionstab; en appmigration uden dækningsbevis afvises.",
      "requiresDataMigration": true,
      "requiresMigrationProof": true,
      "requiresIdMapping": true,
      "requiresAclMapping": true,
      "requiresHumanApproval": true,
      "requiresRollback": true,
      "oldProviderReadOnly": true,
      "revokeCredentials": true,
      "evidenceRef": "docs/spec/provider-contracts.md#appmigration"
    },
    {
      "id": "apps-nextcloud-to-bookstack",
      "class": "apps",
      "from": "nextcloud",
      "to": "bookstack",
      "mode": "unsupported",
      "reason": "Forskellige applikationer med forskellige entitetssemantikker; der findes intet migrationsbevis, så et frit appskift afvises.",
      "requiresDataMigration": false,
      "requiresMigrationProof": false,
      "requiresIdMapping": false,
      "requiresAclMapping": false,
      "requiresHumanApproval": false,
      "requiresRollback": false,
      "oldProviderReadOnly": false,
      "revokeCredentials": false,
      "evidenceRef": "docs/spec/provider-contracts.md#appmigration"
    }
  ]
}
