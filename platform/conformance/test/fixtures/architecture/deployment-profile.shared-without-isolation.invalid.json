{
  "apiVersion": "contracts.platform/v1alpha1",
  "kind": "DeploymentProfile",
  "metadata": {
    "name": "bad-shared",
    "version": "1.0.0",
    "description": "Ugyldig: fælles kontrolplan uden særskilte app-instanser og databaser pr. kunde.",
    "accountableHuman": { "subject": "oidc|anna.andersen", "name": "Anna Andersen", "role": "Platform Owner" }
  },
  "profileType": "single-server",
  "tenantModel": {
    "mode": "shared-control-plane",
    "applicationInstancesPerTenant": false,
    "databasePerTenant": false,
    "tenantBoundaryEnforcedAt": ["storage"]
