  "highAvailability": { "enabled": false },
  "hostManagement": { "enabled": false },
  "dataServices": [
    {
      "id": "primary-db",
      "kind": "built-in-database",
      "provider": "PostgreSQL 16",
      "responsibilityOwner": { "subject": "oidc|anna.andersen", "name": "Anna Andersen", "role": "Platform Owner" },
      "credentialsRef": "secrets/primary-db",
      "tenantBound": true
    }
  ],
  "serviceTargets": { "availability": "99.0%", "rpoMinutes": 60, "rtoMinutes": 240 },
  "cost": { "model": "infrastructure", "currency": "DKK", "recurring": true, "notes": "Drift koster penge." },
  "limitations": ["Nedetid forekommer på single-server."]
}
