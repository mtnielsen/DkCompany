{
  "apiVersion": "contracts.platform/v1alpha1",
  "kind": "IdentityTrust",
  "metadata": {
    "name": "bad-unknown-root",
    "version": "1.0.0",
    "description": "Ugyldig: OIDC-issueren er ikke blandt de accepterede trust roots.",
    "accountableHuman": { "subject": "oidc|gitte.gundersen", "name": "Gitte Gundersen", "role": "Security Owner" }
  },
  "userAuthentication": {
    "protocol": "oidc",
    "issuer": "https://evil.example.net/realms/platform",
    "clientId": "dkcompany-portal",
    "mfa": "required",
    "pkceRequired": true,
    "subjectClaim": "sub",
    "groupsClaim": "groups"
  },
  "workloadIdentity": {
    "protocol": "spiffe",
    "trustDomain": "platform.example.org",
    "credentialMode": "just-in-time",
    "maxCredentialTtlSeconds": 900
  },
  "shadowIdentity": { "enabled": false, "passwordMode": "none", "localPasswordStore": false },
  "trustRoots": [
    {
      "id": "platform-oidc",
      "type": "oidc-issuer",
      "uri": "https://id.example.org/realms/platform",
      "owner": { "subject": "oidc|gitte.gundersen", "name": "Gitte Gundersen", "role": "Security Owner" }
    },
    {
      "id": "platform-spiffe",
      "type": "spiffe-trust-domain",
      "uri": "platform.example.org",
      "owner": { "subject": "oidc|gitte.gundersen", "name": "Gitte Gundersen", "role": "Security Owner" }
    }
  ],
  "tenantBinding": { "source": "oidc-claim", "claim": "tenant_id", "requireTenantClaim": true, "clientSelectable": false },
  "ambiguityPolicy": "reject"
}
