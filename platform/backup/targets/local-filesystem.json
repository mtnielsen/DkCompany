{
  "apiVersion": "contracts.platform/v1alpha1",
  "kind": "BackupTarget",
  "metadata": {
    "name": "local-filesystem",
    "version": "1.0.0",
    "description": "Lokalt/monteret backupmål på et separat medie. Bruges til staging og til at efterprøve preflight, canary og synkronisering uden en ekstern cloud.",
    "accountableHuman": {
      "subject": "oidc|anna.andersen",
      "name": "Anna Andersen",
      "role": "Platform Owner",
      "substitute": { "subject": "oidc|bo.bertelsen", "name": "Bo Bertelsen" }
    },
    "labels": { "tier": "backup", "protocol": "filesystem" }
  },
  "environment": "staging",
  "targetType": "nas",
  "support": {
    "status": "supported",
    "validatedAt": "2026-09-23T08:00:00Z",
    "validatedBy": { "subject": "oidc|cont.officer", "name": "Carla Officer", "role": "Continuity Officer" }
  },
  "endpoint": {
    "url": "file:///srv/backup/platform",
    "region": "on-prem",
    "bucket": "platform-backups"
  },
  "credentialsRef": "env:BACKUP_LOCAL_ACCESS",
  "tls": {
    "verify": true,
    "minVersion": "1.3",
    "caRef": null,
    "certSha256": null
  },
  "encryption": {
    "mode": "platform-managed",
    "keyRef": null,
    "keySeparated": true
  },
  "retention": {
    "days": 90,
    "immutability": {
      "required": false,
      "mode": "none",
      "verified": false,
      "evidenceRef": null,
      "minRetentionDays": null
    }
  },
  "schedule": { "cron": "0 2 * * *", "timezone": "Europe/Copenhagen" },
  "bandwidth": { "maxMbps": 100, "window": "22:00-05:00" },
  "failureDomain": { "id": "staging-local", "accessDomain": "staging-account", "region": "on-prem" },
  "recoveryOwner": { "subject": "oidc|cont.officer", "name": "Carla Officer", "role": "Continuity Officer" },
  "status": "approved",
  "approvedBy": { "subject": "oidc|anna.andersen", "name": "Anna Andersen", "role": "Platform Owner" },
  "approvedAt": "2026-09-23T09:00:00Z"
}
