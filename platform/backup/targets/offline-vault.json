{
  "apiVersion": "contracts.platform/v1alpha1",
  "kind": "BackupTarget",
  "metadata": {
    "name": "offline-vault",
    "version": "1.0.0",
    "description": "Offline/airgapped WORM-kopi i et separat fejl- og adgangsdomæne. Bruges som den tredje uafhængige kopi i 3-2-1-1-0; kun recovery-identiteten med to-personers godkendelse kan røre den.",
    "accountableHuman": {
      "subject": "oidc|anna.andersen",
      "name": "Anna Andersen",
      "role": "Platform Owner",
      "substitute": { "subject": "oidc|bo.bertelsen", "name": "Bo Bertelsen" }
    },
    "labels": { "tier": "backup", "protocol": "object-lock", "copyClass": "offline-immutable" }
  },
  "environment": "production",
  "targetType": "cloud",
  "support": {
    "status": "supported",
    "validatedAt": "2026-09-28T08:00:00Z",
    "validatedBy": { "subject": "oidc|cont.officer", "name": "Carla Officer", "role": "Continuity Officer" }
  },
  "endpoint": {
    "url": "https://vault.offline.example.org",
    "region": "on-prem-airgap",
    "bucket": "platform-offline-vault"
  },
  "credentialsRef": "vault:secret/data/backup/offline#access",
  "tls": {
    "verify": true,
    "minVersion": "1.3",
    "caRef": "vault:secret/data/backup/offline-ca#pem",
    "certSha256": null
  },
  "encryption": {
    "mode": "customer-managed",
    "keyRef": "kms:alias/platform-backup-offline",
    "keySeparated": true
  },
  "retention": {
    "days": 3650,
    "immutability": {
      "required": true,
      "mode": "object-lock-compliance",
      "verified": true,
      "evidenceRef": "data-protection/test/worm-store.test.mjs",
      "minRetentionDays": 365
    }
  },
  "schedule": { "cron": "0 3 * * 0", "timezone": "Europe/Copenhagen" },
  "bandwidth": { "maxMbps": 200, "window": "22:00-05:00" },
  "failureDomain": { "id": "airgap-vault", "accessDomain": "airgap-account", "region": "on-prem-airgap" },
  "recoveryOwner": { "subject": "oidc|cont.officer", "name": "Carla Officer", "role": "Continuity Officer" },
  "status": "approved",
  "approvedBy": { "subject": "oidc|anna.andersen", "name": "Anna Andersen", "role": "Platform Owner" },
  "approvedAt": "2026-09-28T09:00:00Z"
}
