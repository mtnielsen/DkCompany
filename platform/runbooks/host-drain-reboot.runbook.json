{
  "apiVersion": "contracts.platform/v1alpha1",
  "kind": "Runbook",
  "metadata": {
    "name": "host-drain-reboot",
    "version": "1.0.0",
    "description": "Dræner og genstarter én host i et annonceret vedligeholdelsesvindue med verificeret backup, canary og testet undrain-rollback.",
    "owner": {
      "team": "platform",
      "contact": "platform@example.org"
    },
    "accountableHuman": {
      "subject": "oidc|anna.andersen",
      "role": "Platform Owner",
      "name": "Anna Andersen"
    }
  },
  "scope": {
    "verbs": [
      "drain",
      "reboot",
      "restart"
    ],
    "targets": [
      "host/*"
    ],
    "environments": [
      "staging",
      "prod"
    ],
    "tenants": [
      "*"
    ]
  },
  "parameters": {
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hostRef": {
          "type": "string",
          "required": true
        },
        "nodeRef": {
          "type": "string"
        },
        "announcedDowntimeSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 900
        }
      }
    },
    "limits": {
      "maxDurationSeconds": 900,
      "maxTargets": 1
    }
  },
  "preconditions": [
    {
      "id": "backup-verified",
      "check": "backup",
      "expect": true
    },
    {
      "id": "host-enrolled",
      "check": "host-enrollment",
      "expect": true
    }
  ],
  "maxImpact": {
    "blastRadius": "single-target",
    "maxTargets": 1,
    "customerVisible": true,
    "maxDurationSeconds": 900
  },
  "expiry": {
    "approvedAt": "2026-09-01T00:00:00Z",
    "expiresAt": "2026-09-15T00:00:00Z",
    "maxAgeSeconds": 1209600
  },
  "attempts": {
    "maxAttempts": 2,
    "windowSeconds": 3600
  },
  "rollback": {
    "required": true,
    "method": "undrain",
    "runbookRef": "host-drain-reboot@1.0.0",
    "tested": true
  },
  "postchecks": [
    {
      "id": "node-healthy",
      "check": "node-health",
      "expect": "ready",
      "timeoutSeconds": 300,
      "onFailure": "rollback"
    }
  ],
  "approval": {
    "flow": "normal",
    "preApproved": false,
    "requiredApprovals": 1,
    "eligibleGroups": [
      "platform-approvers"
    ]
  },
  "signature": {
    "algorithm": "hmac-sha256",
    "keyId": "runbook-example-key",
    "value": "1e29dad447d2dc344e68f154e1da377befebb383af2855dcc6f79790a6469046",
    "signedAt": "2026-09-01T00:00:00Z"
  }
}
