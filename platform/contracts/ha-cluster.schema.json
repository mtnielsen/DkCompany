{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/contracts/ha-cluster.schema.json",
  "title": "HA Cluster",
  "description": "DKC-038: den konkrete HA-topologi og workload-HA-plan for en multi-server-installation. Planen erklærer quorum-medlemmer i adskilte fejldomæner, redundant ingress/DNS, replikaer og probes, topology spread, disruption budgets, ressourcegrænser, mTLS/certifikatrotation, default-deny-netværkspolitik, N+1-kapacitet og en eksplicit plan for stateful workloads. Skemaet håndhæver formen; conformance/src/ha.mjs håndhæver beslutningerne og kan ikke erstatte en målt failover.",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "hostingProfileRef",
    "failureDomains",
    "controlPlane",
    "ingress",
    "dns",
    "certificates",
    "network",
    "capacity",
    "workloads"
  ],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "contracts.platform/v1alpha1" },
    "kind": { "const": "HACluster" },
    "metadata": {
      "type": "object",
      "required": ["name", "version", "description", "accountableHuman"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "description": { "type": "string", "minLength": 20 },
        "accountableHuman": { "$ref": "#/$defs/human" },
        "labels": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "hostingProfileRef": { "type": "string", "pattern": "^catalog/profiles/[a-z0-9-]+\\.profile\\.json$" },
    "failureDomains": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 3 }
    },
    "controlPlane": {
      "type": "object",
      "required": ["topology", "members", "datastore", "failoverTargetSeconds"],
      "additionalProperties": false,
      "properties": {
        "topology": { "enum": ["three-member-quorum", "managed-ha-control-plane"] },
        "managedProvider": { "type": "string", "minLength": 3 },
        "members": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "failureDomain", "serverRef", "leaderEligible"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
              "failureDomain": { "type": "string", "minLength": 3 },
              "serverRef": { "type": "string", "minLength": 3 },
              "leaderEligible": { "type": "boolean" }
            }
          }
        },
        "datastore": {
          "type": "object",
          "required": ["type", "quorum", "writeMode", "fencing", "unsafeWritesOnQuorumLoss"],
          "additionalProperties": false,
          "properties": {
            "type": { "enum": ["etcd", "managed"] },
            "quorum": { "type": "integer", "minimum": 1 },
            "writeMode": { "enum": ["leader-elected", "single-writer", "quorum-commit"] },
            "fencing": { "enum": ["majority-quorum", "provider-fencing"] },
            "unsafeWritesOnQuorumLoss": { "const": false }
          }
        },
        "failoverTargetSeconds": { "type": "integer", "minimum": 1 }
      }
    },
    "ingress": {
      "type": "object",
      "required": ["controller", "replicas", "failureDomains", "healthCheck", "endpoints"],
      "additionalProperties": false,
      "properties": {
        "controller": { "type": "string", "minLength": 2 },
        "replicas": { "type": "integer", "minimum": 2 },
        "failureDomains": { "type": "integer", "minimum": 2 },
        "healthCheck": { "$ref": "#/$defs/probe" },
        "endpoints": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["id", "ip", "failureDomain", "healthy"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 2 },
              "ip": { "type": "string", "minLength": 3 },
              "failureDomain": { "type": "string", "minLength": 3 },
              "healthy": { "type": "boolean" }
            }
          }
        }
      }
    },
    "dns": {
      "type": "object",
      "required": ["zone", "records", "minHealthyTargets", "failover"],
      "additionalProperties": false,
      "properties": {
        "zone": { "type": "string", "minLength": 3 },
        "records": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "type", "targets"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "type": { "enum": ["A", "AAAA", "CNAME"] },
              "targets": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "type": "string", "minLength": 3 } }
            }
          }
        },
        "minHealthyTargets": { "type": "integer", "minimum": 2 },
        "failover": { "enum": ["health-checked", "provider-anycast", "round-robin"] }
      }
    },
    "certificates": {
      "type": "object",
      "required": ["mtlsRequired", "issuer", "rotationDays", "autoRotation", "peerIdentity"],
      "additionalProperties": false,
      "properties": {
        "mtlsRequired": { "const": true },
        "issuer": { "type": "string", "minLength": 3 },
        "rotationDays": { "type": "integer", "minimum": 1, "maximum": 90 },
        "autoRotation": { "const": true },
        "peerIdentity": { "enum": ["spiffe", "dns-san", "provider-identity"] }
      }
    },
    "network": {
      "type": "object",
      "required": ["plugin", "defaultDeny", "crossTenantDeny", "policies"],
      "additionalProperties": false,
      "properties": {
        "plugin": { "enum": ["cilium", "calico"] },
        "defaultDeny": { "const": true },
        "crossTenantDeny": { "const": true },
        "policies": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["default-deny", "allow-internal", "allow-ingress", "allow-dns"] }
        }
      }
    },
    "capacity": {
      "type": "object",
      "required": ["baselineCpuMillicores", "perMemberCpuMillicores", "memberCount", "nPlusOne", "reservePercent"],
      "additionalProperties": false,
      "properties": {
        "baselineCpuMillicores": { "type": "integer", "minimum": 1 },
        "perMemberCpuMillicores": { "type": "integer", "minimum": 1 },
        "memberCount": { "type": "integer", "minimum": 3 },
        "nPlusOne": { "const": true },
        "reservePercent": { "type": "integer", "minimum": 0, "maximum": 90 }
      }
    },
    "workloads": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/workload" }
    }
  },
  "$defs": {
    "human": {
      "type": "object",
      "required": ["subject", "name", "role"],
      "additionalProperties": false,
      "properties": {
        "subject": { "type": "string", "minLength": 3 },
        "name": { "type": "string", "minLength": 2 },
        "role": { "type": "string", "minLength": 2 },
        "substitute": {
          "type": "object",
          "required": ["subject", "name"],
          "additionalProperties": false,
          "properties": {
            "subject": { "type": "string", "minLength": 3 },
            "name": { "type": "string", "minLength": 2 }
          }
        }
      }
    },
    "probe": {
      "type": "object",
      "required": ["path", "port", "initialDelaySeconds", "periodSeconds", "failureThreshold"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "pattern": "^/" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "initialDelaySeconds": { "type": "integer", "minimum": 0 },
        "periodSeconds": { "type": "integer", "minimum": 1 },
        "failureThreshold": { "type": "integer", "minimum": 1 }
      }
    },
    "resources": {
      "type": "object",
      "required": ["requests", "limits"],
      "additionalProperties": false,
      "properties": {
        "requests": {
          "type": "object",
          "required": ["cpu", "memory"],
          "additionalProperties": false,
          "properties": {
            "cpu": { "type": "string", "minLength": 2 },
            "memory": { "type": "string", "minLength": 2 }
          }
        },
        "limits": {
          "type": "object",
          "required": ["cpu", "memory"],
          "additionalProperties": false,
          "properties": {
            "cpu": { "type": "string", "minLength": 2 },
            "memory": { "type": "string", "minLength": 2 }
          }
        }
      }
    },
    "workload": {
      "type": "object",
      "required": ["id", "kind", "stateless", "replicas", "serviceDiscovery", "mtls"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
        "kind": { "enum": ["deployment", "statefulset"] },
        "stateless": { "type": "boolean" },
        "replicas": { "type": "integer", "minimum": 1 },
        "serviceDiscovery": { "type": "boolean" },
        "mtls": { "type": "boolean" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "moduleRef": { "type": "string", "minLength": 2 },
        "probes": {
          "type": "object",
          "required": ["startup", "readiness", "liveness"],
          "additionalProperties": false,
          "properties": {
            "startup": { "$ref": "#/$defs/probe" },
            "readiness": { "$ref": "#/$defs/probe" },
            "liveness": { "$ref": "#/$defs/probe" }
          }
        },
        "topologySpread": {
          "type": "object",
          "required": ["domainLabel", "maxSkew", "whenUnsatisfiable"],
          "additionalProperties": false,
          "properties": {
            "domainLabel": { "type": "string", "minLength": 3 },
            "maxSkew": { "type": "integer", "minimum": 1 },
            "whenUnsatisfiable": { "enum": ["DoNotSchedule", "ScheduleAnyway"] }
          }
        },
        "disruptionBudget": {
          "type": "object",
          "required": ["minAvailable", "maxUnavailable"],
          "additionalProperties": false,
          "properties": {
            "minAvailable": { "type": "integer", "minimum": 1 },
            "maxUnavailable": { "type": "integer", "minimum": 0 }
          }
        },
        "resources": { "$ref": "#/$defs/resources" },
        "statefulPlan": {
          "type": "object",
          "required": ["writeMode", "activeWriters", "upstreamSupportsMultiWriter", "recoveryLocation", "nPlusOne"],
          "additionalProperties": false,
          "properties": {
            "writeMode": { "enum": ["leader-elected", "single-writer", "quorum-commit"] },
            "activeWriters": { "type": "integer", "minimum": 1 },
            "upstreamSupportsMultiWriter": { "type": "boolean" },
            "recoveryLocation": { "type": "string", "minLength": 3 },
            "nPlusOne": { "type": "boolean" }
          }
        }
      }
    }
  }
}
