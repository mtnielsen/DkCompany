{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/contracts/migration-export.schema.json",
  "title": "Migration Export",
  "description": "DKC-031: en selvbeskrivende exit-eksport med antal, checksum, hvilke facetter der er inkluderet og hver fils SHA-256. Eksporten kan læses af et standalone script uden en aktiv DkCompany-installation.",
  "type": "object",
  "required": ["apiVersion", "kind", "tenantId", "appId", "format", "version", "generatedAt", "recordCount", "checksum", "readableWithoutPlatform", "includes", "files"],
  "additionalProperties": true,
  "properties": {
    "apiVersion": { "const": "contracts.platform/v1alpha1" },
    "kind": { "const": "MigrationExport" },
    "tenantId": { "type": "string" },
    "appId": { "enum": ["files", "projects", "knowledge", "support", "crm"] },
    "format": { "const": "migration-export-bundle" },
    "version": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "recordCount": { "type": "integer", "minimum": 0 },
    "checksum": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "readableWithoutPlatform": { "const": true },
    "includes": {
      "type": "object",
      "required": ["ownership", "timestamps", "comments", "attachments", "acl", "links"],
      "additionalProperties": false,
      "properties": {
        "ownership": { "const": true },
        "timestamps": { "const": true },
        "comments": { "const": true },
        "attachments": { "const": true },
        "acl": { "const": true },
        "links": { "const": true }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "mediaType", "sha256"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "mediaType": { "type": "string", "minLength": 3 },
          "records": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "coverage": { "type": ["object", "null"] },
    "schema": { "type": "object", "additionalProperties": { "type": "string" } }
  }
}
