{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/contracts/provider-capability-catalog.schema.json",
  "title": "Provider Capability Catalog",
  "description": "DKC-059: et versionsstyret capability-katalog for udskiftelige providere. Hver klasse (IAM, modelprovider, database, lager, backup, kø og apps) har obligatoriske og sikkerhedskritiske capabilities med en minimumsversion, så en manglende capability eller en nedgradering kan afvises før et skift.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "levels", "classes", "capabilities"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "contracts.platform/v1alpha1" },
    "kind": { "const": "ProviderCapabilityCatalog" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "levels": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "rank", "title", "description"],
        "additionalProperties": false,
        "properties": {
          "id": { "enum": ["enforced", "advisory"] },
          "rank": { "type": "integer", "minimum": 1 },
          "title": { "type": "string", "minLength": 2 },
          "description": { "type": "string", "minLength": 10 }
        }
      }
    },
    "classes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "description"],
        "additionalProperties": false,
        "properties": {
          "id": { "enum": ["iam", "modelprovider", "database", "storage", "backup", "queue", "apps"] },
          "title": { "type": "string", "minLength": 3 },
          "description": { "type": "string", "minLength": 10 }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "class", "title", "mandatory", "securityCritical", "minVersion", "description"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*\\.[a-z][a-z0-9-]*$" },
          "class": { "enum": ["iam", "modelprovider", "database", "storage", "backup", "queue", "apps"] },
          "title": { "type": "string", "minLength": 3 },
          "mandatory": { "type": "boolean" },
          "securityCritical": { "type": "boolean" },
          "minVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+" },
          "description": { "type": "string", "minLength": 10 }
        }
      }
    }
  },
  "$defs": {
    "human": {
      "type": "object",
      "required": ["subject", "name", "role"],
      "additionalProperties": false,
      "properties": {
        "subject": { "type": "string", "pattern": "^[a-z][a-z0-9-]*\\|[a-z0-9][a-z0-9._-]{2,}$" },
        "name": { "type": "string", "minLength": 2 },
        "role": { "type": "string", "minLength": 2 },
        "substitute": { "$ref": "#/$defs/human" }
      }
    },
    "metadata": {
      "type": "object",
      "required": ["name", "version", "description", "accountableHuman", "labels"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "description": { "type": "string", "minLength": 10 },
        "accountableHuman": { "$ref": "#/$defs/human" },
        "labels": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    }
  }
}
