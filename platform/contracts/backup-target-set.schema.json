{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/contracts/backup-target-set.schema.json",
  "title": "Backup Target Set",
  "description": "DKC-057: per-tenant sæt af backupmål. Det aktive mål plus tidligere mål med deres bevarede recoveryhistorik, det primære fejl-/adgangsdomæne og den eksplicitte håndtering af eksterne datakilder.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "tenantId", "activeTargetRef", "previousTargets", "primaryFailureDomain", "externalSources", "recoveryOwner"],
  "properties": {
    "apiVersion": { "const": "contracts.platform/v1alpha1" },
    "kind": { "const": "BackupTargetSet" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "description", "accountableHuman"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9-]{3,63}$" },
        "version": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 10 },
        "accountableHuman": { "$ref": "#/$defs/namedHuman" }
      }
    },
    "tenantId": { "type": "string", "minLength": 1 },
    "serviceClassRef": { "type": ["string", "null"] },
    "activeTargetRef": { "type": "string", "minLength": 1 },
    "previousTargets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["targetRef", "retainedUntil", "retentionDays"],
        "properties": {
          "targetRef": { "type": "string", "minLength": 1 },
          "retainedUntil": { "type": "string", "format": "date-time" },
          "retentionDays": { "type": "integer", "minimum": 1 },
          "purgeApprovedBy": { "oneOf": [{ "$ref": "#/$defs/namedHuman" }, { "type": "null" }] }
        }
      }
    },
    "primaryFailureDomain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "accessDomain", "region"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "accessDomain": { "type": "string", "minLength": 1 },
        "region": { "type": "string", "minLength": 1 }
      }
    },
    "externalSources": {
      "type": "array",
      "description": "Enhver ekstern datakilde skal have en eksplicit håndtering. En connector alene erklærer ikke kilden beskyttet.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceRef", "handling"],
        "properties": {
          "sourceRef": { "type": "string", "minLength": 1 },
          "handling": { "enum": ["owner-backup", "authorized-platform-backup", "no-backup"] },
          "owner": { "oneOf": [{ "$ref": "#/$defs/namedHuman" }, { "type": "null" }] },
          "agreementRef": { "type": ["string", "null"] },
          "verifiedRestore": { "type": "boolean" }
        }
      }
    },
    "recoveryOwner": { "$ref": "#/$defs/namedHuman" }
  },
  "$defs": {
    "namedHuman": {
      "type": "object",
      "required": ["subject", "name", "role"],
      "additionalProperties": false,
      "properties": {
        "subject": { "type": "string", "minLength": 3 },
        "name": { "type": "string", "minLength": 2 },
        "role": { "type": "string", "minLength": 2 },
        "substitute": {
          "type": "object",
          "required": ["subject", "name"],
          "additionalProperties": false,
          "properties": {
            "subject": { "type": "string", "minLength": 3 },
            "name": { "type": "string", "minLength": 2 }
          }
        }
      }
    }
  }
}
