{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/contracts/disaster-recovery-drill.schema.json",
  "title": "Disaster Recovery Drill Report",
  "description": "DKC-042: en gennemført katastrofegendannelsesøvelse. Øvelsen genopretter hele kundepakken i et isoleret recovery-miljø uden en fungerende primærklynge, genopretter IAM, DNS og secret-store fra backup, anvender slettejournalen og måler RPO/RTO for det samlede brugerflow — ikke kun databaseopstart. Rapporten bærer `measured: false` når den er kørt deterministisk mod den lokale model, og `gate.status` bliver 'blocked' ved enhver afvigelse. En produktionsøvelse på en levende klynge er NOT RUN.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "drillId",
    "planRef",
    "tenantId",
    "primaryClusterAvailable",
    "isolatedRecoveryEnvironment",
    "startedAt",
    "finishedAt",
    "restore",
    "dependencyRecovery",
    "deletionJournal",
    "measurements",
    "functionalChecks",
    "measured",
    "gate",
    "auditRef"
  ],
  "properties": {
    "apiVersion": { "const": "contracts.platform/v1alpha1" },
    "kind": { "const": "DisasterRecoveryDrillReport" },
    "drillId": { "type": "string", "format": "uuid" },
    "planRef": { "type": "string", "minLength": 3 },
    "tenantId": { "type": "string", "minLength": 1 },
    "primaryClusterAvailable": { "const": false },
    "isolatedRecoveryEnvironment": {
      "type": "object",
      "required": ["isolated", "noPrimaryDependency", "networkIsolation", "manifests"],
      "additionalProperties": false,
      "properties": {
        "isolated": { "const": true },
        "noPrimaryDependency": { "const": true },
        "networkIsolation": { "type": "string", "minLength": 3 },
        "manifests": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 3 }
        }
      }
    },
    "startedAt": { "type": "string", "format": "date-time" },
    "finishedAt": { "type": "string", "format": "date-time" },
    "restore": {
      "type": "object",
      "required": ["backupId", "knownCleanPoint", "integrityOk", "checksumsVerified", "components"],
      "additionalProperties": false,
      "properties": {
        "backupId": { "type": "string", "minLength": 3 },
        "knownCleanPoint": { "type": "boolean" },
        "integrityOk": { "type": "boolean" },
        "checksumsVerified": { "type": "boolean" },
        "components": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "dependencyRecovery": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["component", "recovered", "method"],
        "additionalProperties": false,
        "properties": {
          "component": { "enum": ["iam", "dns", "secret-store", "database", "object-storage", "queue"] },
          "recovered": { "type": "boolean" },
          "method": { "type": "string", "minLength": 3 }
        }
      }
    },
    "deletionJournal": {
      "type": "object",
      "required": ["applied", "entries", "recordsErased", "ledgerOk"],
      "additionalProperties": false,
      "properties": {
        "applied": { "type": "boolean" },
        "entries": { "type": "integer", "minimum": 0 },
        "recordsErased": { "type": "integer", "minimum": 0 },
        "ledgerOk": { "type": "boolean" }
      }
    },
    "measurements": {
      "type": "object",
      "required": ["userFlowId", "stepsRestored", "fullFlowRestoreMs", "measuredRtoMinutes", "measuredRpoMinutes", "rpoTargetMinutes", "rtoTargetMinutes", "databaseOnlyRtoMinutes"],
      "additionalProperties": false,
      "properties": {
        "userFlowId": { "type": "string", "minLength": 1 },
        "stepsRestored": { "type": "integer", "minimum": 1 },
        "fullFlowRestoreMs": { "type": "number", "minimum": 0 },
        "measuredRtoMinutes": { "type": "number", "minimum": 0 },
        "measuredRpoMinutes": { "type": "number", "minimum": 0 },
        "rpoTargetMinutes": { "type": "number", "minimum": 0 },
        "rtoTargetMinutes": { "type": "number", "minimum": 0 },
        "databaseOnlyRtoMinutes": { "type": "number", "minimum": 0 }
      }
    },
    "functionalChecks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "detail"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "status": { "enum": ["pass", "fail"] },
          "detail": { "type": "string" }
        }
      }
    },
    "measured": { "type": "boolean" },
    "gate": {
      "type": "object",
      "required": ["status", "reasons"],
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["pass", "blocked"] },
        "reasons": { "type": "array", "items": { "type": "string", "minLength": 3 } }
      }
    },
    "auditRef": { "type": "string", "minLength": 3 }
  }
}
