{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/contracts/host-enrollment.schema.json",
  "title": "Host Enrollment",
  "description": "DKC-058 — eksplicit enrollment af en værtsmaskine. Enrollment sker med en menneskelig, out-of-band bootstrap, verificeret trust (CA- og SSH-hostkey-fingeraftryk), en konkret inventory og et klart, navngivet ejerskab. Host-styring er slået fra som standard (`management.enabled: false`) og kan kun slås til af et navngivet menneske på en understøttet Linux-LTS-platform. Uden et gyldigt enrollment må ingen privilegeret operation udføres.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "installationId", "host", "ownership", "bootstrap", "trust", "inventory", "management", "recovery", "securityDomain"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "contracts.platform/v1alpha1" },
    "kind": { "const": "HostEnrollment" },
    "metadata": {
      "type": "object",
      "required": ["name", "version", "description", "accountableHuman"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9-]{2,63}$" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "description": { "type": "string", "minLength": 10 },
        "accountableHuman": { "$ref": "#/$defs/namedHuman" }
      }
    },
    "installationId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" },
    "host": {
      "type": "object",
      "required": ["id", "hostname", "spiffeId", "platformRef", "arch", "os"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" },
        "hostname": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{1,253}$" },
        "spiffeId": { "type": "string", "pattern": "^spiffe://[A-Za-z0-9./_-]+$" },
        "platformRef": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{1,63}$", "description": "Id i DKC-053's catalog/platforms.json." },
        "arch": { "enum": ["x64", "arm64"] },
        "os": {
          "type": "object",
          "required": ["family", "distro", "version", "kernel"],
          "additionalProperties": false,
          "properties": {
            "family": { "const": "linux" },
            "distro": { "type": "string", "minLength": 2 },
            "version": { "type": "string", "minLength": 1 },
            "kernel": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "ownership": {
      "type": "object",
      "required": ["ownerSubject", "ownerName", "role"],
      "additionalProperties": false,
      "properties": {
        "ownerSubject": { "type": "string", "pattern": "^[a-z][a-z0-9-]*\\|[a-z0-9][a-z0-9._-]{2,}$" },
        "ownerName": { "type": "string", "minLength": 2 },
        "role": { "type": "string", "minLength": 2 },
        "substitute": { "$ref": "#/$defs/namedHuman" }
      }
    },
    "bootstrap": {
      "type": "object",
      "required": ["method", "performedBy", "performedAt", "ticketRef", "interactive"],
      "additionalProperties": false,
      "properties": {
        "method": { "const": "human-out-of-band" },
        "performedBy": { "type": "string", "pattern": "^[a-z][a-z0-9-]*\\|[a-z0-9][a-z0-9._-]{2,}$" },
        "performedAt": { "type": "string", "format": "date-time" },
        "ticketRef": { "type": "string", "minLength": 3 },
        "interactive": { "const": true, "description": "Bootstrap kræver et menneske ved tastaturet; ingen automatisk tillid." }
      }
    },
    "trust": {
      "type": "object",
      "required": ["caFingerprint", "sshHostKeyFingerprint", "verified", "verifiedBy", "verifiedAt", "trustDomain"],
      "additionalProperties": false,
      "properties": {
        "caFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "sshHostKeyFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "verified": { "const": true },
        "verifiedBy": { "type": "string", "pattern": "^[a-z][a-z0-9-]*\\|[a-z0-9][a-z0-9._-]{2,}$" },
        "verifiedAt": { "type": "string", "format": "date-time" },
        "trustDomain": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{1,62}$" }
      }
    },
    "inventory": {
      "type": "object",
      "required": ["cpuCores", "memoryMiB", "diskGiB", "roles"],
      "additionalProperties": false,
      "properties": {
        "cpuCores": { "type": "integer", "minimum": 1 },
        "memoryMiB": { "type": "integer", "minimum": 256 },
        "diskGiB": { "type": "integer", "minimum": 1 },
        "roles": { "type": "array", "uniqueItems": true, "items": { "enum": ["single-server", "ha-node", "vps", "dedicated"] } }
      }
    },
    "management": {
      "type": "object",
      "required": ["enabled", "profileRef", "enabledBy", "enabledAt", "justification"],
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "description": "Host-styring er slået fra som standard." },
        "profileRef": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" },
        "enabledBy": { "type": ["string", "null"], "pattern": "^[a-z][a-z0-9-]*\\|[a-z0-9][a-z0-9._-]{2,}$" },
        "enabledAt": { "type": ["string", "null"], "format": "date-time" },
        "justification": { "type": "string", "minLength": 10 }
      }
    },
    "recovery": {
      "type": "object",
      "required": ["outOfBandConsoleRef", "consoleSecurityDomainRef", "tested", "testedAt"],
      "additionalProperties": false,
      "properties": {
        "outOfBandConsoleRef": { "type": "string", "minLength": 3 },
        "consoleSecurityDomainRef": { "type": "string", "minLength": 3 },
        "tested": { "const": true },
        "testedAt": { "type": "string", "format": "date-time" }
      }
    },
    "securityDomain": {
      "type": "object",
      "required": ["ref", "immutableKeyDomainRef", "authoritativeCopyRef", "separateFromPlatform"],
      "additionalProperties": false,
      "properties": {
        "ref": { "type": "string", "minLength": 3 },
        "immutableKeyDomainRef": { "type": "string", "minLength": 3 },
        "authoritativeCopyRef": { "type": "string", "minLength": 3 },
        "separateFromPlatform": { "const": true }
      }
    }
  },
  "$defs": {
    "namedHuman": {
      "type": "object",
      "required": ["subject", "role"],
      "additionalProperties": false,
      "properties": {
        "subject": { "type": "string", "pattern": "^[a-z][a-z0-9-]*\\|[a-z0-9][a-z0-9._-]{2,}$" },
        "role": { "type": "string", "minLength": 2 },
        "name": { "type": "string" }
      }
    }
  }
}
