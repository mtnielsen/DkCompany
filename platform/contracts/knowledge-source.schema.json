{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/contracts/knowledge-source.schema.json",
  "title": "Knowledge Source",
  "description": "DKC-028: en read-only videnskilde (BookStack som første kandidat) med tenantbinding, secretreference og en sync-plan. Kilden er ikke platformens egen database: den må ikke migreres eller sikkerhedskopieres automatisk, og alt indhold læses som ubetroet data.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "sources"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "contracts.platform/v1alpha1" },
    "kind": { "const": "KnowledgeSource" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    }
  },
  "$defs": {
    "human": {
      "type": "object",
      "required": ["subject", "name", "role"],
      "additionalProperties": false,
      "properties": {
        "subject": { "type": "string", "pattern": "^[a-z][a-z0-9-]*\\|[a-z0-9][a-z0-9._-]{2,}$" },
        "name": { "type": "string", "minLength": 2 },
        "role": { "type": "string", "minLength": 2 },
        "substitute": { "$ref": "#/$defs/human" }
      }
    },
    "metadata": {
      "type": "object",
      "required": ["name", "version", "description", "accountableHuman", "labels"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "description": { "type": "string", "minLength": 10 },
        "accountableHuman": { "$ref": "#/$defs/human" },
        "labels": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "source": {
      "type": "object",
      "required": ["id", "type", "tenantId", "baseUrl", "readOnly", "aclMode", "secretRef", "classificationDefault", "sync", "includeArchived"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,40}$" },
        "type": { "const": "bookstack" },
        "tenantId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" },
        "baseUrl": { "type": "string", "format": "uri" },
        "readOnly": { "const": true },
        "aclMode": { "const": "source" },
        "secretRef": { "type": "string", "pattern": "^(vault|k8s|env|file|kms):[A-Za-z0-9_./#:-]{3,200}$" },
        "classificationDefault": { "enum": ["public", "internal", "personal", "special-category", "confidential"] },
        "sync": {
          "type": "object",
          "required": ["fullEveryMinutes", "incrementalMinutes"],
          "additionalProperties": false,
          "properties": {
            "fullEveryMinutes": { "type": "integer", "minimum": 5 },
            "incrementalMinutes": { "type": "integer", "minimum": 1 }
          }
        },
        "includeArchived": { "type": "boolean" }
      }
    }
  }
}
