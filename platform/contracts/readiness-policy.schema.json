{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/contracts/readiness-policy.schema.json",
  "title": "Readiness Policy",
  "description": "Readiness-politik for pilotforløbet (DKC-033). Politikken definerer de krævede gates (sikkerhed, kvalitet, recovery og menneskelig vurdering) samt profilgates (fx HA), hvor hver gate læser faktisk evidens og fejler lukket. En gate kan ikke bestå på en grøn check alene; den menneskelige vurdering er en særskilt registreret begivenhed.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "freshnessDays", "gates", "observation", "customerAcceptance"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "contracts.platform/v1alpha1" },
    "kind": { "const": "ReadinessPolicy" },
    "metadata": {
      "type": "object",
      "required": ["name", "version", "description", "accountableHuman"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9-]{2,63}$" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
        "description": { "type": "string", "minLength": 20 },
        "accountableHuman": { "$ref": "#/$defs/human" },
        "labels": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "freshnessDays": { "type": "integer", "minimum": 1 },
    "gates": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/gate" }
    },
    "observation": {
      "type": "object",
      "required": ["requiredDays", "appliesWhen", "registryRef"],
      "additionalProperties": false,
      "properties": {
        "requiredDays": { "type": "integer", "minimum": 1 },
        "appliesWhen": { "type": "object", "minProperties": 1, "additionalProperties": false, "properties": { "always": { "type": "boolean" }, "deploymentProfileRef": { "type": "string", "minLength": 2 } } },
        "registryRef": { "type": "string", "minLength": 3 }
      }
    },
    "customerAcceptance": {
      "type": "object",
      "required": ["registryRef", "requireForEveryActiveGate", "maxAgeDays", "acceptedByRoles"],
      "additionalProperties": false,
      "properties": {
        "registryRef": { "type": "string", "minLength": 3 },
        "requireForEveryActiveGate": { "const": true },
        "maxAgeDays": { "type": "integer", "minimum": 1 },
        "acceptedByRoles": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 2 } }
      }
    }
  },
  "$defs": {
    "human": {
      "type": "object",
      "required": ["subject", "role", "name"],
      "additionalProperties": false,
      "properties": {
        "subject": { "type": "string", "minLength": 3 },
        "name": { "type": "string", "minLength": 2 },
        "role": { "type": "string", "minLength": 2 },
        "substitute": {
          "type": "object",
          "required": ["subject", "name"],
          "additionalProperties": false,
          "properties": {
            "subject": { "type": "string", "minLength": 3 },
            "name": { "type": "string", "minLength": 2 }
          }
        }
      }
    },
    "evidenceSource": {
      "type": "object",
      "required": ["kind", "ref"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "security-assessment",
            "independent-assessment",
            "pilot-scenarios",
            "restore-drill",
            "cost-report",
            "customer-acceptance",
            "observation-period",
            "test-matrix"
          ]
        },
        "ref": { "type": "string", "minLength": 3 },
        "required": { "type": "boolean" }
      }
    },
    "gate": {
      "type": "object",
      "required": ["id", "title", "kind", "appliesWhen", "evidenceSources", "requirementRefs", "checks", "mandatory", "owner"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]{2,63}$" },
        "title": { "type": "string", "minLength": 3 },
        "kind": { "enum": ["common", "profile"] },
        "description": { "type": "string" },
        "appliesWhen": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "always": { "type": "boolean" },
            "deploymentProfileRef": { "type": "string", "minLength": 2 }
          }
        },
        "evidenceSources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidenceSource" } },
        "requirementRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^REQ-[A-Z0-9-]+$" } },
        "checks": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 2 } },
        "independent": { "type": "boolean" },
        "mandatory": { "type": "boolean" },
        "owner": { "$ref": "#/$defs/human" }
      }
    }
  }
}
