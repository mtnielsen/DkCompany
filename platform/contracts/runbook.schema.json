{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/contracts/runbook.schema.json",
  "title": "Runbook",
  "description": "Versioneret og signeret runbook. Den binder en forhåndsgodkendt selvreparation til et lukket scope, en lukket parameterramme, forudsætninger, maksimal påvirkning, udløb, forsøgsgrænse, rollback og postchecks. Signaturen dækker hele det kanoniske indhold undtagen signaturfeltet; en runbook uden gyldig signatur må ikke eksekveres.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "scope", "parameters", "preconditions", "maxImpact", "expiry", "attempts", "rollback", "postchecks", "approval", "signature"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "contracts.platform/v1alpha1" },
    "kind": { "const": "Runbook" },
    "metadata": {
      "type": "object",
      "required": ["name", "version", "description", "owner", "accountableHuman"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "description": { "type": "string", "minLength": 10 },
        "owner": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "team": { "type": "string", "minLength": 2 },
            "contact": { "type": "string", "minLength": 3 },
            "subject": { "type": "string", "pattern": "^[a-z][a-z0-9-]*\\|[a-z0-9][a-z0-9._-]{2,}$" }
          }
        },
        "accountableHuman": { "$ref": "#/$defs/namedHuman" }
      }
    },
    "scope": {
      "type": "object",
      "required": ["verbs", "targets", "environments", "tenants"],
      "additionalProperties": false,
      "properties": {
        "verbs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 2 } },
        "targets": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "environments": { "type": "array", "minItems": 1, "items": { "enum": ["dev", "staging", "prod"] } },
        "tenants": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "parameters": {
      "type": "object",
      "required": ["schema", "limits"],
      "additionalProperties": false,
      "properties": {
        "schema": { "type": "object" },
        "limits": {
          "type": "object",
          "required": ["maxDurationSeconds", "maxTargets"],
          "additionalProperties": false,
          "properties": {
            "maxDurationSeconds": { "type": "integer", "minimum": 1 },
            "maxTargets": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "preconditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "check", "expect"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 2 },
          "check": { "type": "string", "minLength": 2 },
          "expect": {},
          "evidenceRef": { "type": "string" }
        }
      }
    },
    "maxImpact": {
      "type": "object",
      "required": ["blastRadius", "maxTargets", "customerVisible", "maxDurationSeconds"],
      "additionalProperties": false,
      "properties": {
        "blastRadius": { "enum": ["single-target", "single-service", "tenant", "platform"] },
        "maxTargets": { "type": "integer", "minimum": 1 },
        "customerVisible": { "type": "boolean" },
        "maxDurationSeconds": { "type": "integer", "minimum": 1 }
      }
    },
    "expiry": {
      "type": "object",
      "required": ["approvedAt", "expiresAt", "maxAgeSeconds"],
      "additionalProperties": false,
      "properties": {
        "approvedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "maxAgeSeconds": { "type": "integer", "minimum": 1 }
      }
    },
    "attempts": {
      "type": "object",
      "required": ["maxAttempts", "windowSeconds"],
      "additionalProperties": false,
      "properties": {
        "maxAttempts": { "type": "integer", "minimum": 1 },
        "windowSeconds": { "type": "integer", "minimum": 1 }
      }
    },
    "rollback": {
      "type": "object",
      "required": ["required", "method", "tested"],
      "additionalProperties": false,
      "properties": {
        "required": { "const": true },
        "method": { "type": "string", "minLength": 2 },
        "runbookRef": { "type": "string" },
        "tested": { "const": true }
      }
    },
    "postchecks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "check", "expect", "timeoutSeconds", "onFailure"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 2 },
          "check": { "type": "string", "minLength": 2 },
          "expect": {},
          "timeoutSeconds": { "type": "integer", "minimum": 1 },
          "onFailure": { "enum": ["rollback", "escalate"] }
        }
      }
    },
    "approval": {
      "type": "object",
      "required": ["flow", "preApproved", "requiredApprovals", "eligibleGroups"],
      "additionalProperties": false,
      "properties": {
        "flow": { "enum": ["standard", "normal", "emergency"] },
        "preApproved": { "type": "boolean" },
        "preApprovalRef": { "type": "string" },
        "requiredApprovals": { "type": "integer", "minimum": 1 },
        "eligibleGroups": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 2 } }
      }
    },
    "signature": {
      "type": "object",
      "required": ["algorithm", "keyId", "value"],
      "additionalProperties": false,
      "properties": {
        "algorithm": { "enum": ["hmac-sha256"] },
        "keyId": { "type": "string", "minLength": 2 },
        "value": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "signedAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "$defs": {
    "namedHuman": {
      "type": "object",
      "required": ["subject", "role"],
      "additionalProperties": false,
      "properties": {
        "subject": { "type": "string", "pattern": "^[a-z][a-z0-9-]*\\|[a-z0-9][a-z0-9._-]{2,}$" },
        "role": { "type": "string", "minLength": 2 },
        "name": { "type": "string" }
      }
    }
  }
}
