{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/contracts/test-matrix.schema.json",
  "title": "Test Matrix",
  "description": "Versioneret krav-til-test-matrix (DKC-063). Hvert krav mapper til navngivne, kørebare checks eller til en eksplicit udestående uafhængig vurdering. Matrixen bærer testtyper, ejere, frister for evidens, release-blokerende krav, konfigurerbare tærskler (med menneskelig accept) og CI-trin. En grøn enhedstest er ikke det samme som produktions-, HA- eller compliance-status.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "matrixVersion", "supportedEnvironments", "freshnessPolicy", "thresholds", "stages", "requirements"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "contracts.platform/v1alpha1" },
    "kind": { "const": "TestMatrix" },
    "metadata": {
      "type": "object",
      "required": ["name", "version", "description", "accountableHuman"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9-]{2,63}$" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
        "description": { "type": "string", "minLength": 10 },
        "accountableHuman": { "$ref": "#/$defs/accountableHuman" },
        "labels": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "matrixVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$", "description": "Separat version for selve matrixindholdet; ændringer kræver ny version." },
    "supportedEnvironments": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{1,63}$" },
      "description": "Platforms-id'er fra DKC-053's catalog/platforms.json som matrixen er erklæret understøttet på."
    },
    "freshnessPolicy": {
      "type": "object",
      "required": ["defaultDays", "maxDays"],
      "additionalProperties": false,
      "properties": {
        "defaultDays": { "type": "integer", "minimum": 1 },
        "maxDays": { "type": "integer", "minimum": 1 },
        "notes": { "type": "string" }
      }
    },
    "thresholds": {
      "type": "object",
      "description": "Konfigurerbare, ejergodkendte tærskler. Uden en navngivet accept må release-gaten ikke give grønt.",
      "required": ["requireAllMandatoryPass", "allowImplementerEvidenceForRelease", "maxOpenExceptions", "acceptedBy", "acceptedAt"],
      "additionalProperties": false,
      "properties": {
        "requireAllMandatoryPass": { "const": true },
        "allowImplementerEvidenceForRelease": { "type": "boolean" },
        "maxOpenExceptions": { "type": "integer", "minimum": 0 },
        "maxExceptionDays": { "type": "integer", "minimum": 1 },
        "acceptedBy": { "$ref": "#/$defs/accountableHuman" },
        "acceptedAt": { "type": "string", "format": "date-time" },
        "notes": { "type": "string" }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "commands"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]{2,63}$" },
          "title": { "type": "string", "minLength": 3 },
          "description": { "type": "string" },
          "blocking": { "type": "boolean", "description": "Om et fejlende trin blokerer release." },
          "commands": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 } }
        }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/requirement" }
    }
  },

  "$defs": {
    "testType": {
      "enum": ["unit", "contract", "integration", "end-to-end", "authorization", "installation", "migration", "performance", "recovery"]
    },
    "checkRef": {
      "type": "object",
      "required": ["id", "testTypes", "mustPass"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]{2,63}$" },
        "testTypes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/testType" } },
        "mustPass": { "type": "boolean" },
        "notes": { "type": "string" }
      }
    },
    "requirement": {
      "type": "object",
      "required": ["id", "title", "description", "mandatory", "releaseBlocking", "nonExcepted", "owner", "controlRefs", "testTypes", "checks", "evidenceFreshnessDays", "independentAssessment"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^REQ-[A-Z0-9-]{2,40}$" },
        "title": { "type": "string", "minLength": 5 },
        "description": { "type": "string", "minLength": 10 },
        "mandatory": { "type": "boolean" },
        "releaseBlocking": { "type": "boolean" },
        "nonExcepted": { "type": "boolean", "description": "Sikkerhedskritiske krav der ikke må dækkes af en risikoundtagelse." },
        "owner": { "$ref": "#/$defs/accountableHuman" },
        "controlRefs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 2 }, "description": "Krydsreference til kontroller/krav i compliance/control-mapping.json." },
        "testTypes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/testType" } },
        "checks": { "type": "array", "items": { "$ref": "#/$defs/checkRef" } },
        "evidenceFreshnessDays": { "type": "integer", "minimum": 1 },
        "independentAssessment": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["required", "reason", "evidenceKind"],
              "additionalProperties": false,
              "properties": {
                "required": { "const": true },
                "reason": { "type": "string", "minLength": 10 },
                "evidenceKind": { "enum": ["independent-assessment", "penetration-test", "live-measurement", "external-audit"] }
              }
            }
          ]
        }
      }
    },
    "accountableHuman": {
      "type": "object",
      "required": ["subject", "role", "name"],
      "additionalProperties": false,
      "properties": {
        "subject": { "type": "string", "minLength": 3 },
        "name": { "type": "string", "minLength": 2 },
        "role": { "type": "string", "minLength": 2 },
        "substitute": {
          "type": "object",
          "required": ["subject", "name"],
          "additionalProperties": false,
          "properties": { "subject": { "type": "string", "minLength": 3 }, "name": { "type": "string", "minLength": 2 } }
        }
      }
    }
  }
}
