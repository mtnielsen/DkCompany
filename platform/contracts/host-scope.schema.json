{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/contracts/host-scope.schema.json",
  "title": "Host Scope",
  "description": "DKC-054 — det eksplicit oplyste scope en installation må røre på værts-OS'et. Scopet er fail-closed: uden et konkret, navngivet scope må installatøren hverken formatere diske, overtage et eksisterende databaseskema eller ændre host-OS. Ikke-understøttede OS-versioner afvises.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "installationId", "ownership", "os", "privileges", "allowedOperations", "forbiddenOperations", "diskPolicy", "databasePolicy", "hostChangePolicy", "recovery", "authorization"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "contracts.platform/v1alpha1" },
    "kind": { "const": "HostScope" },
    "metadata": {
      "type": "object",
      "required": ["name", "version", "description"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9-]{2,63}$" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "description": { "type": "string", "minLength": 10 }
      }
    },
    "installationId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" },
    "ownership": {
      "type": "object",
      "required": ["ownerSubject", "ownerName", "role"],
      "additionalProperties": false,
      "properties": {
        "ownerSubject": { "type": "string", "pattern": "^[a-z][a-z0-9-]*\\|[a-z0-9._@-]+$" },
        "ownerName": { "type": "string", "minLength": 2 },
        "role": { "type": "string", "minLength": 2 }
      }
    },
    "os": {
      "type": "object",
      "required": ["family", "distro", "version", "supportTier", "supportedMatrixRef"],
      "additionalProperties": false,
      "properties": {
        "family": { "const": "linux" },
        "distro": { "type": "string", "minLength": 2 },
        "version": { "type": "string", "minLength": 1 },
        "kernel": { "type": "string" },
        "supportTier": { "enum": ["lts", "extended", "unsupported"] },
        "supportedMatrixRef": { "type": "string", "minLength": 2, "description": "Reference til en navngiven platformskombination i DKC-053's platformmatrix." }
      }
    },
    "privileges": {
      "type": "object",
      "required": ["brokerSubject", "executorRole", "noRootForAgents", "scopedOperationTicket"],
      "additionalProperties": false,
      "properties": {
        "brokerSubject": { "type": "string", "pattern": "^(spiffe://[A-Za-z0-9./_-]+|oidc\\|[A-Za-z0-9._@-]+)$" },
        "executorRole": { "const": "executor" },
        "noRootForAgents": { "const": true, "description": "Ingen agent får fri root- eller hypervisoradgang." },
        "scopedOperationTicket": { "const": true }
      }
    },
    "allowedOperations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["diagnose", "package-update", "drain", "reboot", "certificate-renew", "capacity-alert"] }
    },
    "forbiddenOperations": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": { "enum": ["format-disk", "take-over-database-schema", "change-host-os", "arbitrary-shell", "upload-script", "unsigned-package", "modify-broker-policy", "modify-package-source", "modify-payload", "hypervisor-control"] }
    },
    "diskPolicy": {
      "type": "object",
      "required": ["formatAllowed", "existingDataPreserved", "encrypted"],
      "additionalProperties": false,
      "properties": {
        "formatAllowed": { "const": false },
        "existingDataPreserved": { "const": true },
        "encrypted": { "const": true }
      }
    },
    "databasePolicy": {
      "type": "object",
      "required": ["adoptExistingSchema", "migrationOwnerSubject", "backupRequired"],
      "additionalProperties": false,
      "properties": {
        "adoptExistingSchema": { "const": false },
        "migrationOwnerSubject": { "type": "string", "pattern": "^[a-z][a-z0-9-]*\\|[a-z0-9._@-]+$" },
        "backupRequired": { "const": true }
      }
    },
    "hostChangePolicy": {
      "type": "object",
      "required": ["osUpgradeAllowed", "allowedWithExplicitScope"],
      "additionalProperties": false,
      "properties": {
        "osUpgradeAllowed": { "type": "boolean" },
        "allowedWithExplicitScope": { "type": "boolean" }
      }
    },
    "recovery": {
      "type": "object",
      "required": ["outOfBandConsoleRef", "maintenanceWindow", "backupRef", "stopConditions"],
      "additionalProperties": false,
      "properties": {
        "outOfBandConsoleRef": { "type": "string", "minLength": 3 },
        "maintenanceWindow": { "type": "string", "minLength": 3 },
        "backupRef": { "type": "string", "minLength": 3 },
        "stopConditions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 5 } }
      }
    },
    "authorization": {
      "type": "object",
      "required": ["humanSubject", "grantedAt", "expiresAt", "decisionDigest"],
      "additionalProperties": false,
      "properties": {
        "humanSubject": { "type": "string", "pattern": "^[a-z][a-z0-9-]*\\|[a-z0-9._@-]+$" },
        "grantedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "decisionDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
