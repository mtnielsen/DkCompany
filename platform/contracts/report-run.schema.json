{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/contracts/report-run.schema.json",
  "title": "Report Run",
  "description": "Resultatet af en rapportkørsel med den rettighedsrevalidering der faktisk blev udført ved kørsel og afsendelse. `run` betyder at både afsender og alle modtagere var autoriserede på kørselstidspunktet; `reauthorize` betyder at afsenderens rettigheder er bortfaldet og en ny ejer/definition kræves; `blocked` betyder at mindst én modtager ikke længere må modtage. En kørsel kan aldrig være `run` uden frisk revalidering.",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "id",
    "reportId",
    "reportVersion",
    "startedAt",
    "environment",
    "sender",
    "recipients",
    "authorization",
    "decision",
    "format",
    "dataSource",
    "audit"
  ],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "contracts.platform/v1alpha1" },
    "kind": { "const": "ReportRun" },
    "id": { "type": "string", "minLength": 3 },
    "reportId": { "type": "string", "minLength": 3 },
    "reportVersion": { "type": "integer", "minimum": 1 },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "environment": { "enum": ["dev", "staging", "prod"] },
    "format": { "enum": ["pdf", "csv", "xlsx", "json"] },
    "dataSource": {
      "type": "object",
      "required": ["id", "systemOfRecord", "moduleRef"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 3 },
        "systemOfRecord": { "type": "string", "minLength": 3 },
        "moduleRef": { "enum": ["communications", "hr", "bi", "reporting"] }
      }
    },
    "sender": {
      "type": "object",
      "required": ["subject", "decision"],
      "additionalProperties": false,
      "properties": {
        "subject": { "type": "string", "minLength": 3 },
        "decision": { "enum": ["allow", "deny", "reauthorize"] },
        "reason": { "type": "string" },
        "resolvedAt": { "type": "string", "format": "date-time" }
      }
    },
    "recipients": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "decision"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "subject": { "type": "string", "minLength": 3 },
          "decision": { "enum": ["allow", "deny", "reauthorize"] },
          "reason": { "type": "string" },
          "deliveredAt": { "type": "string", "format": "date-time" }
        }
      }
    },
    "authorization": {
      "type": "object",
      "required": ["revalidatedAt", "senderResolved", "recipientsResolved", "sourceResolved", "usedStoredCreatorToken"],
      "additionalProperties": false,
      "properties": {
        "revalidatedAt": { "type": "string", "format": "date-time" },
        "senderResolved": { "type": "boolean" },
        "recipientsResolved": { "type": "boolean" },
        "sourceResolved": { "type": "boolean" },
        "usedStoredCreatorToken": { "const": false }
      }
    },
    "decision": { "enum": ["run", "blocked", "reauthorize"] },
    "artifact": {
      "type": "object",
      "required": ["uri", "sha256"],
      "additionalProperties": false,
      "properties": {
        "uri": { "type": "string", "minLength": 3 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "audit": {
      "type": "object",
      "required": ["required", "ref"],
      "additionalProperties": false,
      "properties": {
        "required": { "const": true },
        "ref": { "type": "string", "minLength": 3 }
      }
    }
  }
}
