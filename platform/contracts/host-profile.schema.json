{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/contracts/host-profile.schema.json",
  "title": "Host Profile",
  "description": "DKC-058 — den første understøttede host-styringsprofil på en navngiven Linux-LTS-platform. Profilen fastlægger de lukkede operationer (diagnose, godkendte pakkeopdateringer, drain/reboot, certifikatfornyelse og kapacitetsalarmer), vedligeholdelsesvindue, canary, backupkrav, stopkriterier og en recoverykonsol uden for platformen. En VPS-profil lover aldrig styring af udbyderens hypervisor eller hardware.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "platformRef", "os", "operations", "maintenanceWindow", "canary", "backup", "stopCriteria", "recovery", "vps", "ha", "singleServer"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "contracts.platform/v1alpha1" },
    "kind": { "const": "HostProfile" },
    "metadata": {
      "type": "object",
      "required": ["name", "version", "description", "accountableHuman"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9-]{2,63}$" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "description": { "type": "string", "minLength": 10 },
        "accountableHuman": { "$ref": "#/$defs/namedHuman" }
      }
    },
    "platformRef": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{1,63}$", "description": "Id i catalog/platforms.json." },
    "os": {
      "type": "object",
      "required": ["family", "supportTier"],
      "additionalProperties": false,
      "properties": {
        "family": { "const": "linux" },
        "supportTier": { "enum": ["lts", "extended"] }
      }
    },
    "operations": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["verb", "modes", "requiresApproval", "maxDurationSeconds", "closedParameters"],
        "additionalProperties": false,
        "properties": {
          "verb": { "enum": ["diagnose", "package-update", "drain", "reboot", "certificate-renew", "capacity-alert"] },
          "modes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["dry-run", "apply"] } },
          "requiresApproval": { "const": true },
          "maxDurationSeconds": { "type": "integer", "minimum": 1 },
          "closedParameters": { "type": "object", "description": "Lukket parameterskema for operationen." }
        }
      }
    },
    "maintenanceWindow": {
      "type": "object",
      "required": ["schedule", "timezone", "announcedLeadTimeSeconds"],
      "additionalProperties": false,
      "properties": {
        "schedule": { "type": "string", "minLength": 3 },
        "timezone": { "type": "string", "minLength": 2 },
        "announcedLeadTimeSeconds": { "type": "integer", "minimum": 60 }
      }
    },
    "canary": {
      "type": "object",
      "required": ["maxHosts", "waitSeconds", "onFailure"],
      "additionalProperties": false,
      "properties": {
        "maxHosts": { "const": 1 },
        "waitSeconds": { "type": "integer", "minimum": 30 },
        "onFailure": { "const": "halt" }
      }
    },
    "backup": {
      "type": "object",
      "required": ["required", "verifiedBeforeMutation"],
      "additionalProperties": false,
      "properties": {
        "required": { "const": true },
        "verifiedBeforeMutation": { "const": true }
      }
    },
    "stopCriteria": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 5 }
    },
    "recovery": {
      "type": "object",
      "required": ["outOfBandConsole", "separateSecurityDomain"],
      "additionalProperties": false,
      "properties": {
        "outOfBandConsole": { "const": true },
        "separateSecurityDomain": { "const": true }
      }
    },
    "vps": {
      "type": "object",
      "required": ["controlsHypervisor", "controlsHardware", "note"],
      "additionalProperties": false,
      "properties": {
        "controlsHypervisor": { "const": false },
        "controlsHardware": { "const": false },
        "note": { "type": "string", "minLength": 10 }
      }
    },
    "ha": {
      "type": "object",
      "required": ["minNodes", "drainRequiresHealthyReplicas", "rebootOneAtATime"],
      "additionalProperties": false,
      "properties": {
        "minNodes": { "type": "integer", "minimum": 3 },
        "drainRequiresHealthyReplicas": { "const": true },
        "rebootOneAtATime": { "const": true }
      }
    },
    "singleServer": {
      "type": "object",
      "required": ["announcedDowntime", "requiresExplicitDowntimeApproval"],
      "additionalProperties": false,
      "properties": {
        "announcedDowntime": { "const": true },
        "requiresExplicitDowntimeApproval": { "const": true }
      }
    }
  },
  "$defs": {
    "namedHuman": {
      "type": "object",
      "required": ["subject", "role"],
      "additionalProperties": false,
      "properties": {
        "subject": { "type": "string", "pattern": "^[a-z][a-z0-9-]*\\|[a-z0-9][a-z0-9._-]{2,}$" },
        "role": { "type": "string", "minLength": 2 },
        "name": { "type": "string" }
      }
    }
  }
}
