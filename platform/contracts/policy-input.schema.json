{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/contracts/policy-input.schema.json",
  "title": "Policy Input",
  "description": "Det input en principal (modul eller agent) sender til PDP'en. Moduler og agenter spørger; de beslutter ikke selv. Inputtet beskriver principal, handling og den kontekst beslutningen må bygges på.",
  "type": "object",
  "required": ["principal", "action"],
  "additionalProperties": false,
  "properties": {
    "principal": {
      "type": "object",
      "required": ["kind", "id"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["human", "agent", "service"] },
        "id": { "type": "string", "minLength": 1 },
        "spiffeId": { "type": "string", "pattern": "^spiffe://" },
        "autonomyClass": { "enum": ["A0", "A1", "A2", "A3"] },
        "onBehalfOf": { "type": "string" }
      }
    },
    "action": {
      "type": "object",
      "required": ["verb", "target", "environment"],
      "additionalProperties": false,
      "properties": {
        "verb": {
          "type": "string",
          "description": "Verbum fra ops- eller privacy-kontrakten. Fri shell er ikke et verbum."
        },
        "target": { "type": "string", "minLength": 1 },
        "environment": { "enum": ["dev", "staging", "prod"] },
        "autonomyClass": { "enum": ["A0", "A1", "A2", "A3"] }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tenantId": { "type": "string" },
        "blastRadius": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tenants": { "type": "integer", "minimum": 0 },
            "services": { "type": "integer", "minimum": 0 },
            "personalDataRecords": { "type": "integer", "minimum": 0 }
          }
        },
        "evidence": {
          "type": "array",
          "items": { "enum": ["policy-allow", "tests-pass", "dry-run-clean", "rollback-tested", "restore-verified", "scan-clean"] }
        },
        "evidenceSha256": {
          "type": "object",
          "description": "DKC-007: de verificerede bevisdigester, så PDP'en og efterfølgende led kan binde beslutningen til det faktiske artefakt i stedet for en tekstetikette.",
          "additionalProperties": { "type": "string" }
        },
        "dataClass": {
          "enum": ["ordinary", "ai-read-only", "append-only", "retention-locked"],
          "description": "DKC-047: den beskyttede dataklasse handlingen rører. AI må ikke ændre en beskyttet klasse, og no-AI-access udelukker læsning."
        },
        "noAiAccess": {
          "type": "boolean",
          "description": "DKC-047: separat adgangsflag. true udelukker alle AI-flows, også retrieval, prompts, logs og træning/analyse."
        },
        "operation": {
          "enum": ["read", "retrieve", "prompt", "train", "analyze", "log-access", "append", "update", "delete", "copy", "export", "restore", "reclassify", "pointer-update", "key-rotate"],
          "description": "DKC-047: den AI-operation handlingen udgør, så beskyttelsesguarden kan afgøre den uden at gætte ud fra verbet."
        },
        "protection": {
          "type": "object",
          "description": "DKC-047: beskyttelsesmetadata for den rørte post, så PDP'en kan se versions-ID, nøgledomæne og den autoritative pointer.",
          "additionalProperties": false,
          "properties": {
            "versionId": { "type": "string" },
            "owner": { "type": "string" },
            "keyDomain": { "type": "string" },
            "authoritativePointer": { "type": "string" }
          }
        },
        "changeUri": { "type": "string" },
        "changeSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "untrustedInput": {
          "type": "boolean",
          "description": "true hvis beslutningen bygger på data principalen ikke kontrollerer (logs, issues, changelogs)."
        },
        "requestedApprovals": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
