{
  "apiVersion": "contracts.platform/v1alpha1",
  "kind": "DisasterRecoveryPlan",
  "metadata": {
    "name": "example-disaster-recovery-plan",
    "version": "1.0.0",
    "description": "Eksempel på en katastrofegendannelsesplan efter 3-2-1-1-0 med applikationskonsistent PITR, separat recovery-identitet, isoleret recovery-miljø, kendt rent restorepunkt, slettejournal og planlagt failback.",
    "accountableHuman": {
      "subject": "oidc|anna.andersen",
      "name": "Anna Andersen",
      "role": "Platform Owner",
      "substitute": {
        "subject": "oidc|bo.bertelsen",
        "name": "Bo Bertelsen"
      }
    },
    "lastReviewed": "2026-09-28",
    "labels": {
      "segment": "continuity",
      "tier": "p0"
    }
  },
  "principle": {
    "designation": "3-2-1-1-0",
    "copies": 3,
    "mediaTypes": 3,
    "offsiteCopies": 1,
    "offlineImmutableCopies": 1,
    "verifiedRestores": 1,
    "unrecoverableErrors": 0
  },
  "copies": [
    {
      "id": "primary-filesystem",
      "targetRef": "local-filesystem",
      "copyType": "primary",
      "mediaType": "disk",
      "failureDomain": "staging-local",
      "accessDomain": "staging-account",
      "immutable": false,
      "encrypted": true,
      "credentialsRef": "env:BACKUP_LOCAL_ACCESS",
      "deletePermission": "none",
      "retentionDays": 90
    },
    {
      "id": "offsite-object-store",
      "targetRef": "offsite-object-store",
      "copyType": "offsite",
      "mediaType": "object-store",
      "failureDomain": "offsite-zone-b",
      "accessDomain": "backup-prod-account",
      "immutable": true,
      "encrypted": true,
      "credentialsRef": "vault:secret/data/backup/offsite#access",
      "deletePermission": "compliance",
      "retentionDays": 365
    },
    {
      "id": "offline-vault",
      "targetRef": "offline-vault",
      "copyType": "offline-immutable",
      "mediaType": "tape",
      "failureDomain": "airgap-vault",
      "accessDomain": "airgap-account",
      "immutable": true,
      "encrypted": true,
      "credentialsRef": "vault:secret/data/backup/offline#access",
      "deletePermission": "governance-two-person",
      "retentionDays": 3650
    }
  ],
  "primaryCluster": {
    "credentialsRef": "vault:secret/data/platform/primary-cluster-ops#token",
    "roleId": "platform-primary-ops",
    "canDeleteProtectedBackups": false,
    "operations": [
      "read",
      "write",
      "backup",
      "failover"
    ],
    "forbiddenOperations": [
      "delete",
      "retention-shorten",
      "pointer-switch",
      "key-delete",
      "recovery-access"
    ]
  },
  "recoveryIdentity": {
    "profileRef": "backup/dr/recovery-access-profile.json",
    "separateFromPrimaryOperations": true,
    "humanVerifiedOnly": true,
    "twoPersonApproval": true,
    "noStandingAccess": true
  },
  "pitr": {
    "engine": "postgresql",
    "baseBackupSchedule": "0 2 * * *",
    "walArchiveTarget": "s3://platform-wal-archive/eu-west-1",
    "pitrEnabled": true,
    "retentionHours": 720,
    "consistency": "application-consistent",
    "quiescence": {
      "method": "checkpoint-and-fence-writes",
      "maxPauseSeconds": 30,
      "includes": [
        "database",
        "objects",
        "config",
        "queue"
      ]
    },
    "targetRecoveryTime": {
      "selectable": true,
      "granularity": "second",
      "boundByConfirmedWritesRpoMinutes": 0
    },
    "aclReconciliation": {
      "required": true,
      "method": "compare-subject-role-matrix",
      "sources": [
        "database",
        "iam",
        "object-store"
      ]
    },
    "snapshotAloneIsInsufficient": true
  },
  "recoveryEnvironment": {
    "isolated": true,
    "noPrimaryDependency": true,
    "networkIsolation": "dedicated-recovery-vpc-without-peering-to-primary",
    "manifests": [
      "gitops/manifests/recovery/isolated-recovery-environment.json",
      "gitops/manifests/recovery/recovery-access-role.json"
    ],
    "dependencies": [
      {
        "component": "iam",
        "recoveredFrom": "backup/restored-identities.json",
        "method": "restore-identity-table-from-pitr-and-rebind-trust"
      },
      {
        "component": "dns",
        "recoveredFrom": "backup/components/config-config.enc",
        "method": "rebuild-zone-from-config-and-reexport"
      },
      {
        "component": "secret-store",
        "recoveredFrom": "kms:alias/platform-backup",
        "method": "recover-keys-from-separate-custody-and-reissue-workload-secrets"
      },
      {
        "component": "database",
        "recoveredFrom": "s3://platform-wal-archive/eu-west-1",
        "method": "pitr-to-known-clean-point"
      },
      {
        "component": "object-storage",
        "recoveredFrom": "offsite-object-store",
        "method": "restore-versioned-objects-and-preserve-locks"
      }
    ]
  },
  "knownCleanPoint": {
    "backupId": "clean-2026-09-28T020000Z",
    "verifiedAt": "2026-09-28T02:05:00Z",
    "verifiedBy": {
      "subject": "oidc|cont.officer",
      "name": "Carla Officer",
      "role": "Continuity Officer"
    },
    "method": "isolated-restore-plus-functional-and-acl-checks",
    "evidenceRef": "docs/continuity/dr-plan.md#kendt-rent-restorepunkt"
  },
  "deletionJournal": {
    "ref": "backup/src/suppression.mjs",
    "appendOnly": true,
    "hashChained": true,
    "ledgerRef": "srv/backup/suppression.ndjson"
  },
  "failback": {
    "planned": true,
    "procedure": [
      "fence-den-gamle-primary-og-bekraeft-monotont-epoch",
      "rejoin-og-indhent-wal-paa-den-tidligere-primary",
      "verificer-checksums-og-acl-foer-promotion",
      "planlaeg-switchover-i-vedligeholdelsesvindue"
    ],
    "requiresFence": true,
    "switchoverWindow": "maintenance"
  },
  "userFlow": {
    "id": "F3",
    "name": "Udføre et ops-verbum med fuld sporbarhed",
    "steps": [
      {
        "id": "signin",
        "description": "Logge ind og få adgang til platformen",
        "component": "keycloak-adapter",
        "dependsOn": []
      },
      {
        "id": "approval",
        "description": "Godkende anmodningen med to-personers kontrol",
        "component": "approval-service",
        "dependsOn": [
          "signin"
        ]
      },
      {
        "id": "execute",
        "description": "Udføre ops-verbummet mod det rette modul",
        "component": "dummy-ok",
        "dependsOn": [
          "approval"
        ]
      },
      {
        "id": "audit",
        "description": "Bekræfte handlingen i det hash-kædede revisionsspor",
        "component": "audit-service",
        "dependsOn": [
          "execute"
        ]
      }
    ],
    "rpoMinutes": 0,
    "rtoMinutes": 60,
    "includesDependencies": [
      "iam",
      "dns",
      "secret-store",
      "database"
    ]
  },
  "protectedBackups": [
    {
      "id": "offsite-protected",
      "copyRef": "offsite-object-store",
      "retentionDays": 365,
      "deletionGuard": "compliance-object-lock",
      "twoPersonRequired": true,
      "immutableVerified": true
    },
    {
      "id": "offline-protected",
      "copyRef": "offline-vault",
      "retentionDays": 3650,
      "deletionGuard": "offline-airgap",
      "twoPersonRequired": true,
      "immutableVerified": true
    }
  ]
}
