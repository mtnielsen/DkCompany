{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/contracts/upstream-upgrade-plan.schema.json",
  "title": "Upstream Upgrade Plan",
  "description": "DKC-024: en gated opgraderings- og rollbackplan for én adapter fra én eksakt upstream-version/edition til en anden. Planen udledes af den godkendte releaseprofil og kandidat og må ikke påstå en version uden for en understøttet serie. Backup og verificeret rollback er obligatoriske.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "adapter", "from", "to", "matchesRange", "downgrade", "preflight", "steps", "verification", "rollback", "status", "blockers"],
  "properties": {
    "apiVersion": { "const": "contracts.platform/v1alpha1" },
    "kind": { "const": "UpstreamUpgradePlan" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "adapter": { "type": "string", "minLength": 3 },
    "from": { "$ref": "#/$defs/versionEdition" },
    "to": { "$ref": "#/$defs/versionEdition" },
    "matchesRange": { "type": ["string", "null"] },
    "downgrade": { "type": "boolean" },
    "preflight": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } },
    "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } },
    "verification": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } },
    "rollback": { "$ref": "#/$defs/rollback" },
    "status": { "enum": ["planned", "blocked", "executed"] },
    "blockers": { "type": "array", "items": { "type": "string", "minLength": 3 } }
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "description", "accountableHuman"],
      "properties": {
        "name": { "type": "string", "minLength": 3 },
        "version": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 10 },
        "accountableHuman": { "$ref": "#/$defs/human" }
      }
    },
    "human": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "name", "role"],
      "properties": {
        "subject": { "type": "string", "pattern": "^[a-z0-9._-]+\\|[a-z0-9._@-]+$" },
        "name": { "type": "string", "minLength": 2 },
        "role": { "type": "string", "minLength": 2 }
      }
    },
    "versionEdition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "edition"],
      "properties": {
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$" },
        "edition": { "type": ["string", "null"] }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "role", "description", "criteria"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{1,63}$" },
        "title": { "type": "string", "minLength": 3 },
        "role": { "enum": ["operator", "executor", "verifier", "auditor"] },
        "description": { "type": "string", "minLength": 10 },
        "criteria": { "type": "string", "minLength": 5 }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "backupRequired", "maxDowntimeMinutes", "steps"],
      "properties": {
        "strategy": { "type": "string", "minLength": 3 },
        "backupRequired": { "const": true },
        "maxDowntimeMinutes": { "type": "integer", "minimum": 0 },
        "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } }
      }
    }
  }
}
