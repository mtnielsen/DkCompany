{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/contracts/acceptance-scenario.schema.json",
  "title": "Acceptance Scenario Set",
  "description": "Kørebare brugerrejser for installation og releaseacceptance (DKC-062). Hver rejse binder en understøttet profil og platform til en række trin med et forventet udfald. Trinene eksekveres deterministisk mod den faktiske installer-, livscyklus-, provider- og migrationstak. Et forventet 'ok' er ikke det samme som en menneskelig accept; den registreres særskilt.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "scenarios"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "contracts.platform/v1alpha1" },
    "kind": { "const": "AcceptanceScenarioSet" },
    "metadata": {
      "type": "object",
      "required": ["name", "version", "description", "accountableHuman"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9-]{2,63}$" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
        "description": { "type": "string", "minLength": 10 },
        "accountableHuman": { "$ref": "#/$defs/accountableHuman" },
        "labels": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scenario" }
    }
  },
  "$defs": {
    "accountableHuman": {
      "type": "object",
      "required": ["subject", "role", "name"],
      "additionalProperties": false,
      "properties": {
        "subject": { "type": "string", "minLength": 3 },
        "name": { "type": "string", "minLength": 2 },
        "role": { "type": "string", "minLength": 2 },
        "substitute": {
          "type": "object",
          "required": ["subject", "name"],
          "additionalProperties": false,
          "properties": {
            "subject": { "type": "string", "minLength": 3 },
            "name": { "type": "string", "minLength": 2 }
          }
        }
      }
    },
    "step": {
      "type": "object",
      "required": ["id", "action", "expected"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]{2,63}$" },
        "action": {
          "enum": ["preflight", "plan", "install", "resume", "configure", "add", "remove", "upgrade", "recover", "provider-switch", "escalate", "export", "verify"]
        },
        "expected": {
          "enum": ["ok", "resumable", "approval-required", "denied", "blocked", "rolled-back"]
        },
        "description": { "type": "string", "minLength": 3 },
        "humanApproval": { "type": "boolean" }
      }
    },
    "scenario": {
      "type": "object",
      "required": ["id", "title", "journey", "profileRef", "platformRef", "target", "steps", "evidenceLevel", "owner"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]{2,63}$" },
        "title": { "type": "string", "minLength": 3 },
        "journey": {
          "enum": ["install", "configure", "add-remove", "upgrade", "provider-switch", "escalation", "recovery", "exit"]
        },
        "profileRef": { "type": "string", "minLength": 2 },
        "platformRef": { "type": "string", "minLength": 2 },
        "target": { "enum": ["local-server", "vps", "ha-cluster", "enterprise-dedicated"] },
        "selection": {
          "type": "array",
          "items": { "type": "string", "minLength": 2 },
          "description": "Valgfrie applikationer der tilvælges for rejsen."
        },
        "ha": { "type": "boolean" },
        "hostManagement": { "type": "boolean" },
        "immutable": { "type": "boolean" },
        "selfHealing": { "type": "boolean" },
        "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } },
        "evidenceLevel": { "enum": ["real", "fixture", "integration"] },
        "owner": { "$ref": "#/$defs/accountableHuman" }
      }
    }
  }
}
