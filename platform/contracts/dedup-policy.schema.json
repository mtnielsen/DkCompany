{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/contracts/dedup-policy.schema.json",
  "title": "Dedup Policy",
  "description": "DKC-043: politik for sikker deduplikering og kontrolleret oprydning. Skemaet håndhæver formen på fire separate dedup-domæner (backupblokke, primære objekter, jobhændelser og forretningsposter), grænsen pr. tenant/krypteringsdomæne/retentionklasse, garbage collection med single-writer lease og en besparelsesgate. Skemaet erstatter ikke en målt dedup-effekt på et levende objektlager.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "provenBackupSolutionRef", "primaryDataDedupOptional", "crossTenantDedup", "domains", "garbageCollection", "savingsGate", "keys"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "contracts.platform/v1alpha1" },
    "kind": { "const": "DedupPolicy" },
    "metadata": {
      "type": "object",
      "required": ["name", "version", "description", "accountableHuman"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "description": { "type": "string", "minLength": 20 },
        "accountableHuman": { "$ref": "#/$defs/human" },
        "labels": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "provenBackupSolutionRef": { "type": "string", "minLength": 3 },
    "primaryDataDedupOptional": { "const": true },
    "crossTenantDedup": { "const": false },
    "domains": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/domain" }
    },
    "garbageCollection": {
      "type": "object",
      "required": ["retentionAware", "singleWriterLease", "markAndSweep", "leaseRequiredForPrune", "maxLeaseSeconds"],
      "additionalProperties": false,
      "properties": {
        "retentionAware": { "const": true },
        "singleWriterLease": { "const": true },
        "markAndSweep": { "const": true },
        "leaseRequiredForPrune": { "const": true },
        "maxLeaseSeconds": { "type": "integer", "minimum": 1 }
      }
    },
    "savingsGate": {
      "type": "object",
      "required": ["requireIntegrityCheck", "requireFullRestore", "activateOnlyWhenBothPass"],
      "additionalProperties": false,
      "properties": {
        "requireIntegrityCheck": { "const": true },
        "requireFullRestore": { "const": true },
        "activateOnlyWhenBothPass": { "const": true }
      }
    },
    "keys": {
      "type": "object",
      "required": ["provider", "storeContainsKey", "domainScoped", "algorithm"],
      "additionalProperties": false,
      "properties": {
        "provider": { "type": "string", "minLength": 2 },
        "storeContainsKey": { "const": false },
        "domainScoped": { "const": true },
        "algorithm": { "type": "string", "minLength": 3 }
      }
    }
  },
  "$defs": {
    "human": {
      "type": "object",
      "required": ["subject", "name", "role"],
      "additionalProperties": false,
      "properties": {
        "subject": { "type": "string", "minLength": 3 },
        "name": { "type": "string", "minLength": 3 },
        "role": { "type": "string", "minLength": 3 },
        "substitute": {
          "type": "object",
          "required": ["subject", "name"],
          "additionalProperties": false,
          "properties": {
            "subject": { "type": "string", "minLength": 3 },
            "name": { "type": "string", "minLength": 3 }
          }
        }
      }
    },
    "boundary": {
      "type": "object",
      "required": ["tenantScoped", "encryptionDomainScoped", "retentionClassScoped", "crossTenantDedup"],
      "additionalProperties": false,
      "properties": {
        "tenantScoped": { "const": true },
        "encryptionDomainScoped": { "const": true },
        "retentionClassScoped": { "const": true },
        "crossTenantDedup": { "const": false }
      }
    },
    "chunking": {
      "type": "object",
      "required": ["algorithm", "minSizeBytes", "averageSizeBytes", "maxSizeBytes"],
      "additionalProperties": false,
      "properties": {
        "algorithm": { "const": "gear-cdc-sha256-v1" },
        "minSizeBytes": { "type": "integer", "minimum": 64 },
        "averageSizeBytes": { "type": "integer", "minimum": 64 },
        "maxSizeBytes": { "type": "integer", "minimum": 64 }
      }
    },
    "domain": {
      "type": "object",
      "required": ["id", "title", "category", "enabled", "requiresValidation", "mergeSemantics", "providerRef", "boundary"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]{2,63}$" },
        "title": { "type": "string", "minLength": 3 },
        "category": { "enum": ["backup-blocks", "primary-objects", "job-events", "business-records"] },
        "enabled": { "type": "boolean" },
        "requiresValidation": { "type": "boolean" },
        "mergeSemantics": { "enum": ["content-addressed-chunks", "idempotency-key-only", "never-merge"] },
        "providerRef": { "type": "string", "minLength": 3 },
        "boundary": { "$ref": "#/$defs/boundary" },
        "chunking": { "$ref": "#/$defs/chunking" },
        "validation": {
          "type": "object",
          "required": ["integrityTestRef", "restoreTestRef", "requiresHumanApproval"],
          "additionalProperties": false,
          "properties": {
            "integrityTestRef": { "type": "string", "minLength": 3 },
            "restoreTestRef": { "type": "string", "minLength": 3 },
            "requiresHumanApproval": { "type": "boolean" }
          }
        },
        "dedupKey": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "windowSeconds": { "type": "integer", "minimum": 1 },
        "note": { "type": "string", "minLength": 10 }
      }
    }
  }
}
