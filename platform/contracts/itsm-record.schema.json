{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/contracts/itsm-record.schema.json",
  "title": "ITSM Record",
  "description": "En sporbar sagsrecord i serviceprocessen: incident, major incident, request, problem, kendt fejl eller change. Recorden binder hændelse, tjeneste, change, runbook, godkendelse og audit-ID sammen, bærer den menneskelige ejer og kvittering, og erklærer hvilke AI-handlinger der er udført under hvilken enkeltrolle.",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "id",
    "recordKind",
    "title",
    "description",
    "severity",
    "state",
    "tenantId",
    "serviceId",
    "owner",
    "affectedServices",
    "correlatedAlerts",
    "ciRelations",
    "links",
    "customerVisible",
    "humanAck",
    "aiActions",
    "validatedBy",
    "approvals",
    "closedBy",
    "createdAt",
    "updatedAt"
  ],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "contracts.platform/v1alpha1" },
    "kind": { "const": "ItsmRecord" },
    "id": { "type": "string", "minLength": 1 },
    "recordKind": { "enum": ["incident", "major_incident", "request", "problem", "known_error", "change"] },
    "title": { "type": "string", "minLength": 3 },
    "description": { "type": "string" },
    "severity": { "enum": ["sev1", "sev2", "sev3", "sev4"] },
    "state": { "type": "string", "minLength": 2 },
    "tenantId": { "type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" },
    "serviceId": { "type": "string", "minLength": 1 },
    "owner": { "$ref": "#/$defs/human" },
    "requester": { "oneOf": [{ "$ref": "#/$defs/human" }, { "type": "null" }] },
    "affectedServices": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "correlatedAlerts": { "type": "array", "items": { "$ref": "#/$defs/alert" } },
    "ciRelations": { "type": "array", "items": { "$ref": "#/$defs/ci" } },
    "links": { "$ref": "#/$defs/links" },
    "customerVisible": { "type": "boolean" },
    "humanAck": { "oneOf": [{ "$ref": "#/$defs/ack" }, { "type": "null" }] },
    "aiActions": { "type": "array", "items": { "$ref": "#/$defs/aiAction" } },
    "validatedBy": { "oneOf": [{ "$ref": "#/$defs/human" }, { "type": "null" }] },
    "validatedAt": { "type": ["string", "null"], "format": "date-time" },
    "approvals": { "type": "array", "items": { "$ref": "#/$defs/approval" } },
    "closedBy": { "oneOf": [{ "$ref": "#/$defs/actor" }, { "type": "null" }] },
    "rollbackPlan": { "type": ["string", "null"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "resolvedAt": { "type": ["string", "null"], "format": "date-time" }
  },
  "$defs": {
    "human": {
      "type": "object",
      "required": ["subject", "name", "role"],
      "additionalProperties": false,
      "properties": {
        "subject": { "type": "string", "pattern": "^[a-z][a-z0-9-]*\\|[a-z0-9][a-z0-9._-]{2,}$" },
        "name": { "type": "string", "minLength": 2 },
        "role": { "type": "string", "minLength": 2 }
      }
    },
    "alert": {
      "type": "object",
      "required": ["alertId", "ruleId", "signal", "correlationKey", "emittedAt"],
      "additionalProperties": false,
      "properties": {
        "alertId": { "type": "string", "minLength": 1 },
        "ruleId": { "type": "string", "minLength": 1 },
        "signal": { "type": "string", "minLength": 1 },
        "correlationKey": { "type": "string", "minLength": 1 },
        "emittedAt": { "type": "string", "format": "date-time" },
        "summary": { "type": "string" }
      }
    },
    "ci": {
      "type": "object",
      "required": ["ciId", "kind", "relation"],
      "additionalProperties": false,
      "properties": {
        "ciId": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["service", "application", "database", "network", "host"] },
        "relation": { "enum": ["provides", "depends-on", "hosts", "connects"] }
      }
    },
    "links": {
      "type": "object",
      "required": ["serviceId", "incidentIds", "changeIds", "problemId", "knownErrorId", "runbook", "approvalIds", "auditIds"],
      "additionalProperties": false,
      "properties": {
        "serviceId": { "type": ["string", "null"] },
        "incidentIds": { "type": "array", "items": { "type": "string" } },
        "changeIds": { "type": "array", "items": { "type": "string" } },
        "problemId": { "type": ["string", "null"] },
        "knownErrorId": { "type": ["string", "null"] },
        "runbook": { "type": ["string", "null"] },
        "approvalIds": { "type": "array", "items": { "type": "string" } },
        "auditIds": { "type": "array", "items": { "type": "string" } }
      }
    },
    "ack": {
      "type": "object",
      "required": ["subject", "name", "at"],
      "additionalProperties": false,
      "properties": {
        "subject": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 2 },
        "at": { "type": "string", "format": "date-time" }
      }
    },
    "aiAction": {
      "type": "object",
      "required": ["agentId", "role", "verb", "at"],
      "additionalProperties": false,
      "properties": {
        "agentId": { "type": "string", "minLength": 1 },
        "role": { "enum": ["observer", "planner", "implementer", "verifier", "executor", "auditor"] },
        "verb": { "type": "string", "minLength": 1 },
        "at": { "type": "string", "format": "date-time" }
      }
    },
    "approval": {
      "type": "object",
      "required": ["subject", "name", "verdict", "at"],
      "additionalProperties": false,
      "properties": {
        "subject": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 2 },
        "verdict": { "enum": ["approve", "reject"] },
        "at": { "type": "string", "format": "date-time" },
        "kind": { "enum": ["human", "agent"] }
      }
    },
    "actor": {
      "type": "object",
      "required": ["subject", "name", "kind"],
      "additionalProperties": false,
      "properties": {
        "subject": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 2 },
        "kind": { "enum": ["human", "agent"] }
      }
    }
  }
}
