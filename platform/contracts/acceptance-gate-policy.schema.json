{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/contracts/acceptance-gate-policy.schema.json",
  "title": "Acceptance Gate Policy",
  "description": "Profilbevidst gate-politik for installations- og releaseacceptance (DKC-062). Fælles gates for sikkerhed, privacy, restore og roller gælder altid. HA, host management, immutable og self-healing er særskilte gates der kun er aktive når profilen/kapabiliteten er valgt, og hver aktiv gate kræver forudsætningskapabiliteter, checks og en særskilt registreret menneskelig ejeraccept. Fravalg af fx immutable må aldrig ophæve den obligatoriske auditbeskyttelse.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "freshnessDays", "gates", "roleSeparation", "ownerAcceptance"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "contracts.platform/v1alpha1" },
    "kind": { "const": "AcceptanceGatePolicy" },
    "metadata": {
      "type": "object",
      "required": ["name", "version", "description", "accountableHuman"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9-]{2,63}$" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
        "description": { "type": "string", "minLength": 10 },
        "accountableHuman": { "$ref": "#/$defs/accountableHuman" },
        "labels": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "freshnessDays": { "type": "integer", "minimum": 1 },
    "gates": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/gate" }
    },
    "roleSeparation": {
      "type": "object",
      "required": ["checks", "rejections"],
      "additionalProperties": false,
      "properties": {
        "checks": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 2 } },
        "rejections": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": { "enum": ["role-rotation", "alias", "subagent", "shared-credential", "multi-role-manifest"] }
        }
      }
    },
    "ownerAcceptance": {
      "type": "object",
      "required": ["registryRef", "requireForEveryActiveGate", "maxAgeDays", "acceptedByRoles"],
      "additionalProperties": false,
      "properties": {
        "registryRef": { "type": "string", "minLength": 3 },
        "requireForEveryActiveGate": { "const": true },
        "maxAgeDays": { "type": "integer", "minimum": 1 },
        "acceptedByRoles": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 2 } }
      }
    }
  },
  "$defs": {
    "accountableHuman": {
      "type": "object",
      "required": ["subject", "role", "name"],
      "additionalProperties": false,
      "properties": {
        "subject": { "type": "string", "minLength": 3 },
        "name": { "type": "string", "minLength": 2 },
        "role": { "type": "string", "minLength": 2 },
        "substitute": {
          "type": "object",
          "required": ["subject", "name"],
          "additionalProperties": false,
          "properties": {
            "subject": { "type": "string", "minLength": 3 },
            "name": { "type": "string", "minLength": 2 }
          }
        }
      }
    },
    "gate": {
      "type": "object",
      "required": ["id", "title", "kind", "appliesWhen", "requiresCapabilities", "requirementRefs", "checks", "mandatory", "owner"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]{2,63}$" },
        "title": { "type": "string", "minLength": 3 },
        "kind": { "enum": ["common", "profile"] },
        "description": { "type": "string" },
        "appliesWhen": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "always": { "type": "boolean" },
            "profileType": { "type": "string", "minLength": 2 },
            "hostManagement": { "type": "boolean" },
            "immutable": { "type": "boolean" },
            "selfHealing": { "type": "boolean" }
          }
        },
        "requiresCapabilities": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 2 },
          "description": "Komponent-id'er fra baseline-registeret som forudsætningen skal være til stede i koden."
        },
        "requirementRefs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^REQ-[A-Z0-9-]+$" }
        },
        "checks": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 2 } },
        "journeys": { "type": "array", "items": { "enum": ["install", "configure", "add-remove", "upgrade", "provider-switch", "escalation", "recovery", "exit"] } },
        "mandatory": { "type": "boolean" },
        "owner": { "$ref": "#/$defs/accountableHuman" }
      }
    }
  }
}
