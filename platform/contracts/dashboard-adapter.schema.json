{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/contracts/dashboard-adapter.schema.json",
  "title": "Dashboard Adapter",
  "description": "En udskiftelig, read-only adapter til et eksternt dashboard-system. En adapter erklærer kun `read`-kapabiliteter, en tenant-scopet læserolle og hvilke views den kan vise. Adapteren får aldrig udførelsesmyndighed og kan derfor udskiftes uden at ændre forretningsmoduler eller udvide deres privilegier.",
  "type": "object",
  "required": ["schemaVersion", "kind", "id", "kindDetail", "version", "capabilities", "scopes", "views", "enabled"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "kind": { "const": "DashboardAdapter" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" },
    "kindDetail": { "enum": ["grafana", "loki", "prometheus", "custom"] },
    "version": { "type": "string", "minLength": 1 },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "const": "read" }
    },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^view:[a-z-]+$" }
    },
    "views": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["operations", "vulnerabilities", "test-release", "recovery", "ai"] }
    },
    "enabled": { "type": "boolean" },
    "endpoint": { "type": "string" },
    "notes": { "type": "string" }
  }
}
