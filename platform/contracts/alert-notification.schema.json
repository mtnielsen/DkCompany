{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/contracts/alert-notification.schema.json",
  "title": "Alert Notification",
  "description": "En minimeret alarmnotifikation med ejer, eskalation, runbook og en leveringskvittering. Den brede kanal bærer kun den minimerede observation; rå persondata forbliver i den adgangsstyrede kilde.",
  "type": "object",
  "required": ["apiVersion", "kind", "id", "alertId", "ruleId", "severity", "signal", "summary", "owner", "escalation", "runbook", "emittedAt", "minimized", "personalData", "delivery"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "contracts.platform/v1alpha1" },
    "kind": { "const": "AlertNotification" },
    "id": { "type": "string", "minLength": 1 },
    "alertId": { "type": "string", "minLength": 1 },
    "ruleId": { "type": "string", "minLength": 1 },
    "severity": { "enum": ["info", "warning", "critical"] },
    "signal": { "type": "string", "minLength": 1 },
    "tenantId": { "type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" },
    "summary": { "type": "string", "minLength": 1 },
    "owner": { "$ref": "#/$defs/human" },
    "escalation": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/escalation" } },
    "runbook": { "type": "string", "minLength": 1 },
    "emittedAt": { "type": "string", "format": "date-time" },
    "minimized": { "const": true },
    "personalData": {
      "type": "object",
      "required": ["removed", "digest"],
      "additionalProperties": false,
      "properties": {
        "removed": { "type": "array", "items": { "type": "string" } },
        "redactions": { "type": "array", "items": { "type": "string" } },
        "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "observed": { "type": ["object", "null"] },
    "delivery": {
      "type": "object",
      "required": ["recipientId", "transport", "status", "deliveredAt"],
      "additionalProperties": false,
      "properties": {
        "recipientId": { "type": ["string", "null"] },
        "transport": { "type": ["string", "null"] },
        "status": { "enum": ["delivered", "failed", "not-run"] },
        "receipt": { "type": ["string", "null"] },
        "reason": { "type": "string" },
        "deliveredAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "$defs": {
    "human": {
      "type": "object",
      "required": ["subject", "name", "role"],
      "additionalProperties": false,
      "properties": {
        "subject": { "type": "string", "pattern": "^[a-z][a-z0-9-]*\\|[a-z0-9][a-z0-9._-]{2,}$" },
        "name": { "type": "string", "minLength": 2 },
        "role": { "type": "string", "minLength": 2 }
      }
    },
    "escalation": {
      "type": "object",
      "required": ["afterMinutes", "to"],
      "additionalProperties": false,
      "properties": {
        "afterMinutes": { "type": "integer", "minimum": 0 },
        "to": { "$ref": "#/$defs/human" }
      }
    }
  }
}
