{
  "apiVersion": "v1",
  "kind": "LimitRange",
  "metadata": {
    "name": "prod-limits",
    "namespace": "platform-prod",
    "labels": {
      "app.kubernetes.io/name": "platform",
      "app.kubernetes.io/managed-by": "argocd",
      "platform.example.org/module": "platform",
      "platform.example.org/environment": "prod"
    }
  },
  "spec": {
    "limits": [
      {
        "type": "Container",
        "default": {
          "cpu": "500m",
          "memory": "256Mi"
        },
        "defaultRequest": {
          "cpu": "100m",
          "memory": "128Mi"
        }
      }
    ]
  }
}
