{
  "apiVersion": "v1",
  "kind": "ResourceQuota",
  "metadata": {
    "name": "staging-quota",
    "namespace": "platform-staging",
    "labels": {
      "app.kubernetes.io/name": "platform",
      "app.kubernetes.io/managed-by": "argocd",
      "platform.example.org/module": "platform",
      "platform.example.org/environment": "staging"
    }
  },
  "spec": {
    "hard": {
      "requests.cpu": "5000m",
      "requests.memory": "2560Mi",
      "limits.cpu": "10000m",
      "limits.memory": "5120Mi",
      "persistentvolumeclaims": "4"
    }
  }
}
