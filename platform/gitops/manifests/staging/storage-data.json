{
  "apiVersion": "v1",
  "kind": "PersistentVolumeClaim",
  "metadata": {
    "name": "platform-data",
    "namespace": "platform-staging",
    "labels": {
      "app.kubernetes.io/name": "platform",
      "app.kubernetes.io/managed-by": "argocd",
      "platform.example.org/module": "platform",
      "platform.example.org/environment": "staging",
      "platform.example.org/encrypted": "true"
    }
  },
  "spec": {
    "accessModes": [
      "ReadWriteOnce"
    ],
    "storageClassName": "hcloud-volumes",
    "resources": {
      "requests": {
        "storage": "50Gi"
      }
    }
  }
}
