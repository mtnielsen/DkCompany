{
  "apiVersion": "networking.k8s.io/v1",
  "kind": "NetworkPolicy",
  "metadata": {
    "name": "allow-internal",
    "namespace": "platform-staging",
    "labels": {
      "app.kubernetes.io/name": "platform",
      "app.kubernetes.io/managed-by": "argocd",
      "platform.example.org/module": "platform",
      "platform.example.org/environment": "staging"
    }
  },
  "spec": {
    "podSelector": {},
    "policyTypes": [
      "Ingress",
      "Egress"
    ],
    "ingress": [
      {
        "from": [
          {
            "namespaceSelector": {
              "matchLabels": {
                "kubernetes.io/metadata.name": "platform-staging"
              }
            }
          }
        ]
      }
    ],
    "egress": [
      {
        "to": [
          {
            "namespaceSelector": {
              "matchLabels": {
                "kubernetes.io/metadata.name": "platform-staging"
              }
            }
          }
        ]
      }
    ]
  }
}
