{
  "apiVersion": "cilium.io/v2",
  "kind": "CiliumNetworkPolicy",
  "metadata": {
    "name": "model-egress-gateway-allow",
    "namespace": "platform",
    "labels": {
      "app.kubernetes.io/name": "model-egress",
      "app.kubernetes.io/managed-by": "argocd",
      "platform.example.org/module": "ai-gateway",
      "platform.example.org/environment": "dev"
    }
  },
  "spec": {
    "endpointSelector": {
      "matchLabels": {
        "app.kubernetes.io/name": "ai-gateway"
      }
    },
    "egress": [
      {
        "toFQDNs": [
          { "matchName": "api.anthropic.com" },
          { "matchName": "api.openai.com" },
          { "matchName": "generativelanguage.googleapis.com" },
          { "matchName": "api.mistral.ai" }
        ],
        "toPorts": [
          {
            "ports": [{ "port": "443", "protocol": "TCP" }]
          }
        ]
      },
      {
        "toEndpoints": [
          {
            "matchLabels": {
              "k8s:io.kubernetes.pod.namespace": "kube-system",
              "k8s:k8s-app": "kube-dns"
            }
          }
        ],
        "toPorts": [{ "ports": [{ "port": "53", "protocol": "UDP" }] }]
      }
    ]
  }
}
