{
  "apiVersion": "v1",
  "kind": "ConfigMap",
  "metadata": {
    "name": "ai-gateway-config",
    "namespace": "platform",
    "labels": {
      "app.kubernetes.io/name": "ai-gateway",
      "app.kubernetes.io/managed-by": "argocd",
      "platform.example.org/module": "ai-gateway",
      "platform.example.org/environment": "dev"
    }
  },
  "data": {
    "providerName": "openai-compatible",
    "providerBaseUrl": "https://api.openai.com/v1",
    "egressAllowedHosts": "api.anthropic.com,api.openai.com,generativelanguage.googleapis.com,api.mistral.ai"
  }
}
