{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "openproject-adapter",
    "namespace": "platform",
    "labels": {
      "app.kubernetes.io/name": "openproject-adapter",
      "app.kubernetes.io/managed-by": "argocd",
      "platform.example.org/module": "openproject-adapter",
      "platform.example.org/environment": "dev"
    }
  },
  "spec": {
    "replicas": 2,
    "selector": {
      "matchLabels": {
        "app.kubernetes.io/name": "openproject-adapter"
      }
    },
    "template": {
      "metadata": {
        "labels": {
          "app.kubernetes.io/name": "openproject-adapter",
          "platform.example.org/module": "openproject-adapter",
          "platform.example.org/environment": "dev"
        }
      },
      "spec": {
        "serviceAccountName": "openproject-adapter",
        "securityContext": {
          "runAsNonRoot": true,
          "seccompProfile": {
            "type": "RuntimeDefault"
          }
        },
        "containers": [
          {
            "name": "openproject-adapter",
            "image": "ghcr.io/example/openproject-adapter@sha256:eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee",
            "args": [
              "serve",
              "--port",
              "8092",
              "--environment",
              "dev"
            ],
            "ports": [
              {
                "containerPort": 8092,
                "name": "http"
              }
            ],
            "env": [
              {
                "name": "PDP_ENDPOINT",
                "value": "https://pdp.platform.svc.cluster.local/v1/data/platform/ops/decision"
              },
              {
                "name": "PDP_FAIL_MODE",
                "value": "closed"
              },
              {
                "name": "OPENPROJECT_URL",
                "value": "http://openproject.platform.svc.cluster.local:80"
              }
            ],
            "securityContext": {
              "readOnlyRootFilesystem": true,
              "allowPrivilegeEscalation": false,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              }
            },
            "readinessProbe": {
              "httpGet": {
                "path": "/healthz",
                "port": 8092
              }
            },
            "livenessProbe": {
              "httpGet": {
                "path": "/healthz",
                "port": 8092
              }
            },
            "resources": {
              "requests": {
                "cpu": "100m",
                "memory": "128Mi"
              },
              "limits": {
                "cpu": "500m",
                "memory": "256Mi"
              }
            }
          }
        ]
      }
    }
  }
}
