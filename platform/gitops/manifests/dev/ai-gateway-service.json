{
  "apiVersion": "v1",
  "kind": "Service",
  "metadata": {
    "name": "ai-gateway",
    "namespace": "platform",
    "labels": {
      "app.kubernetes.io/name": "ai-gateway",
      "app.kubernetes.io/managed-by": "argocd",
      "platform.example.org/module": "ai-gateway",
      "platform.example.org/environment": "dev"
    }
  },
  "spec": {
    "selector": { "app.kubernetes.io/name": "ai-gateway" },
    "ports": [{ "name": "http", "port": 443, "targetPort": 8282 }]
  }
}
