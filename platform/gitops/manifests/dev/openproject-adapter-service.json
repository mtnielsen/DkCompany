{
  "apiVersion": "v1",
  "kind": "Service",
  "metadata": {
    "name": "openproject-adapter",
    "namespace": "platform",
    "labels": {
      "app.kubernetes.io/name": "openproject-adapter",
      "app.kubernetes.io/managed-by": "argocd",
      "platform.example.org/module": "openproject-adapter",
      "platform.example.org/environment": "dev"
    }
  },
  "spec": {
    "selector": {
      "app.kubernetes.io/name": "openproject-adapter"
    },
    "ports": [
      {
        "name": "http",
        "port": 443,
        "targetPort": 8092
      }
    ]
  }
}
