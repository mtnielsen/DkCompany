{
  "apiVersion": "v1",
  "kind": "Service",
  "metadata": {
    "name": "pdp",
    "namespace": "platform-ha",
    "labels": {
      "app.kubernetes.io/name": "pdp",
      "app.kubernetes.io/managed-by": "argocd",
      "platform.example.org/module": "pdp",
      "platform.example.org/environment": "ha"
    },
    "annotations": {
      "platform.example.org/service-discovery": "headless"
    }
  },
  "spec": {
    "clusterIP": "None",
    "selector": {
      "app.kubernetes.io/name": "pdp"
    },
    "ports": [
      {
        "name": "http",
        "port": 8181,
        "targetPort": 8181
      }
    ]
  }
}
