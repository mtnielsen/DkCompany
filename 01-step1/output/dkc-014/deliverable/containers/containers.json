{
  "apiVersion": "contracts.platform/v1alpha1",
  "kind": "ContainerCatalog",
  "description": "DKC-014: hvilke kontroltjenester der bygges som containere, hvilket repository billedet publiceres i, og hvilken Dockerfile der er kilden. Kataloget binder GitOps-manifesterne til et byggeri.",
  "images": [
    {
      "component": "pdp",
      "repository": "ghcr.io/example/platform-pdp",
      "dockerfile": "containers/pdp/Dockerfile",
      "context": "policy/pdp"
    },
    {
      "component": "ai-gateway",
      "repository": "ghcr.io/example/platform-ai-gateway",
      "dockerfile": "containers/ai-gateway/Dockerfile",
      "context": "gateway"
    },
    {
      "component": "audit-service",
      "repository": "ghcr.io/example/audit-service",
      "dockerfile": "containers/audit-service/Dockerfile",
      "context": "modules/audit-service/service"
    },
    {
      "component": "mattermost-adapter",
      "repository": "ghcr.io/example/mattermost-adapter",
      "dockerfile": "containers/mattermost-adapter/Dockerfile",
      "context": "modules/mattermost-adapter/service"
    },
    {
      "component": "keycloak-adapter",
      "repository": "ghcr.io/example/keycloak-adapter",
      "dockerfile": "containers/keycloak-adapter/Dockerfile",
      "context": "modules/keycloak-adapter/service"
    }
  ]
}
