{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/contracts/sbom.schema.json",
  "title": "Software Bill of Materials",
  "description": "DKC-014: en deterministisk software-BOM (CycloneDX-inspireret) for platformens samlede afhængigheder. Formålet er, at et artefakts indhold kan genskabes bit-for-bit og kobles til en digest, så releasevejen kan afvise et andet indhold end det, CI byggede og kontrollerede.",
  "type": "object",
  "required": ["apiVersion", "kind", "specVersion", "serialNumber", "metadata", "components"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "contracts.platform/v1alpha1" },
    "kind": { "const": "Sbom" },
    "specVersion": { "const": "1.5" },
    "serialNumber": {
      "type": "string",
      "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "Deterministisk udledt af indholdet, så samme trægiver samme serienummer."
    },
    "metadata": {
      "type": "object",
      "required": ["timestamp", "component"],
      "additionalProperties": false,
      "properties": {
        "timestamp": { "type": "string", "format": "date-time" },
        "component": { "$ref": "#/$defs/component" },
        "tools": { "type": "array", "items": { "$ref": "#/$defs/tool" } }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/component" }
    },
    "dependencies": {
      "type": "array",
      "items": { "$ref": "#/$defs/dependency" }
    }
  },
  "$defs": {
    "hash": {
      "type": "object",
      "required": ["alg", "content"],
      "additionalProperties": false,
      "properties": {
        "alg": { "enum": ["SHA-256", "SHA-512"] },
        "content": { "type": "string", "pattern": "^[a-f0-9]{64,128}$" }
      }
    },
    "component": {
      "type": "object",
      "required": ["type", "name", "version", "bom-ref"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["application", "library", "container", "operating-system", "framework"] },
        "name": { "type": "string", "minLength": 1 },
        "group": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "bom-ref": { "type": "string", "minLength": 1 },
        "purl": { "type": "string", "pattern": "^pkg:[a-z0-9.+-]+/" },
        "hashes": { "type": "array", "items": { "$ref": "#/$defs/hash" } },
        "licenses": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "tool": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "dependency": {
      "type": "object",
      "required": ["ref", "dependsOn"],
      "additionalProperties": false,
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "dependsOn": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
