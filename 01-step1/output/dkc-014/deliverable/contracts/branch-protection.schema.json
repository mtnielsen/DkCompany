{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/contracts/branch-protection.schema.json",
  "title": "Branch Protection",
  "description": "DKC-014: deklarativ beskyttelse af releasevejen. Politikken fastslår hvilke grene der kræver pull request, CODEOWNERS-review, hvilke statuskontroller der er obligatoriske, at DCO-sign-off bevares, og at almindelig commit-sign-off ikke beskrives som kryptografisk commitsignering.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "protectedPaths", "policies"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "contracts.platform/v1alpha1" },
    "kind": { "const": "BranchProtection" },
    "metadata": {
      "type": "object",
      "required": ["name", "version", "description", "accountableHuman"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9-]{3,63}$" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "description": { "type": "string", "minLength": 10 },
        "accountableHuman": { "$ref": "#/$defs/namedHuman" }
      }
    },
    "protectedPaths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Za-z0-9._*/-]+$" },
      "description": "Repository-stier der kræver CODEOWNERS-review. Dækker kontrakter, policy, sikkerhed og releaseværktøj."
    },
    "policies": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/policy" }
    }
  },
  "$defs": {
    "namedHuman": {
      "type": "object",
      "required": ["subject", "name", "role"],
      "additionalProperties": false,
      "properties": {
        "subject": { "type": "string", "minLength": 3 },
        "name": { "type": "string", "minLength": 2 },
        "role": { "type": "string", "minLength": 2 }
      }
    },
    "policy": {
      "type": "object",
      "required": [
        "pattern",
        "requirePullRequest",
        "requiredApprovingReviewCount",
        "requireCodeOwnerReviews",
        "dismissStaleReviews",
        "requireConversationResolution",
        "requiredStatusChecks",
        "requireDcoSignoff",
        "enforceAdmins",
        "allowForcePushes",
        "allowDeletions",
        "requireSignedCommits",
        "cryptoSigningClaimed"
      ],
      "additionalProperties": false,
      "properties": {
        "pattern": { "type": "string", "minLength": 1 },
        "requirePullRequest": { "const": true },
        "requiredApprovingReviewCount": { "type": "integer", "minimum": 1 },
        "requireCodeOwnerReviews": { "const": true },
        "dismissStaleReviews": { "const": true },
        "requireConversationResolution": { "const": true },
        "requiredStatusChecks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" }
        },
        "requireDcoSignoff": { "const": true },
        "enforceAdmins": { "const": true },
        "allowForcePushes": { "const": false },
        "allowDeletions": { "const": false },
        "requireSignedCommits": { "const": false },
        "cryptoSigningClaimed": { "const": false }
      }
    }
  }
}
