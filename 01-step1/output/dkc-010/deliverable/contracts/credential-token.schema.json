{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/contracts/credential-token.schema.json",
  "title": "Platform Credential Claims",
  "description": "DKC-010: claims i et kortlivet, scope-bundet rettighedstoken (JWS/EdDSA). Tokenet er kryptografisk signeret af en KMS/secret-broker og bindes til kunde, ressource, verbum, miljø, audience og TTL. Modtageren har kun den offentlige nøgle.",
  "type": "object",
  "required": ["iss", "sub", "aud", "jti", "iat", "nbf", "exp", "tenant_id", "agent_ref", "role", "scope"],
  "additionalProperties": false,
  "properties": {
    "iss": { "type": "string", "description": "Udsteder (credential-broker)." },
    "sub": { "type": "string", "pattern": "^spiffe://", "description": "Agentens SPIFFE-identitet." },
    "aud": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "Tilsigtede modtagere (executor-tjenester)." },
    "jti": { "type": "string", "format": "uuid" },
    "iat": { "type": "integer", "description": "Udstedt (epoch-sekunder)." },
    "nbf": { "type": "integer" },
    "exp": { "type": "integer", "description": "Udløber (epoch-sekunder)." },
    "tenant_id": { "type": "string" },
    "agent_ref": { "type": "string" },
    "role": { "enum": ["observer", "planner", "implementer", "verifier", "executor", "auditor"] },
    "task_id": { "type": ["string", "null"] },
    "on_behalf_of": { "type": "string" },
    "scope": {
      "type": "object",
      "required": ["verb", "resource", "environment"],
      "additionalProperties": false,
      "properties": {
        "verb": { "type": "string" },
        "resource": { "type": "string" },
        "environment": { "enum": ["dev", "staging", "prod"] }
      }
    }
  }
}
