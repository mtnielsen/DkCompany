{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/contracts/raci-registry.schema.json",
  "title": "RACI Registry",
  "description": "RACI-register for installations- og releaseacceptance (DKC-062). Hver post angiver et ansvarligt menneske (responsible) og en stedfortræder samt en accountable for hver service, dataklasse og kontrolproces. En registreret ejeraccept er en særskilt menneskelig begivenhed; den udledes aldrig af en grøn check.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "entries"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "contracts.platform/v1alpha1" },
    "kind": { "const": "RaciRegistry" },
    "metadata": {
      "type": "object",
      "required": ["name", "version", "description"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9-]{2,63}$" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
        "description": { "type": "string", "minLength": 10 },
        "labels": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "person": {
      "type": "object",
      "required": ["subject", "name"],
      "additionalProperties": false,
      "properties": {
        "subject": { "type": "string", "minLength": 3 },
        "name": { "type": "string", "minLength": 2 },
        "role": { "type": "string" }
      }
    },
    "entry": {
      "type": "object",
      "required": ["id", "scope", "ref", "responsible", "substitute", "accountable", "consulted", "informed"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]{2,63}$" },
        "scope": { "enum": ["service", "data-class", "control-process"] },
        "ref": { "type": "string", "minLength": 2 },
        "responsible": { "$ref": "#/$defs/person" },
        "substitute": { "$ref": "#/$defs/person" },
        "accountable": { "$ref": "#/$defs/person" },
        "consulted": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/person" } },
        "informed": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/person" } },
        "ownerAcceptanceRef": { "type": ["string", "null"] }
      }
    }
  }
}
