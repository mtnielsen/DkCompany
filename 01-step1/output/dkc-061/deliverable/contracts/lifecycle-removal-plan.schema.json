{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/contracts/lifecycle-removal-plan.schema.json",
  "title": "Lifecycle Removal Plan",
  "description": "DKC-061: en fjernelsesplan der holder fjernelse af et modul adskilt fra sletning af data. Planen laver en reverse-dependency-kontrol (en delt database eller IAM kan ikke fjernes mens aktive moduler kræver den), kræver eksport eller verificeret backup før en destruktiv handling, bevarer recoverymetadata ved almindelig afinstallering, og kræver en eksplicit, menneskelig destruktiv godkendelse for sletning.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "component", "mode", "reverseDependencies", "blocking", "dataDisposition", "preflight", "authorization", "steps", "restrictions"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "contracts.platform/v1alpha1" },
    "kind": { "const": "LifecycleRemovalPlan" },
    "metadata": {
      "type": "object",
      "required": ["name", "version", "createdAt", "description", "installationId"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 3 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "description": { "type": "string", "minLength": 10 },
        "installationId": { "type": "string", "minLength": 2 }
      }
    },
    "component": {
      "type": "object",
      "required": ["id", "version", "componentType"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 2 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "componentType": { "type": "string", "minLength": 2 }
      }
    },
    "mode": { "enum": ["remove-only", "remove-and-delete-data"] },
    "reverseDependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "required", "reason"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 2 },
          "required": { "type": "boolean" },
          "reason": { "type": "string", "minLength": 3 }
        }
      }
    },
    "blocking": { "type": "boolean" },
    "dataDisposition": {
      "type": "object",
      "required": ["preserve", "exportRef", "backupRef", "recoveryMetadataRef", "destructiveApproved"],
      "additionalProperties": false,
      "properties": {
        "preserve": { "type": "boolean" },
        "exportRef": { "type": ["string", "null"] },
        "backupRef": { "type": ["string", "null"] },
        "recoveryMetadataRef": { "type": ["string", "null"] },
        "destructiveApproved": { "type": "boolean" }
      }
    },
    "preflight": {
      "type": "object",
      "required": ["ok", "checks", "blockingProblems"],
      "additionalProperties": false,
      "properties": {
        "ok": { "type": "boolean" },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "title", "status", "detail"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 2 },
              "title": { "type": "string", "minLength": 2 },
              "status": { "enum": ["pass", "warn", "fail"] },
              "detail": { "type": "string" }
            }
          }
        },
        "blockingProblems": { "type": "array", "items": { "type": "string" } }
      }
    },
    "authorization": {
      "type": "object",
      "required": ["required", "humanSubject", "secondHumanSubject", "approvalRef"],
      "additionalProperties": false,
      "properties": {
        "required": { "type": "boolean" },
        "humanSubject": { "type": ["string", "null"], "pattern": "^[a-z][a-z0-9-]*\\|[a-z0-9][a-z0-9._-]{2,}$" },
        "secondHumanSubject": { "type": ["string", "null"], "pattern": "^[a-z][a-z0-9-]*\\|[a-z0-9][a-z0-9._-]{2,}$" },
        "approvalRef": { "type": ["string", "null"] }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "order", "kind", "description", "mutating", "requiresApproval", "dependsOn", "state"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 2 },
          "order": { "type": "integer", "minimum": 1 },
          "kind": { "enum": ["preflight", "reverse-dependency-check", "export", "backup", "remove", "delete-data", "verify"] },
          "description": { "type": "string", "minLength": 3 },
          "mutating": { "type": "boolean" },
          "requiresApproval": { "type": "boolean" },
          "dependsOn": { "type": "array", "items": { "type": "string" } },
          "state": { "enum": ["pending", "running", "done", "failed", "rolled-back"] }
        }
      }
    },
    "restrictions": {
      "type": "object",
      "required": ["separateFromDataDeletion", "requiresReverseDependencyCheck", "requiresExportOrBackup", "explicitDestructiveAction"],
      "additionalProperties": false,
      "properties": {
        "separateFromDataDeletion": { "type": "boolean" },
        "requiresReverseDependencyCheck": { "type": "boolean" },
        "requiresExportOrBackup": { "type": "boolean" },
        "explicitDestructiveAction": { "type": "boolean" }
      }
    }
  }
}
