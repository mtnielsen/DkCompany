{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/contracts/lifecycle-update-plan.schema.json",
  "title": "Lifecycle Update Plan",
  "description": "DKC-061: en signeret, deterministisk opdateringsplan for en modulopdatering. Planen viser påvirkningen (tilføjede, fjernede, opgraderede og nedgraderede komponenter samt berørte delte datatjenester), en migrationskontrol, en read-only preflight, en rollback-/gendannelsesvej og den menneskelige godkendelse. Den er resumable og må ikke formatere diske, overtage skemaer eller installere usignerede pakker.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "signature", "fromRelease", "toRelease", "catalogDigest", "impact", "migrationCheck", "preflight", "authorization", "rollback", "steps", "resume", "restrictions"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "contracts.platform/v1alpha1" },
    "kind": { "const": "LifecycleUpdatePlan" },
    "metadata": {
      "type": "object",
      "required": ["name", "version", "createdAt", "description", "installationId"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 3 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "description": { "type": "string", "minLength": 10 },
        "installationId": { "type": "string", "minLength": 2 }
      }
    },
    "signature": { "$ref": "#/$defs/signature" },
    "fromRelease": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "toRelease": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "catalogDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "impact": {
      "type": "object",
      "required": ["added", "removed", "upgraded", "downgraded", "sharedDataServices", "affectedTenants"],
      "additionalProperties": false,
      "properties": {
        "added": { "type": "array", "items": { "$ref": "#/$defs/change" } },
        "removed": { "type": "array", "items": { "$ref": "#/$defs/change" } },
        "upgraded": { "type": "array", "items": { "$ref": "#/$defs/change" } },
        "downgraded": { "type": "array", "items": { "$ref": "#/$defs/change" } },
        "sharedDataServices": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "kind", "requiredBy", "providedBy"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 2 },
              "kind": { "type": "string", "minLength": 2 },
              "requiredBy": { "type": "array", "items": { "type": "string" } },
              "providedBy": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "affectedTenants": { "type": "array", "items": { "type": "string", "minLength": 2 } }
      }
    },
    "migrationCheck": {
      "type": "object",
      "required": ["required", "phases", "reversible", "problems"],
      "additionalProperties": false,
      "properties": {
        "required": { "type": "boolean" },
        "phases": { "type": "array", "uniqueItems": true, "items": { "enum": ["pre", "schema", "data", "post"] } },
        "reversible": { "type": "boolean" },
        "problems": { "type": "array", "items": { "$ref": "#/$defs/problem" } }
      }
    },
    "preflight": {
      "type": "object",
      "required": ["ok", "checks", "blockingProblems"],
      "additionalProperties": false,
      "properties": {
        "ok": { "type": "boolean" },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "title", "status", "detail"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 2 },
              "title": { "type": "string", "minLength": 2 },
              "status": { "enum": ["pass", "warn", "fail"] },
              "detail": { "type": "string" }
            }
          }
        },
        "blockingProblems": { "type": "array", "items": { "type": "string" } }
      }
    },
    "authorization": {
      "type": ["object", "null"],
      "required": ["required", "humanSubject", "approvalRef", "twoPerson"],
      "additionalProperties": false,
      "properties": {
        "required": { "type": "boolean" },
        "humanSubject": { "type": ["string", "null"], "pattern": "^[a-z][a-z0-9-]*\\|[a-z0-9][a-z0-9._-]{2,}$" },
        "approvalRef": { "type": ["string", "null"] },
        "twoPerson": { "type": "boolean" }
      }
    },
    "rollback": {
      "type": "object",
      "required": ["strategy", "snapshotRef", "restoresRights", "documentedProcedureRef"],
      "additionalProperties": false,
      "properties": {
        "strategy": { "enum": ["snapshot-restore", "blue-green", "none"] },
        "snapshotRef": { "type": ["string", "null"] },
        "restoresRights": { "type": "boolean" },
        "documentedProcedureRef": { "type": "string", "minLength": 3 }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "order", "kind", "description", "mutating", "requiresApproval", "dependsOn", "state"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 2 },
          "order": { "type": "integer", "minimum": 1 },
          "kind": { "enum": ["preflight", "snapshot", "provision", "migrate", "configure", "verify", "rollback"] },
          "description": { "type": "string", "minLength": 3 },
          "mutating": { "type": "boolean" },
          "requiresApproval": { "type": "boolean" },
          "dependsOn": { "type": "array", "items": { "type": "string" } },
          "state": { "enum": ["pending", "running", "done", "failed", "rolled-back"] }
        }
      }
    },
    "resume": {
      "type": "object",
      "required": ["stateRef", "lastCompletedStep", "resumable"],
      "additionalProperties": false,
      "properties": {
        "stateRef": { "type": "string", "minLength": 3 },
        "lastCompletedStep": { "type": ["string", "null"] },
        "resumable": { "type": "boolean" }
      }
    },
    "restrictions": {
      "type": "object",
      "required": ["preserveData", "formatDisks", "adoptExistingSchema", "unsignedPackage"],
      "additionalProperties": false,
      "properties": {
        "preserveData": { "type": "boolean" },
        "formatDisks": { "type": "boolean" },
        "adoptExistingSchema": { "type": "boolean" },
        "unsignedPackage": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "signature": {
      "type": "object",
      "required": ["algorithm", "keyId", "value"],
      "additionalProperties": false,
      "properties": {
        "algorithm": { "enum": ["hmac-sha256", "ed25519"] },
        "keyId": { "type": "string", "minLength": 2 },
        "value": { "type": "string", "minLength": 16 },
        "signedAt": { "type": "string", "format": "date-time" }
      }
    },
    "problem": {
      "type": "object",
      "required": ["code", "message"],
      "additionalProperties": true,
      "properties": {
        "code": { "type": "string", "minLength": 2 },
        "message": { "type": "string", "minLength": 3 }
      }
    },
    "change": {
      "type": "object",
      "required": ["id", "from", "to", "componentType"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 2 },
        "from": { "type": ["string", "null"] },
        "to": { "type": ["string", "null"] },
        "componentType": { "type": "string", "minLength": 2 }
      }
    }
  }
}
