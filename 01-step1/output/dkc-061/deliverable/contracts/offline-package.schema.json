{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/contracts/offline-package.schema.json",
  "title": "Offline Package",
  "description": "DKC-061: definition af cloud-uafhængig drift, internetudfald og en valgfri offlinepakke. Pakken er selvstændig, angiver hvilke lokale kerneflows der fortsat virker uden internet, og markerer hver ekstern afhængighed (model-API, ekstern API eller opdateringskilde) med en eksplicit offline-adfærd. Der må ikke findes en tavs fallback: en ikke-understøttet ekstern funktion skal vises tydeligt.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "policy", "components", "coreFlows", "externalDependencies"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "contracts.platform/v1alpha1" },
    "kind": { "const": "OfflinePackage" },
    "metadata": {
      "type": "object",
      "required": ["name", "version", "description", "accountableHuman", "labels"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "description": { "type": "string", "minLength": 10 },
        "accountableHuman": { "$ref": "#/$defs/human" },
        "labels": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "policy": {
      "type": "object",
      "required": ["coreFlowsRemainLocal", "externalOutageVisible", "noSilentFallback", "packageSelfContained", "externalDependencyRegistryComplete"],
      "additionalProperties": false,
      "properties": {
        "coreFlowsRemainLocal": { "type": "boolean" },
        "externalOutageVisible": { "type": "boolean" },
        "noSilentFallback": { "type": "boolean" },
        "packageSelfContained": { "type": "boolean" },
        "externalDependencyRegistryComplete": { "type": "boolean" }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "version", "artifact", "digest"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 2 },
          "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "artifact": { "type": "string", "minLength": 3 },
          "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "coreFlows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "local", "externalDependencies"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 2 },
          "title": { "type": "string", "minLength": 5 },
          "local": { "type": "boolean" },
          "externalDependencies": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "externalDependencies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "endpointRef", "offlineBehavior", "affectedFeatures", "routeRefs", "localFallbackRef", "explicitStatus"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 2 },
          "kind": { "enum": ["model-api", "external-api", "update-source"] },
          "endpointRef": { "type": "string", "minLength": 3 },
          "offlineBehavior": { "enum": ["unavailable-visible", "local-fallback", "queued", "read-only-cache"] },
          "affectedFeatures": { "type": "array", "items": { "type": "string" } },
          "routeRefs": { "type": "array", "items": { "type": "string" } },
          "localFallbackRef": { "type": ["string", "null"] },
          "explicitStatus": { "type": "string", "minLength": 3 }
        }
      }
    }
  },
  "$defs": {
    "human": {
      "type": "object",
      "required": ["subject", "name", "role"],
      "additionalProperties": false,
      "properties": {
        "subject": { "type": "string", "pattern": "^[a-z][a-z0-9-]*\\|[a-z0-9][a-z0-9._-]{2,}$" },
        "name": { "type": "string", "minLength": 2 },
        "role": { "type": "string", "minLength": 2 },
        "substitute": { "$ref": "#/$defs/human" }
      }
    }
  }
}
