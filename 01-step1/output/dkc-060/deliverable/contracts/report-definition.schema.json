{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/contracts/report-definition.schema.json",
  "title": "Report Definition",
  "description": "Versionsstyret rapportdefinition med skabelon, parametre, datakilde, autoritativ definition, planlægning, format, modtager og audit. Definitionen bærer kun afsenderens *subject*, aldrig et creator-token: rettigheder revalideres ved hver kørsel og afsendelse. En modtager er en navngivet identitet med en eksplicit datadelingsreference.",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "id",
    "version",
    "template",
    "parameters",
    "dataSource",
    "authoritativeDefinition",
    "schedule",
    "format",
    "recipients",
    "audit",
    "senderSubject"
  ],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "contracts.platform/v1alpha1" },
    "kind": { "const": "ReportDefinition" },
    "metadata": {
      "type": "object",
      "required": ["name", "version", "description", "accountableHuman"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "description": { "type": "string", "minLength": 20 },
        "accountableHuman": { "$ref": "#/$defs/human" }
      }
    },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
    "version": { "type": "integer", "minimum": 1 },
    "template": {
      "type": "object",
      "required": ["id", "version"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type", "required", "sensitive"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$" },
          "type": { "enum": ["string", "integer", "date", "daterange", "boolean"] },
          "required": { "type": "boolean" },
          "sensitive": { "type": "boolean" },
          "default": {},
          "description": { "type": "string", "minLength": 5 }
        }
      }
    },
    "dataSource": {
      "type": "object",
      "required": ["id", "systemOfRecord", "classification", "moduleRef", "fields"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
        "systemOfRecord": { "type": "string", "minLength": 3 },
        "classification": { "enum": ["public", "internal", "personal", "sensitive", "special-category"] },
        "moduleRef": { "enum": ["communications", "hr", "bi", "reporting"] },
        "connectorRef": { "type": "string", "minLength": 3 },
        "fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_.]{1,63}$" }
        }
      }
    },
    "authoritativeDefinition": {
      "type": "object",
      "required": ["systemOfRecord", "definitionRef", "version", "owner"],
      "additionalProperties": false,
      "properties": {
        "systemOfRecord": { "type": "string", "minLength": 3 },
        "definitionRef": { "type": "string", "minLength": 3 },
        "version": { "type": "string", "minLength": 1 },
        "owner": { "$ref": "#/$defs/human" }
      }
    },
    "schedule": {
      "type": "object",
      "required": ["cron", "timezone", "enabled"],
      "additionalProperties": false,
      "properties": {
        "cron": { "type": "string", "minLength": 9 },
        "timezone": { "type": "string", "minLength": 3 },
        "enabled": { "type": "boolean" }
      }
    },
    "format": { "enum": ["pdf", "csv", "xlsx", "json"] },
    "recipients": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "subject", "dataSharingRef"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
          "kind": { "enum": ["human", "service", "external"] },
          "subject": { "type": "string", "minLength": 3 },
          "dataSharingRef": { "type": "string", "minLength": 3 }
        }
      }
    },
    "audit": {
      "type": "object",
      "required": ["required", "retentionDays"],
      "additionalProperties": false,
      "properties": {
        "required": { "const": true },
        "retentionDays": { "type": "integer", "minimum": 1 }
      }
    },
    "senderSubject": { "type": "string", "minLength": 3 }
  },
  "$defs": {
    "human": {
      "type": "object",
      "required": ["subject", "name", "role"],
      "additionalProperties": false,
      "properties": {
        "subject": { "type": "string", "minLength": 3 },
        "name": { "type": "string", "minLength": 2 },
        "role": { "type": "string", "minLength": 2 },
        "substitute": {
          "type": "object",
          "required": ["subject", "name"],
          "additionalProperties": false,
          "properties": {
            "subject": { "type": "string", "minLength": 3 },
            "name": { "type": "string", "minLength": 2 }
          }
        }
      }
    }
  }
}
