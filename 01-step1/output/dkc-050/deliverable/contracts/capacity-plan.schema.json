{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/contracts/capacity-plan.schema.json",
  "title": "Capacity Plan",
  "description": "Reproducerbar kapacitets- og skaleringsplan: en lastprofil pr. kundestørrelse, mindst tre hosts i adskilte fejldomæner med N+1, stateless- og køworker-autoskalering, en runbookstyret plan for stateful workloads, tenantkvoter med fairness, connection pools, backpressure og enhedspris. Planen måler ikke selv; en levende lasttest er en ekstern integration.",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "failureDomains",
    "topology",
    "loadProfiles",
    "baselineProfileId",
    "workloads",
    "tenantQuotas",
    "connectionPools",
    "backpressure",
    "cost",
    "capacityReport"
  ],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "contracts.platform/v1alpha1" },
    "kind": { "const": "CapacityPlan" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "hostingProfileRef": { "type": "string", "minLength": 1 },
    "failureDomains": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "topology": { "$ref": "#/$defs/topology" },
    "loadProfiles": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/loadProfile" }
    },
    "baselineProfileId": { "type": "string", "minLength": 1 },
    "workloads": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/workload" }
    },
    "tenantQuotas": { "$ref": "#/$defs/tenantQuotas" },
    "connectionPools": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/connectionPool" }
    },
    "backpressure": { "$ref": "#/$defs/backpressure" },
    "cost": { "$ref": "#/$defs/cost" },
    "capacityReport": { "$ref": "#/$defs/capacityReport" }
  },
  "$defs": {
    "human": {
      "type": "object",
      "required": ["subject", "name", "role"],
      "additionalProperties": false,
      "properties": {
        "subject": { "type": "string", "pattern": "^[a-z][a-z0-9-]*\\|[a-z0-9][a-z0-9._-]{2,}$" },
        "name": { "type": "string", "minLength": 2 },
        "role": { "type": "string", "minLength": 2 },
        "substitute": { "$ref": "#/$defs/human" }
      }
    },
    "metadata": {
      "type": "object",
      "required": ["name", "version", "description", "accountableHuman", "labels"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "description": { "type": "string", "minLength": 10 },
        "accountableHuman": { "$ref": "#/$defs/human" },
        "labels": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "topology": {
      "type": "object",
      "required": ["hosts", "hostCount", "nPlusOne"],
      "additionalProperties": false,
      "properties": {
        "hosts": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/host" }
        },
        "hostCount": { "type": "integer", "minimum": 3 },
        "nPlusOne": { "type": "boolean" }
      }
    },
    "host": {
      "type": "object",
      "required": ["id", "failureDomain", "cpuMillicores", "memoryMb", "networkMbps", "diskGb"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "failureDomain": { "type": "string", "minLength": 1 },
        "cpuMillicores": { "type": "integer", "minimum": 1 },
        "memoryMb": { "type": "integer", "minimum": 1 },
        "networkMbps": { "type": "integer", "minimum": 1 },
        "diskGb": { "type": "integer", "minimum": 1 }
      }
    },
    "loadProfile": {
      "type": "object",
      "required": ["id", "name", "concurrentUsers", "requestsPerSecond", "jobsPerSecond", "filesPerDay", "dataGb", "aiCallsPerDay"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,30}$" },
        "name": { "type": "string", "minLength": 2 },
        "concurrentUsers": { "type": "integer", "minimum": 1 },
        "requestsPerSecond": { "type": "number", "exclusiveMinimum": 0 },
        "jobsPerSecond": { "type": "number", "exclusiveMinimum": 0 },
        "filesPerDay": { "type": "integer", "minimum": 1 },
        "dataGb": { "type": "number", "exclusiveMinimum": 0 },
        "aiCallsPerDay": { "type": "integer", "minimum": 1 }
      }
    },
    "replicaRange": {
      "type": "object",
      "required": ["min", "max"],
      "additionalProperties": false,
      "properties": {
        "min": { "type": "integer", "minimum": 1 },
        "max": { "type": "integer", "minimum": 1 }
      }
    },
    "latency": {
      "type": "object",
      "required": ["baseP95Ms", "baseP99Ms"],
      "additionalProperties": false,
      "properties": {
        "baseP95Ms": { "type": "number", "exclusiveMinimum": 0 },
        "baseP99Ms": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "resourceLimits": {
      "type": "object",
      "required": ["cpu", "memory"],
      "additionalProperties": false,
      "properties": {
        "cpu": { "type": "string", "minLength": 1 },
        "memory": { "type": "string", "minLength": 1 }
      }
    },
    "capacityPerReplica": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "number", "exclusiveMinimum": 0 }
    },
    "autoscale": {
      "type": "object",
      "required": ["mode", "minReplicas", "maxReplicas", "scaleUpCooldownSeconds", "scaleDownCooldownSeconds"],
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["cpu", "queue-depth"] },
        "targetUtilizationPercent": { "type": "integer", "minimum": 1, "maximum": 95 },
        "targetQueueDepth": { "type": "integer", "minimum": 1 },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "scaleUpCooldownSeconds": { "type": "integer", "minimum": 0 },
        "scaleDownCooldownSeconds": { "type": "integer", "minimum": 0 }
      }
    },
    "statefulScaling": {
      "type": "object",
      "required": ["mode", "runbookRef", "multiActive"],
      "additionalProperties": false,
      "properties": {
        "mode": { "const": "runbook-only" },
        "runbookRef": { "type": "string", "minLength": 1 },
        "multiActive": { "type": "boolean" },
        "activeWriters": { "type": "integer", "minimum": 1 },
        "replication": {
          "type": "object",
          "required": ["mode", "replicationLagMs", "replicas"],
          "additionalProperties": false,
          "properties": {
            "mode": { "enum": ["synchronous", "asynchronous"] },
            "replicationLagMs": { "type": "number", "minimum": 0 },
            "replicas": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "workload": {
      "type": "object",
      "required": ["id", "kind", "moduleRef", "replicas", "capacityPerReplica", "latency", "resourceLimits"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,30}$" },
        "kind": { "enum": ["stateless", "stateful"] },
        "moduleRef": { "type": "string", "minLength": 1 },
        "replicas": { "$ref": "#/$defs/replicaRange" },
        "capacityPerReplica": { "$ref": "#/$defs/capacityPerReplica" },
        "latency": { "$ref": "#/$defs/latency" },
        "resourceLimits": { "$ref": "#/$defs/resourceLimits" },
        "connectionPoolRef": { "type": "string", "minLength": 1 },
        "autoscale": { "$ref": "#/$defs/autoscale" },
        "statefulScaling": { "$ref": "#/$defs/statefulScaling" }
      }
    },
    "tenantQuotas": {
      "type": "object",
      "required": ["default", "maxSharePercent", "fairness", "onExceed"],
      "additionalProperties": false,
      "properties": {
        "default": {
          "type": "object",
          "required": ["maxRequestsPerSecond", "maxConcurrentJobs", "maxStorageGb", "maxAiCallsPerDay", "maxConnections"],
          "additionalProperties": false,
          "properties": {
            "maxRequestsPerSecond": { "type": "number", "exclusiveMinimum": 0 },
            "maxConcurrentJobs": { "type": "integer", "minimum": 1 },
            "maxStorageGb": { "type": "number", "exclusiveMinimum": 0 },
            "maxAiCallsPerDay": { "type": "integer", "minimum": 1 },
            "maxConnections": { "type": "integer", "minimum": 1 }
          }
        },
        "maxSharePercent": { "type": "integer", "minimum": 1, "maximum": 99 },
        "fairness": {
          "type": "object",
          "required": ["algorithm", "defaultWeight", "reservationPercent"],
          "additionalProperties": false,
          "properties": {
            "algorithm": { "const": "weighted-fair-queue" },
            "defaultWeight": { "type": "number", "exclusiveMinimum": 0 },
            "reservationPercent": { "type": "integer", "minimum": 0, "maximum": 50 }
          }
        },
        "onExceed": { "const": "reject" }
      }
    },
    "connectionPool": {
      "type": "object",
      "required": ["id", "target", "maxConnectionsPerReplica", "reservedAdminConnections", "connectionTimeoutMs", "maxOverflow"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "maxConnectionsPerReplica": { "type": "integer", "minimum": 1 },
        "reservedAdminConnections": { "type": "integer", "minimum": 0 },
        "connectionTimeoutMs": { "type": "integer", "minimum": 1 },
        "maxOverflow": { "type": "integer", "minimum": 0 }
      }
    },
    "backpressure": {
      "type": "object",
      "required": ["queueDepthWarn", "queueDepthCritical", "maxOldestAgeSeconds", "strategy", "visible", "onOverflow", "durableBeforeAck"],
      "additionalProperties": false,
      "properties": {
        "queueDepthWarn": { "type": "integer", "minimum": 1 },
        "queueDepthCritical": { "type": "integer", "minimum": 1 },
        "maxOldestAgeSeconds": { "type": "integer", "minimum": 1 },
        "strategy": { "const": "pause-publishers" },
        "visible": { "const": true },
        "onOverflow": { "const": "reject" },
        "durableBeforeAck": { "const": true }
      }
    },
    "cost": {
      "type": "object",
      "required": ["currency", "perVcpuHour", "perGbMonth", "perAiCall", "perMillionRequests", "perMillionJobs"],
      "additionalProperties": false,
      "properties": {
        "currency": { "type": "string", "minLength": 3 },
        "perVcpuHour": { "type": "number", "minimum": 0 },
        "perGbMonth": { "type": "number", "minimum": 0 },
        "perAiCall": { "type": "number", "minimum": 0 },
        "perMillionRequests": { "type": "number", "minimum": 0 },
        "perMillionJobs": { "type": "number", "minimum": 0 }
      }
    },
    "capacityReport": {
      "type": "object",
      "required": ["scalingFactors", "measurement", "liveEvidenceRef"],
      "additionalProperties": false,
      "properties": {
        "scalingFactors": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "integer", "minimum": 1 }
        },
        "measurement": {
          "type": "object",
          "required": ["mode", "measured", "reason", "requiresLiveLoadTest"],
          "additionalProperties": false,
          "properties": {
            "mode": { "const": "deterministic-simulation" },
            "measured": { "const": false },
            "reason": { "type": "string", "minLength": 20 },
            "requiresLiveLoadTest": { "const": true }
          }
        },
        "liveEvidenceRef": { "type": "string", "minLength": 1 }
      }
    }
  }
}
