{
  "apiVersion": "v1",
  "kind": "ResourceQuota",
  "metadata": {
    "name": "tenant-quota-template",
    "labels": {
      "app.kubernetes.io/name": "tenant-quota",
      "app.kubernetes.io/managed-by": "argocd",
      "platform.example.org/module": "tenant-quota",
      "platform.example.org/environment": "performance"
    }
  },
  "spec": {
    "hard": {
      "requests.cpu": "100",
      "requests.memory": "500Gi",
      "limits.cpu": "100",
      "limits.memory": "500Gi",
      "count/jobs.batch": "50",
      "requests.nvidia.com/gpu": "0"
    },
    "annotations": {
      "platform.example.org/max-requests-per-second": "400",
      "platform.example.org/max-ai-calls-per-day": "20000",
      "platform.example.org/max-share-percent": "40",
      "platform.example.org/on-exceed": "reject"
    }
  }
}
