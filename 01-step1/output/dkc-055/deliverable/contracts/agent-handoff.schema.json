{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/contracts/agent-handoff.schema.json",
  "title": "Agent Handoff",
  "description": "DKC-055: en rollebundet overdragelse mellem to agentidentiteter. Bærer change-ID, inputdigest, den producerende rolle og den tilladte modtagerrolle. Grafen er asymmetrisk: plan (planner→implementer), diff (implementer→verifier), runbook (implementer→verifier/executor), verification (verifier→executor).",
  "type": "object",
  "required": ["apiVersion", "kind", "changeId", "artifactKind", "producer", "producerRole", "receiver", "receiverRole", "at", "digest"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "contracts.platform/v1alpha1" },
    "kind": { "const": "AgentHandoff" },
    "changeId": { "type": "string" },
    "artifactKind": { "enum": ["plan", "diff", "runbook", "verification"] },
    "artifactDigest": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "inputDigest": { "type": ["string", "null"] },
    "producer": { "type": "string" },
    "producerRole": { "enum": ["observer", "planner", "implementer", "verifier", "executor", "auditor"] },
    "producerModel": { "type": ["string", "null"] },
    "receiver": { "type": "string" },
    "receiverRole": { "enum": ["observer", "planner", "implementer", "verifier", "executor", "auditor"] },
    "planDigest": { "type": ["string", "null"] },
    "runbookDigest": { "type": ["string", "null"] },
    "diffDigest": { "type": ["string", "null"] },
    "at": { "type": "string", "format": "date-time" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
