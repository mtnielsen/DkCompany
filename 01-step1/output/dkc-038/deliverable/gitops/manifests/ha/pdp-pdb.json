{
  "apiVersion": "policy/v1",
  "kind": "PodDisruptionBudget",
  "metadata": {
    "name": "pdp",
    "namespace": "platform-ha",
    "labels": {
      "app.kubernetes.io/name": "pdp",
      "app.kubernetes.io/managed-by": "argocd",
      "platform.example.org/module": "pdp",
      "platform.example.org/environment": "ha"
    }
  },
  "spec": {
    "minAvailable": 2,
    "maxUnavailable": 1,
    "selector": {
      "matchLabels": {
        "app.kubernetes.io/name": "pdp"
      }
    }
  }
}
