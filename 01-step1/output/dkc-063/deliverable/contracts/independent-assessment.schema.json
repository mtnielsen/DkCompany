{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/contracts/independent-assessment.schema.json",
  "title": "Independent Assessments",
  "description": "Register over uafhængige vurderinger (DKC-063): penetrationstest, levende måling eller ekstern revision udført af et navngivet menneske uden for implementeringen. En implementør kan ikke oprette en gyldig post, og en post udløber. Uden en gyldig post forbliver et krav 'pending-independent-assessment' og blokerer release.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "assessments"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "contracts.platform/v1alpha1" },
    "kind": { "const": "IndependentAssessment" },
    "metadata": {
      "type": "object",
      "required": ["name", "version", "description", "accountableHuman"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9-]{2,63}$" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
        "description": { "type": "string", "minLength": 10 },
        "accountableHuman": { "$ref": "#/$defs/accountableHuman" }
      }
    },
    "assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "requirementId", "kind", "performedBy", "performedAt", "expiresAt", "evidenceRef", "scope"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^ASM-[A-Z0-9-]{2,40}$" },
          "requirementId": { "type": "string", "pattern": "^REQ-[A-Z0-9-]{2,40}$" },
          "kind": { "enum": ["independent-assessment", "penetration-test", "live-measurement", "external-audit"] },
          "performedBy": { "$ref": "#/$defs/accountableHuman" },
          "performedAt": { "type": "string", "format": "date-time" },
          "expiresAt": { "type": "string", "format": "date-time" },
          "evidenceRef": { "type": "string", "minLength": 3, "description": "Sti eller URL til den uafhængige evidens. Ikke en implementøropgjort status." },
          "scope": { "type": "string", "minLength": 5 },
          "targetCommit": { "type": "string", "description": "Det commit vurderingen dækker. Manglende felt gør vurderingen versionsløs og dermed ikke bindende for et andet commit." }
        }
      }
    }
  },
  "$defs": {
    "accountableHuman": {
      "type": "object",
      "required": ["subject", "role", "name"],
      "additionalProperties": false,
      "properties": {
        "subject": { "type": "string", "minLength": 3 },
        "name": { "type": "string", "minLength": 2 },
        "role": { "type": "string", "minLength": 2 },
        "substitute": {
          "type": "object",
          "required": ["subject", "name"],
          "additionalProperties": false,
          "properties": { "subject": { "type": "string", "minLength": 3 }, "name": { "type": "string", "minLength": 2 } }
        }
      }
    }
  }
}
