{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/contracts/migration-source.schema.json",
  "title": "Migration Source",
  "description": "DKC-031: ét valgt, dokumenteret kildeformat pr. pilotapp med entitetstyper, dedup-nøgler, roller og en dækningsmatrix for ejerskab, timestamps, kommentarer, bilag, ACL og links. Formatet skal kunne læses uden en aktiv DkCompany-installation.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "sources"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "contracts.platform/v1alpha1" },
    "kind": { "const": "MigrationSource" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } }
  },
  "$defs": {
    "human": {
      "type": "object",
      "required": ["subject", "name", "role"],
      "additionalProperties": false,
      "properties": {
        "subject": { "type": "string", "pattern": "^[a-z][a-z0-9-]*\\|[a-z0-9][a-z0-9._-]{2,}$" },
        "name": { "type": "string", "minLength": 2 },
        "role": { "type": "string", "minLength": 2 },
        "substitute": { "$ref": "#/$defs/human" }
      }
    },
    "metadata": {
      "type": "object",
      "required": ["name", "version", "description", "accountableHuman", "labels"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "description": { "type": "string", "minLength": 10 },
        "accountableHuman": { "$ref": "#/$defs/human" },
        "labels": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "format": {
      "type": "object",
      "required": ["id", "version", "mediaType", "documented", "docsRef", "readableWithoutPlatform"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 3 },
        "version": { "type": "string", "minLength": 1 },
        "mediaType": { "type": "string", "minLength": 3 },
        "documented": { "const": true },
        "docsRef": { "type": "string", "minLength": 3 },
        "readableWithoutPlatform": { "const": true }
      }
    },
    "facet": {
      "type": "object",
      "required": ["status"],
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["full", "partial", "unsupported"] },
        "source": { "type": "string" },
        "target": { "type": "string" },
        "note": { "type": "string" }
      }
    },
    "facets": {
      "type": "object",
      "required": ["ownership", "timestamps", "comments", "attachments", "acl", "links"],
      "additionalProperties": false,
      "properties": {
        "ownership": { "$ref": "#/$defs/facet" },
        "timestamps": { "$ref": "#/$defs/facet" },
        "comments": { "$ref": "#/$defs/facet" },
        "attachments": { "$ref": "#/$defs/facet" },
        "acl": { "$ref": "#/$defs/facet" },
        "links": { "$ref": "#/$defs/facet" }
      }
    },
    "role": {
      "type": "object",
      "required": ["read", "write", "appIds"],
      "additionalProperties": false,
      "properties": {
        "read": { "type": "boolean" },
        "write": { "type": "boolean" },
        "appIds": { "type": "array", "minItems": 1, "items": { "enum": ["files", "projects", "knowledge", "support", "crm"] } }
      }
    },
    "source": {
      "type": "object",
      "required": ["id", "appId", "product", "tenantId", "format", "systemOfRecord", "ownerField", "defaultOwner", "entityTypes", "dedupKeys", "facets", "roles", "retention"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,40}$" },
        "appId": { "enum": ["files", "projects", "knowledge", "support", "crm"] },
        "product": { "enum": ["nextcloud", "openproject", "bookstack", "zammad", "espocrm"] },
        "tenantId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" },
        "format": { "$ref": "#/$defs/format" },
        "systemOfRecord": { "const": "upstream" },
        "ownerField": { "type": "string", "minLength": 1 },
        "defaultOwner": { "type": "string", "pattern": "^[a-z][a-z0-9-]*\\|[a-z0-9][a-z0-9._-]{2,}$" },
        "entityTypes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "dedupKeys": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "array", "minItems": 1, "items": { "type": "string" } } },
        "facets": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/facets" } },
        "roles": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/role" } },
        "retention": {
          "type": "object",
          "required": ["recordDays", "exportDays"],
          "additionalProperties": false,
          "properties": {
            "recordDays": { "type": "integer", "minimum": 1 },
            "exportDays": { "type": "integer", "minimum": 1 }
          }
        }
      }
    }
  }
}
