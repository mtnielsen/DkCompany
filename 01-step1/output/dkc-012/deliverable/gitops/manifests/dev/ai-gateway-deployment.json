{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "ai-gateway",
    "namespace": "platform",
    "labels": {
      "app.kubernetes.io/name": "ai-gateway",
      "app.kubernetes.io/managed-by": "argocd",
      "platform.example.org/module": "ai-gateway",
      "platform.example.org/environment": "dev"
    }
  },
  "spec": {
    "replicas": 2,
    "selector": { "matchLabels": { "app.kubernetes.io/name": "ai-gateway" } },
    "template": {
      "metadata": {
        "labels": {
          "app.kubernetes.io/name": "ai-gateway",
          "platform.example.org/module": "ai-gateway",
          "platform.example.org/environment": "dev"
        }
      },
      "spec": {
        "serviceAccountName": "ai-gateway",
        "securityContext": { "runAsNonRoot": true, "seccompProfile": { "type": "RuntimeDefault" } },
        "containers": [
          {
            "name": "ai-gateway",
            "image": "ghcr.io/example/platform-ai-gateway@sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
            "args": ["--port", "8282", "--routes", "/etc/gateway/routes.json", "--db", "/var/lib/gateway/gateway.sqlite"],
            "ports": [{ "containerPort": 8282, "name": "http" }],
            "env": [
              {
                "name": "MODEL_PROVIDER_BASE_URL",
                "valueFrom": { "configMapKeyRef": { "name": "ai-gateway-config", "key": "providerBaseUrl" } }
              },
              {
                "name": "MODEL_PROVIDER_NAME",
                "valueFrom": { "configMapKeyRef": { "name": "ai-gateway-config", "key": "providerName" } }
              },
              {
                "name": "MODEL_PROVIDER_API_KEY",
                "valueFrom": { "secretKeyRef": { "name": "ai-gateway-provider", "key": "apiKey" } }
              }
            ],
            "volumeMounts": [
              { "name": "routes", "mountPath": "/etc/gateway", "readOnly": true },
              { "name": "state", "mountPath": "/var/lib/gateway" }
            ],
            "securityContext": {
              "readOnlyRootFilesystem": true,
              "allowPrivilegeEscalation": false,
              "capabilities": { "drop": ["ALL"] }
            },
            "readinessProbe": { "httpGet": { "path": "/healthz", "port": 8282 } },
            "livenessProbe": { "httpGet": { "path": "/healthz", "port": 8282 } },
            "resources": {
              "requests": { "cpu": "100m", "memory": "256Mi" },
              "limits": { "cpu": "1000m", "memory": "512Mi" }
            }
          }
        ],
        "volumes": [
          { "name": "routes", "configMap": { "name": "ai-gateway-routes" } },
          { "name": "state", "emptyDir": {} }
        ]
      }
    }
  }
}
