      "id": "enterprise-core",
      "title": "Enterprise-kernepakke",
      "segment": "enterprise",
      "order": 1,
      "baseProfileRef": "enterprise-dedicated",
      "selectionRationale": "Enterprise-kernen er den første pakke fordi den dedikerede enterprise-profil allerede er den eneste med kapacitet, egne app-instanser og databaser pr. kunde; den samler HR, indsigt, rapportering, økonomi, fakturering og tid uden at ændre sikkerhedskernen.",
      "demand": {
        "segments": [
          "enterprise"
        ],
        "pilotProfileRefs": [
          "enterprise"
        ],
        "businessProfileRefs": [
          "enterprise"
        ],
        "demandRank": 1,
        "rationale": "Enterprise Nord A/S (900 medarbejdere) efterspørger koncernøkonomi, HR og rapportering på en dedikeret installation, og metering-profilen 'enterprise' er den dokumenterede omkostningsramme."
      },
      "apps": [
        "hr",
        "bi",
        "reporting",
        "finance",
        "invoicing",
        "time"
      ],
      "capabilityConstraints": {
        "required": [
          "control-plane",
          "identity-oidc",
          "audit-log",
          "hr",
          "bi",
          "reporting",
          "finance",
          "accounting",
          "invoicing",
          "time-tracking"
        ],
        "forbidden": [
          "commerce",
          "payment"
        ],
        "controlPlane": [
          "control-plane",
          "policy-decision",
          "identity-oidc",
          "audit-log"
        ]
      },
      "dataOwnership": [
        {
          "dataClass": "financial",
          "owner": {
            "subject": "oidc|erik.eriksen",
            "name": "Erik Eriksen",
            "role": "Enterprise Delivery Owner"
          },
          "purpose": "Koncernøkonomi, bogføring og fakturering for enterprise-kunden.",
          "residency": "dk",
          "retentionRef": "retention/deletion-policy.json"
        },
        {
          "dataClass": "personal",
          "owner": {
            "subject": "oidc|cecilia.christensen",
            "name": "Cecilia Christensen",
            "role": "Security Officer"
          },
          "purpose": "Medarbejderstamdata og HR-administration med beskyttet feltadgang.",
          "residency": "eu",
          "retentionRef": "retention/deletion-policy.json"
        }
      ],
      "isolation": {
        "level": "dedicated",
        "dedicatedDatabases": true,
        "networkSegmentation": true,
        "immutableAudit": true,
        "notes": "Kundens egne app-instanser og databaser i et dedikeret fejldomæne; audit er holdbar og WORM-beskyttet."
      },
      "integrations": [
        {
          "candidateRef": "integration-candidate.tryton.example.json",
          "kind": "erp",
          "purpose": "Dansk økonomi og bogføring som kandidat bag en fremtidig adapter.",
          "availability": "included"
        },
        {
          "candidateRef": "integration-candidate.frappe-hr.example.json",
          "kind": "hr",
          "purpose": "Medarbejderstamdata og HR-workflows som kandidat bag en fremtidig adapter.",
          "availability": "included"
        },
        {
          "candidateRef": "integration-candidate.kimai.example.json",
          "kind": "time",
          "purpose": "Tidsregistrering som kandidat bag en fremtidig adapter.",
          "availability": "opt-in"
        }
      ],
      "professionalRequirements": [
        {
          "id": "danish-accounting",
          "title": "Dansk bogføring og moms",
