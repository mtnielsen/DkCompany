      "testCustomer": {
        "name": "Enterprise Nord A/S",
        "contact": {
          "subject": "oidc|erik.eriksen",
          "name": "Erik Eriksen",
          "role": "CTO"
        },
        "status": "identified",
        "contractRef": null,
        "synthetic": true
      },
      "implementation": {
        "status": "blocked",
        "reason": "Blokeret indtil dansk bogføring, moms, e-faktura og løn er afklaret af navngivne fagpersoner, og testkundens aftale er underskrevet."
      },
      "tcoRef": {
        "profileId": "enterprise",
        "tcoComparisonRef": "metering/report/tco-comparison.json"
