      "exclusions": [
        {
          "candidate": "Egen bogføringsmotor",
          "reason": "Egen bogføringsmotor ville være et parallelt ERP-produkt med dansk bogføringslov som vedvarende ansvar."
        },
        {
          "candidate": "Fuld ERP på small-vps",
          "reason": "En lille VPS har ikke kapaciteten; enterprise-kernen kræver den dedikerede enterprise-profil."
        }
