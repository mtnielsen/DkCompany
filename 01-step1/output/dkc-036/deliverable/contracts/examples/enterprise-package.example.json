      "sectorRules": {
        "regimes": [],
        "status": "not-applicable",
        "assessmentRef": null,
        "notes": "Enterprise-kernen er ikke omfattet af en sektorspecifik regel ud over de generelle regnskabs- og momskrav, som håndteres som faglige krav."
      },
      "highRiskAi": {
        "applicable": false,
        "assessmentRef": null,
