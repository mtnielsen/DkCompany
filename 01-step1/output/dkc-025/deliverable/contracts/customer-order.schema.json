{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/contracts/customer-order.schema.json",
  "title": "Customer Order",
  "description": "En kundes bestilling af en versioneret servicepakke med det serverberegnede pris-/konsekvenspreview, den godkendte ændring og de deterministiske provisioneringstrin. Trinnene bærer en idempotency-key, så et delvist fejlet forløb kan genoptages uden dobbeltressourcer.",
  "type": "object",
  "required": ["apiVersion", "kind", "orderId", "tenantId", "packageId", "packageVersion", "state", "preview", "createdAt", "updatedAt", "steps"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "contracts.platform/v1alpha1" },
    "kind": { "const": "CustomerOrder" },
    "orderId": { "type": "string", "minLength": 3 },
    "tenantId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" },
    "packageId": { "type": "string", "pattern": "^[a-z0-9-]{2,63}$" },
    "packageVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$" },
    "state": { "enum": ["requested", "approved", "provisioning", "active", "partial", "suspended", "winding-down", "closed"] },
    "requestedBy": { "$ref": "#/$defs/actor" },
    "approvedBy": { "anyOf": [{ "$ref": "#/$defs/actor" }, { "type": "null" }] },
    "approval": {
      "type": ["object", "null"],
      "required": ["reason", "at"],
      "additionalProperties": false,
      "properties": { "reason": { "type": "string", "minLength": 3 }, "at": { "type": "string" } }
    },
    "acknowledgedConsequences": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "preview": {
      "type": "object",
      "required": ["currency", "monthly", "implementation", "firstMonthTotal"],
      "additionalProperties": true,
      "properties": {
        "currency": { "const": "DKK" },
        "monthly": { "type": "number", "minimum": 0 },
        "implementation": { "type": "number", "minimum": 0 },
        "firstMonthTotal": { "type": "number", "minimum": 0 },
        "consequences": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "severity", "description"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "severity": { "enum": ["info", "notice", "material"] },
              "description": { "type": "string" },
              "requiresAcknowledgment": { "type": "boolean" }
            }
          }
        }
      }
    },
    "createdAt": { "type": "string", "minLength": 10 },
    "updatedAt": { "type": "string", "minLength": 10 },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["stepId", "moduleId", "idempotencyKey", "resourceRef", "state"],
        "additionalProperties": false,
        "properties": {
          "stepId": { "type": "string", "minLength": 1 },
          "moduleId": { "type": "string", "minLength": 1 },
          "idempotencyKey": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "resourceRef": { "type": "string", "pattern": "^res://" },
          "state": { "enum": ["pending", "succeeded", "failed", "reused", "skipped"] },
          "attempts": { "type": "integer", "minimum": 0 },
          "error": { "type": ["string", "null"] },
          "resource": {
            "anyOf": [
              { "type": "null" },
              {
                "type": "object",
                "required": ["ref", "created", "reused"],
                "additionalProperties": false,
                "properties": {
                  "ref": { "type": "string", "pattern": "^res://" },
                  "created": { "type": "boolean" },
                  "reused": { "type": "boolean" }
                }
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "actor": {
      "type": "object",
      "required": ["subject", "name"],
      "additionalProperties": false,
      "properties": {
        "subject": { "type": "string", "minLength": 3 },
        "name": { "type": "string", "minLength": 2 },
        "role": { "type": ["string", "null"] }
      }
    }
  }
}
