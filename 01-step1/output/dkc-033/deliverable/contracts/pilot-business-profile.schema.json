{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/contracts/pilot-business-profile.schema.json",
  "title": "Pilot Business Profile Set",
  "description": "Repræsentative pilotvirksomhedsprofiler (DKC-033). Tre profiler med forskellig størrelse, segment, roller og integrationsbehov, hver bundet til en understøttet installationsprofil og en syntetisk tenant. Profilerne er input til de kørebare pilotscenarier og readiness-aggregatoren; de er ikke kundedata.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "profiles"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "contracts.platform/v1alpha1" },
    "kind": { "const": "PilotProfileSet" },
    "metadata": {
      "type": "object",
      "required": ["name", "version", "description", "accountableHuman"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9-]{2,63}$" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
        "description": { "type": "string", "minLength": 20 },
        "accountableHuman": { "$ref": "#/$defs/human" },
        "labels": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/profile" }
    }
  },
  "$defs": {
    "human": {
      "type": "object",
      "required": ["subject", "role", "name"],
      "additionalProperties": false,
      "properties": {
        "subject": { "type": "string", "minLength": 3 },
        "name": { "type": "string", "minLength": 2 },
        "role": { "type": "string", "minLength": 2 },
        "substitute": {
          "type": "object",
          "required": ["subject", "name"],
          "additionalProperties": false,
          "properties": {
            "subject": { "type": "string", "minLength": 3 },
            "name": { "type": "string", "minLength": 2 }
          }
        }
      }
    },
    "resourceEnvelope": {
      "type": "object",
      "required": ["cpuMillicores", "memoryMiB", "storageGiB", "nodes"],
      "additionalProperties": false,
      "properties": {
        "cpuMillicores": { "type": "integer", "minimum": 100 },
        "memoryMiB": { "type": "integer", "minimum": 128 },
        "storageGiB": { "type": "integer", "minimum": 1 },
        "nodes": { "type": "integer", "minimum": 1 }
      }
    },
    "role": {
      "type": "object",
      "required": ["id", "kind", "description"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]{2,63}$" },
        "kind": { "enum": ["human", "service", "agent"] },
        "description": { "type": "string", "minLength": 5 },
        "external": { "type": "boolean" },
        "namedHuman": {
          "type": "object",
          "required": ["subject", "name"],
          "additionalProperties": false,
          "properties": {
            "subject": { "type": "string", "minLength": 3 },
            "name": { "type": "string", "minLength": 2 }
          }
        }
      }
    },
    "integration": {
      "type": "object",
      "required": ["id", "kind", "need", "availability"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]{2,63}$" },
        "kind": { "type": "string", "minLength": 2 },
        "need": { "type": "string", "minLength": 3 },
        "availability": { "enum": ["included", "opt-in", "unavailable"] },
        "reason": { "type": "string" },
        "scopeNote": { "type": "string" }
      }
    },
    "profile": {
      "type": "object",
      "required": [
        "id",
        "name",
        "segment",
        "companySizeEmployees",
        "deploymentProfileRef",
        "ledgerTenantId",
        "tenantFixtures",
        "roles",
        "integrations",
        "criticalWorkflows",
        "resourceEnvelope",
        "owner"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]{2,63}$" },
        "name": { "type": "string", "minLength": 3 },
        "segment": { "enum": ["smv", "service", "enterprise"] },
        "companySizeEmployees": { "type": "integer", "minimum": 1 },
        "deploymentProfileRef": { "type": "string", "pattern": "^[a-z0-9-]{2,63}$" },
        "ledgerTenantId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" },
        "tenantFixtures": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["tenantId", "name", "kind"],
            "additionalProperties": false,
            "properties": {
              "tenantId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" },
              "name": { "type": "string", "minLength": 2 },
              "kind": { "enum": ["customer", "tenant", "shared"] },
              "synthetic": { "const": true }
            }
          }
        },
        "roles": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/role" } },
        "integrations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/integration" } },
        "criticalWorkflows": {
          "type": "array",
          "minItems": 6,
          "uniqueItems": true,
          "items": { "enum": ["login-offboarding", "daily-work", "restore", "privacy-case", "upgrade", "exit"] }
        },
        "resourceEnvelope": { "$ref": "#/$defs/resourceEnvelope" },
        "owner": { "$ref": "#/$defs/human" }
      }
    }
  }
}
