{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/contracts/storage-plan.schema.json",
  "title": "Storage Plan",
  "description": "DKC-041: den konkrete plan for holdbart fil- og objektlager. Planen erklærer et vedligeholdt CSI-/objektlager med dokumenteret replika- eller erasure-coding-fejlmodel, en topologi med hosts, diske, fejldomæner, quorum og minimum frirum, versionsstyrede objekter med checksums og scrub/repair, kundeafgrænsede nøgler samt en dataklassifikation hvor ingen nødvendig tilstand ligger på ephemeral disk. Skemaet håndhæver formen; storage/src/plan.mjs håndhæver beslutningerne og kan ikke erstatte en målt fejlmodel på et levende lager.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "hostingProfileRef", "provider", "failureDomains", "topology", "dataClasses", "checksums", "scrub", "capacity", "keys", "relocation", "slos"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "contracts.platform/v1alpha1" },
    "kind": { "const": "StoragePlan" },
    "metadata": {
      "type": "object",
      "required": ["name", "version", "description", "accountableHuman"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "description": { "type": "string", "minLength": 20 },
        "accountableHuman": { "$ref": "#/$defs/human" },
        "labels": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "hostingProfileRef": { "type": "string", "pattern": "^catalog/profiles/[a-z0-9.-]+\\.profile\\.json$" },
    "provider": {
      "type": "object",
      "required": ["csi", "objectStore"],
      "additionalProperties": false,
      "properties": {
        "csi": {
          "type": "object",
          "required": ["name", "version", "maintained", "failureModel", "documented", "docsRef"],
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string", "minLength": 2 },
            "version": { "type": "string", "minLength": 1 },
            "maintained": { "const": true },
            "failureModel": { "enum": ["replicated", "erasure-coding"] },
            "documented": { "const": true },
            "docsRef": { "type": "string", "minLength": 3 }
          }
        },
        "objectStore": {
          "type": "object",
          "required": ["name", "version", "maintained", "s3Compatible", "versioning", "objectLock", "failureModel", "docsRef"],
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string", "minLength": 2 },
            "version": { "type": "string", "minLength": 1 },
            "maintained": { "const": true },
            "s3Compatible": { "const": true },
            "versioning": { "const": true },
            "objectLock": { "const": true },
            "failureModel": { "enum": ["replicated", "erasure-coding"] },
            "docsRef": { "type": "string", "minLength": 3 }
          }
        }
      }
    },
    "failureDomains": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 3 }
    },
    "topology": {
      "type": "object",
      "required": ["hosts", "replicaFactor", "writeQuorum", "readQuorum", "quorum", "minFreeSpacePercent", "minFreeSpaceBytes", "unsafeWritesOnQuorumLoss", "ephemeralDiskRequiredState"],
      "additionalProperties": false,
      "properties": {
        "hosts": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": ["id", "failureDomain", "disks"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
              "failureDomain": { "type": "string", "minLength": 3 },
              "disks": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["id", "sizeBytes", "type"],
                  "additionalProperties": false,
                  "properties": {
                    "id": { "type": "string", "minLength": 2 },
                    "sizeBytes": { "type": "integer", "minimum": 1 },
                    "type": { "enum": ["ssd", "nvme", "hdd"] }
                  }
                }
              }
            }
          }
        },
        "replicaFactor": { "type": "integer", "minimum": 2 },
        "writeQuorum": { "type": "integer", "minimum": 1 },
        "readQuorum": { "type": "integer", "minimum": 1 },
        "quorum": { "type": "integer", "minimum": 1 },
        "minFreeSpacePercent": { "type": "number", "minimum": 1, "maximum": 90 },
        "minFreeSpaceBytes": { "type": "integer", "minimum": 1 },
        "erasureCoding": {
          "type": "object",
          "required": ["dataShards", "parityShards", "minShards"],
          "additionalProperties": false,
          "properties": {
            "dataShards": { "type": "integer", "minimum": 2 },
            "parityShards": { "type": "integer", "minimum": 1 },
            "minShards": { "type": "integer", "minimum": 1 }
          }
        },
        "unsafeWritesOnQuorumLoss": { "const": false },
        "ephemeralDiskRequiredState": { "const": false }
      }
    },
    "dataClasses": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "description", "durable", "cache", "rebuildable", "ephemeral", "tenantScopedKey", "encryption", "placement"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
          "description": { "type": "string", "minLength": 10 },
          "durable": { "type": "boolean" },
          "cache": { "type": "boolean" },
          "rebuildable": { "type": "boolean" },
          "ephemeral": { "type": "boolean" },
          "tenantScopedKey": { "const": true },
          "encryption": { "enum": ["aes-256-gcm", "none"] },
          "placement": { "enum": ["durable-volume", "replicated", "erasure-coded", "ephemeral"] }
        }
      }
    },
    "checksums": {
      "type": "object",
      "required": ["algorithm", "onWrite", "onRead", "scrubIntervalHours"],
      "additionalProperties": false,
      "properties": {
        "algorithm": { "const": "sha256" },
        "onWrite": { "const": true },
        "onRead": { "const": true },
        "scrubIntervalHours": { "type": "integer", "minimum": 1 }
      }
    },
    "scrub": {
      "type": "object",
      "required": ["enabled", "intervalHours", "detectsSilentCorruption", "repair", "repairSource", "maxConcurrentRepairs"],
      "additionalProperties": false,
      "properties": {
        "enabled": { "const": true },
        "intervalHours": { "type": "integer", "minimum": 1 },
        "detectsSilentCorruption": { "const": true },
        "repair": { "const": true },
        "repairSource": { "enum": ["healthy-replica-or-parity"] },
        "maxConcurrentRepairs": { "type": "integer", "minimum": 1 }
      }
    },
    "capacity": {
      "type": "object",
      "required": ["perHostCapacityBytes", "alarmThresholdPercent", "hardStopPercent", "alerts"],
      "additionalProperties": false,
      "properties": {
        "perHostCapacityBytes": { "type": "integer", "minimum": 1 },
        "alarmThresholdPercent": { "type": "number", "minimum": 1, "maximum": 90 },
        "hardStopPercent": { "type": "number", "minimum": 0, "maximum": 50 },
        "alerts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "atFreePercent", "severity"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "minLength": 3 },
              "atFreePercent": { "type": "number", "minimum": 0, "maximum": 99 },
              "severity": { "enum": ["warning", "critical"] }
            }
          }
        }
      }
    },
    "keys": {
      "type": "object",
      "required": ["tenantScoped", "provider", "storeContainsKey", "rotationDays", "algorithm"],
      "additionalProperties": false,
      "properties": {
        "tenantScoped": { "const": true },
        "provider": { "type": "string", "minLength": 3 },
        "storeContainsKey": { "const": false },
        "rotationDays": { "type": "integer", "minimum": 1, "maximum": 365 },
        "algorithm": { "const": "aes-256-gcm" }
      }
    },
    "relocation": {
      "type": "object",
      "required": ["workloadStateOnEphemeral", "stateLivesInStorage", "preserveFilesAndPermissions", "procedure"],
      "additionalProperties": false,
      "properties": {
        "workloadStateOnEphemeral": { "const": false },
        "stateLivesInStorage": { "const": true },
        "preserveFilesAndPermissions": { "const": true },
        "procedure": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 3 }
        }
      }
    },
    "slos": {
      "type": "object",
      "required": ["repairUnderLoadPreservesSlo", "maxRepairSeconds", "maxScrubSeconds", "availabilityPercent"],
      "additionalProperties": false,
      "properties": {
        "repairUnderLoadPreservesSlo": { "const": true },
        "maxRepairSeconds": { "type": "integer", "minimum": 1 },
        "maxScrubSeconds": { "type": "integer", "minimum": 1 },
        "availabilityPercent": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    }
  },
  "$defs": {
    "human": {
      "type": "object",
      "required": ["subject", "name", "role"],
      "additionalProperties": false,
      "properties": {
        "subject": { "type": "string", "minLength": 3 },
        "name": { "type": "string", "minLength": 2 },
        "role": { "type": "string", "minLength": 2 },
        "substitute": {
          "type": "object",
          "required": ["subject", "name"],
          "additionalProperties": false,
          "properties": {
            "subject": { "type": "string", "minLength": 3 },
            "name": { "type": "string", "minLength": 2 }
          }
        }
      }
    }
  }
}
