{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/contracts/component-manifest.schema.json",
  "title": "Component Manifest",
  "description": "Versioneret katalogmanifest for én installerbar komponent (sikkerhedskerne, teknik, applikation, datatjeneste eller host-styring). Manifestet bærer required/optional dependencies med versionsintervaller, capabilities, conflicts, datatjenester, migrationer, ressourcer, download-/driftskrav, supportprofil og platformskrav. Det er den kontrakt dependency-resolveren (DKC-053) regner på, og det er bevidst adskilt fra module-manifest.schema.json, som er ops-kontrakten for et implementeret modul.",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "componentType",
    "category",
    "securityCore",
    "provides",
    "supportProfile",
    "platforms",
    "resources",
    "requires",
    "optionalRequires",
    "conflicts",
    "dataServices",
    "migrations",
    "download",
    "operations",
    "implementation"
  ],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "contracts.platform/v1alpha1" },
    "kind": { "const": "ComponentManifest" },

    "metadata": {
      "type": "object",
      "required": ["name", "version", "description", "accountableHuman"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9-]{2,63}$" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$", "description": "SemVer for denne komponentversion." },
        "description": { "type": "string", "minLength": 10 },
        "accountableHuman": { "$ref": "#/$defs/accountableHuman" },
        "labels": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },

    "componentType": {
      "enum": ["security-core", "technical", "application", "data-service", "host-management", "integration"],
      "description": "security-core er den obligatoriske sikkerhedskerne; host-management er separat opt-in og må ikke være securityCore."
    },
    "category": {
      "enum": ["security", "platform", "data", "communications", "hr", "bi", "reporting", "integration", "other"],
      "description": "Produktkategori. communications/hr/bi/reporting er de valgfrie applikationskategorier."
    },
    "securityCore": {
      "type": "boolean",
      "description": "Sand for komponenter i den obligatoriske sikkerhedskerne. Resolveren medtager dem for enhver profil; de kan ikke fravælges."
    },

    "provides": {
      "type": "object",
      "required": ["capabilities", "dataServices"],
      "additionalProperties": false,
      "properties": {
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{1,63}$" }
        },
        "dataServices": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": ["id", "kind"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
              "kind": { "enum": ["relational", "columnar", "object", "queue", "cache", "search", "backup"] }
            }
          }
        }
      }
    },

    "supportProfile": {
      "type": "object",
      "required": ["tier", "supportWindow"],
      "additionalProperties": false,
      "properties": {
        "tier": { "enum": ["supported", "best-effort", "community"] },
        "supportWindow": { "type": "string", "minLength": 3, "description": "Fx '24 måneder fra GA'." },
        "escalation": { "type": "string", "description": "Hvem der kontaktes, og hvordan." },
        "notes": { "type": "string" }
      }
    },

    "platforms": {
      "type": "object",
      "required": ["os", "arch", "runtime"],
      "additionalProperties": false,
      "properties": {
        "os": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["linux", "windows", "darwin"] } },
        "arch": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["x64", "arm64"] } },
        "runtime": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^node[<>=^~ ]" } }
      }
    },

    "resources": {
      "type": "object",
      "required": ["cpuMillicores", "memoryMiB", "storageGiB", "nodes"],
      "additionalProperties": false,
      "properties": {
        "cpuMillicores": { "type": "integer", "minimum": 0 },
        "memoryMiB": { "type": "integer", "minimum": 0 },
        "storageGiB": { "type": "integer", "minimum": 0 },
        "nodes": { "type": "integer", "minimum": 0, "description": "Antal dedikerede knuder komponenten kræver ud over delte." },
        "gpuRequired": { "type": "boolean" }
      }
    },

    "requires": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/dependency" },
      "description": "Påkrævede afhængigheder. Resolveren fejler lukket hvis en ikke kan opfyldes."
    },
    "optionalRequires": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/optionalDependency" },
      "description": "Valgfrie afhængigheder. Medtages kun når de er valgt eller trukket ind af en anden valgt komponent."
    },
    "conflicts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["ref", "reason"],
        "additionalProperties": false,
        "properties": {
          "ref": { "type": "string", "pattern": "^[a-z0-9-]{2,63}$" },
          "range": { "type": "string", "description": "Valgfrit versionsinterval for hvornår konflikten gælder." },
          "reason": { "type": "string", "minLength": 10 }
        }
      }
    },

    "dataServices": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["id", "kind", "required", "reason"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
          "kind": { "enum": ["relational", "columnar", "object", "queue", "cache", "search", "backup"] },
          "required": { "type": "boolean" },
          "reason": { "type": "string", "minLength": 10 }
        }
      },
      "description": "Datatjenester komponenten har brug for. En påkrævet datatjeneste kræver en provider i den valgte closure."
    },

    "migrations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["id", "phase", "description", "reversible"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,80}$" },
          "phase": { "enum": ["pre", "schema", "data", "post"] },
          "description": { "type": "string", "minLength": 10 },
          "reversible": { "type": "boolean" }
        }
      }
    },

    "download": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["artifact", "sizeMiB", "source", "verified"],
        "additionalProperties": false,
        "properties": {
          "artifact": { "type": "string", "minLength": 3 },
          "sizeMiB": { "type": "integer", "minimum": 0 },
          "source": { "type": "string", "minLength": 3 },
          "verified": { "type": "boolean", "description": "Om artefaktet verificeres (digest/signatur) før brug." },
          "checksum": { "type": "string" }
        }
      },
      "description": "Download-/artefaktkrav. Resolveren summerer størrelser og kræver verificerede artefakter."
    },

    "operations": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["backup", "restore", "verify-restore", "drain", "upgrade", "migrate", "rollback", "health", "slo"] },
      "description": "Driftskrav (ops-verber) som installationen skal understøtte for komponenten."
    },

    "implementation": {
      "type": "object",
      "description": "Hvor komponenten faktisk kommer fra. 'catalog-only' er ærligt og må ikke fremstilles som implementeret.",
      "required": ["status"],
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["implemented", "catalog-only", "external"] },
        "moduleRef": { "type": "string", "description": "Sti til det implementerende modul, når status er 'implemented'." },
        "notes": { "type": "string" }
      }
    }
  },

  "$defs": {
    "dependency": {
      "type": "object",
      "required": ["ref", "range", "reason"],
      "additionalProperties": false,
      "properties": {
        "ref": { "type": "string", "pattern": "^[a-z0-9-]{2,63}$" },
        "range": { "type": "string", "minLength": 1, "description": "SemVer-interval, fx '>=1.0.0 <2.0.0' eller '^1.2.0'." },
        "reason": { "type": "string", "minLength": 10, "description": "Hvorfor afhængigheden er nødvendig. Resolveren viser den i previewet." }
      }
    },
    "optionalDependency": {
      "type": "object",
      "required": ["ref", "range", "reason"],
      "additionalProperties": false,
      "properties": {
        "ref": { "type": "string", "pattern": "^[a-z0-9-]{2,63}$" },
        "range": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 10 },
        "default": { "type": "boolean", "description": "Om afhængigheden medtages som standard når komponenten vælges." }
      }
    },
    "accountableHuman": {
      "type": "object",
      "description": "Et navngivet menneske. Et team-alias eller en rolle uden en person er ikke en ejer.",
      "required": ["subject", "role", "name"],
      "additionalProperties": false,
      "properties": {
        "subject": { "type": "string", "minLength": 3, "description": "Fx 'oidc|anna.andersen'. Skal navngive en person, ikke et team." },
        "name": { "type": "string", "minLength": 2 },
        "role": { "type": "string", "minLength": 2 },
        "substitute": {
          "type": "object",
          "required": ["subject", "name"],
          "additionalProperties": false,
          "properties": {
            "subject": { "type": "string", "minLength": 3 },
            "name": { "type": "string", "minLength": 2 }
          }
        }
      }
    }
  },

  "allOf": [
    {
      "if": { "required": ["componentType"], "properties": { "componentType": { "const": "security-core" } } },
      "then": { "properties": { "securityCore": { "const": true } } }
    },
    {
      "if": { "required": ["componentType"], "properties": { "componentType": { "const": "host-management" } } },
      "then": { "properties": { "securityCore": { "const": false } } }
    }
  ]
}
