{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/contracts/platform-matrix.schema.json",
  "title": "Platform Matrix",
  "description": "Navngivne og testbare OS-/arkitektur-/runtime-kombinationer (DKC-053). Hver kombination har et stabilt id, en supporttier og en konkret testkommando, så 'understøttet platform' er et efterprøvbart navn og ikke en antagelse.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "platforms"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "contracts.platform/v1alpha1" },
    "kind": { "const": "PlatformMatrix" },
    "metadata": {
      "type": "object",
      "required": ["name", "version", "description", "accountableHuman"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9-]{3,63}$" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
        "description": { "type": "string", "minLength": 10 },
        "accountableHuman": { "$ref": "#/$defs/accountableHuman" }
      }
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["id", "os", "arch", "runtime", "supportTier", "testCommand"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{2,63}$" },
          "os": { "enum": ["linux", "windows", "darwin"] },
          "arch": { "enum": ["x64", "arm64"] },
          "runtime": { "type": "string", "pattern": "^node[<>=^~ ]" },
          "supportTier": { "enum": ["supported", "best-effort", "community"] },
          "testCommand": { "type": "string", "minLength": 3, "description": "Kommando der faktisk kan køre på kombinationen, fx 'make distribution-test'." },
          "notes": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "accountableHuman": {
      "type": "object",
      "required": ["subject", "role", "name"],
      "additionalProperties": false,
      "properties": {
        "subject": { "type": "string", "minLength": 3 },
        "name": { "type": "string", "minLength": 2 },
        "role": { "type": "string", "minLength": 2 },
        "substitute": {
          "type": "object",
          "required": ["subject", "name"],
          "additionalProperties": false,
          "properties": {
            "subject": { "type": "string", "minLength": 3 },
            "name": { "type": "string", "minLength": 2 }
          }
        }
      }
    }
  }
}
