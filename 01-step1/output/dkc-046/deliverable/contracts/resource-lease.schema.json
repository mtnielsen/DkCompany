{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/contracts/resource-lease.schema.json",
  "title": "ResourceLease",
  "description": "En tidsbegrænset lease på en ressource med monotonisk fencing-token og cooldown. To agenter kan ikke holde samme ressource samtidigt, og en frigivet ressource kan ikke overtages før cooldown er udløbet.",
  "type": "object",
  "required": ["apiVersion", "kind", "resource", "fencingToken", "acquiredAt", "expiresAt", "held"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "contracts.platform/v1alpha1" },
    "kind": { "const": "ResourceLease" },
    "resource": { "type": "string", "minLength": 1 },
    "owner": { "type": ["string", "null"] },
    "fencingToken": { "type": "integer", "minimum": 1 },
    "acquiredAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "releasedAt": { "type": ["string", "null"], "format": "date-time" },
    "cooldownUntil": { "type": ["string", "null"], "format": "date-time" },
    "held": { "type": "boolean" }
  }
}
