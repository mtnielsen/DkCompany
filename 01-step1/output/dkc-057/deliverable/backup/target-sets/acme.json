      "owner": { "subject": "oidc|ingrid.iversen", "name": "Ingrid Iversen", "role": "HR Data Owner" },
      "agreementRef": "scope://customer/hr-source/read-only-2026",
      "verifiedRestore": false
    },
    {
      "sourceRef": "analytics-source",
      "handling": "no-backup",
      "owner": null,
      "agreementRef": null,
      "verifiedRestore": false
    }
  ],
  "recoveryOwner": { "subject": "oidc|cont.officer", "name": "Carla Officer", "role": "Continuity Officer" }
}
