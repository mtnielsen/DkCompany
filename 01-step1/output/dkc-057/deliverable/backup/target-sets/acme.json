{
  "apiVersion": "contracts.platform/v1alpha1",
  "kind": "BackupTargetSet",
  "metadata": {
    "name": "acme-backup-targets",
    "version": "1.0.0",
    "description": "Konfigureret backupmålsæt for tenanten acme med det lokalt monterede mål som aktivt og eksplicit håndtering af tenantens eksterne HR- og analytics-kilder.",
    "accountableHuman": {
      "subject": "oidc|anna.andersen",
      "name": "Anna Andersen",
      "role": "Platform Owner",
      "substitute": { "subject": "oidc|bo.bertelsen", "name": "Bo Bertelsen" }
    }
  },
  "tenantId": "acme",
  "serviceClassRef": "continuity/service-classes/audit-service.service-class.json",
  "activeTargetRef": "local-filesystem",
