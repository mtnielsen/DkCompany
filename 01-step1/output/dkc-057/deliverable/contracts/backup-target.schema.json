{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/contracts/backup-target.schema.json",
  "title": "Backup Target",
  "description": "DKC-057: et eksternt backupmål (objektlager eller andet) med endpoint, region, credentials-reference, kryptering, retention, schedule, båndbredde, immutabilitet, fejl-/adgangsdomæne og recoveryejer. Et mål uden verificeret WORM er ikke immutable.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "environment", "targetType", "support", "endpoint", "credentialsRef", "tls", "encryption", "retention", "schedule", "bandwidth", "failureDomain", "recoveryOwner", "status"],
  "properties": {
    "apiVersion": { "const": "contracts.platform/v1alpha1" },
    "kind": { "const": "BackupTarget" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "description", "accountableHuman"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9-]{3,63}$" },
        "version": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 10 },
        "accountableHuman": { "$ref": "#/$defs/namedHuman" },
        "labels": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "environment": { "enum": ["dev", "staging", "production"] },
    "targetType": { "enum": ["object-store", "sftp", "nas", "cloud"] },
    "support": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["supported", "unvalidated", "unsupported"] },
        "reason": { "type": "string" },
        "validatedAt": { "type": ["string", "null"], "format": "date-time" },
        "validatedBy": { "oneOf": [{ "$ref": "#/$defs/namedHuman" }, { "type": "null" }] }
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "region", "bucket"],
      "properties": {
        "url": { "type": "string", "pattern": "^(https?|s3|file)://", "minLength": 8 },
        "region": { "type": "string", "minLength": 2 },
        "bucket": { "type": "string", "minLength": 1 },
        "pathPrefix": { "type": "string" }
      }
    },
    "credentialsRef": {
      "type": "string",
      "pattern": "^(vault|k8s|env|file|kms):[A-Za-z0-9_./#:-]{3,200}$",
      "description": "En reference til hemmeligheden, aldrig hemmeligheden selv."
    },
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verify", "minVersion"],
      "properties": {
        "verify": { "type": "boolean" },
        "minVersion": { "enum": ["1.2", "1.3"] },
        "caRef": { "type": ["string", "null"] },
        "certSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "encryption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "keySeparated"],
      "properties": {
        "mode": { "enum": ["platform-managed", "customer-managed"] },
        "keyRef": { "type": ["string", "null"] },
        "keySeparated": { "const": true, "description": "Krypteringsnøglen ligger ikke på backupmålet." }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["days", "immutability"],
      "properties": {
        "days": { "type": "integer", "minimum": 1 },
        "immutability": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required", "mode", "verified"],
          "properties": {
            "required": { "type": "boolean" },
            "mode": { "enum": ["none", "object-lock-governance", "object-lock-compliance"] },
            "verified": { "type": "boolean", "description": "Er WORM/object-lock faktisk verificeret mod målet?" },
            "evidenceRef": { "type": ["string", "null"] },
            "minRetentionDays": { "type": ["integer", "null"], "minimum": 1 }
          }
        }
      }
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cron", "timezone"],
      "properties": {
        "cron": { "type": "string", "minLength": 5 },
        "timezone": { "type": "string", "minLength": 3 }
      }
    },
    "bandwidth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxMbps"],
      "properties": {
        "maxMbps": { "type": "number", "minimum": 0 },
        "window": { "type": ["string", "null"] }
      }
    },
    "failureDomain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "accessDomain", "region"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "description": "Fejldomæne (fx availability zone eller site)." },
        "accessDomain": { "type": "string", "minLength": 1, "description": "Adgangsdomæne (fx cloud-konto/projekt/credentials-scope)." },
        "region": { "type": "string", "minLength": 1 }
      }
    },
    "recoveryOwner": { "$ref": "#/$defs/namedHuman" },
    "status": { "enum": ["proposed", "approved", "rejected"] },
    "approvedBy": { "oneOf": [{ "$ref": "#/$defs/namedHuman" }, { "type": "null" }] },
    "approvedAt": { "type": ["string", "null"], "format": "date-time" }
  },
  "$defs": {
    "namedHuman": {
      "type": "object",
      "required": ["subject", "name", "role"],
      "additionalProperties": false,
      "properties": {
        "subject": { "type": "string", "minLength": 3 },
        "name": { "type": "string", "minLength": 2 },
        "role": { "type": "string", "minLength": 2 },
        "substitute": {
          "type": "object",
          "required": ["subject", "name"],
          "additionalProperties": false,
          "properties": {
            "subject": { "type": "string", "minLength": 3 },
            "name": { "type": "string", "minLength": 2 }
          }
        }
      }
    }
  }
}
