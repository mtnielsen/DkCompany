{
  "apiVersion": "contracts.platform/v1alpha1",
  "kind": "TestMatrix",
  "metadata": {
    "name": "platform-test-matrix",
    "version": "1.9.0",
    "description": "Krav-til-test-matrix for platformen: hvert obligatoriske krav mapper til navngivne checks eller til en eksplicit udestående uafhængig vurdering.",
    "accountableHuman": {
      "subject": "oidc|anna.andersen",
      "name": "Anna Andersen",
      "role": "Platform Owner",
      "substitute": {
        "subject": "oidc|bo.bertelsen",
        "name": "Bo Bertelsen"
      }
    },
    "labels": {
      "wave": "0"
    }
  },
  "matrixVersion": "1.9.0",
  "supportedEnvironments": [
    "linux-amd64-node22",
    "linux-arm64-node22",
    "windows-wsl2-amd64-node22"
  ],
  "freshnessPolicy": {
    "defaultDays": 30,
    "maxDays": 90,
    "notes": "Evidens ældre end kravets frist tæller som stale og kan ikke bestå en release-gate."
  },
  "thresholds": {
    "requireAllMandatoryPass": true,
    "allowImplementerEvidenceForRelease": false,
    "maxOpenExceptions": 0,
    "maxExceptionDays": 90,
    "acceptedBy": {
      "subject": "oidc|anna.andersen",
      "name": "Anna Andersen",
      "role": "Platform Owner",
      "substitute": {
        "subject": "oidc|bo.bertelsen",
        "name": "Bo Bertelsen"
      }
    },
    "acceptedAt": "2026-09-23T08:00:00Z",
    "notes": "Tærsklerne er foreslået og accepteret af Platform Owner. Ændringer kræver en ny version af matrixen og en ny menneskelig accept."
  },
  "stages": [
    {
      "id": "contract",
      "title": "Kontrakt og lint",
      "description": "Skemaer, kontrakteksempler og lint kører før noget andet.",
      "blocking": true,
      "commands": [
        "make validate",
        "make lint",
        "make release-check"
      ]
    },
    {
      "id": "unit",
      "title": "Enheds- og konformanstests",
      "description": "Førstepartskode efterprøves deterministisk.",
      "blocking": true,
      "commands": [
        "make test",
        "make boundary-test",
        "make persistence-test"
      ]
    },
    {
      "id": "authorization",
      "title": "Autorisation og identitet",
      "description": "Tenant, identitet, policy, godkendelser, credentials og værktøjsgrænse.",
      "blocking": true,
      "commands": [
        "make tenant-test",
        "make identity-test",
        "make approval-test",
        "make credentials-test",
        "make tool-boundary-test"
      ]
    },
    {
      "id": "integration",
      "title": "Integration mod testdobbelt",
      "description": "Gateway, adaptere og modelprovider mod mock/loopback.",
      "blocking": true,
      "commands": [
        "make gateway-test",
        "make model-gateway-test",
        "make adapter-test",
        "make iam-adapter-test"
      ]
    },
    {
      "id": "installation",
      "title": "Installation og migration",
      "description": "Produktprofiler, dependency-resolver og versionerede migrationer.",
      "blocking": true,
      "commands": [
        "make distribution-check",
        "make distribution-test",
        "make persistence-check"
      ]
    },
    {
      "id": "recovery",
      "title": "Recovery og holdbarhed",
      "description": "Audit, jobs og serviceklasser.",
      "blocking": true,
      "commands": [
        "make audit-durability-test",
        "make jobs-test",
        "make continuity-test"
      ]
    },
    {
      "id": "baseline",
      "title": "Samlet baseline og release-gate",
      "description": "Alle checks køres, og release-gaten evaluerer evidensen. En grøn enhedstest er ikke produktionsstatus.",
      "blocking": true,
      "commands": [
        "make baseline",
        "make release-gate"
      ]
    }
  ],
