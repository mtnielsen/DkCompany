{
  "apiVersion": "contracts.platform/v1alpha1",
  "kind": "ServiceClass",
  "metadata": {
    "name": "dummy-ok",
    "version": "1.0.0",
    "description": "Serviceklasse for referencemodulet dummy-ok i SMV-pilotprofilen: single-server, ikke-HA, accepteret nedetid og ekstern offsite backup.",
    "accountableHuman": {
      "subject": "oidc|anna.andersen",
      "name": "Anna Andersen",
      "role": "Platform Owner",
      "substitute": { "subject": "oidc|bo.bertelsen", "name": "Bo Bertelsen" }
    },
    "labels": { "tier": "reference", "pilot": "true" }
  },
  "moduleRef": "dummy-ok",
  "criticality": "medium",
  "biaRef": "docs/continuity/bia.md#dummy-ok",
  "failureModel": {
    "networkPartition": {
      "behavior": "fail-closed",
      "splitBrain": "forbidden",
      "quorumRequired": false,
      "description": "Mister dummy-ok forbindelsen til sin database, afvises nye skrivninger frem for at fortsætte mod en forældet kopi."
    },
    "corruptionDetection": {
      "method": "checksum ved backup og verify-restore",
      "detectionWindowMinutes": 1440
    }
  },
  "availability": {
    "targetPercent": 99.0,
    "measurementWindowDays": 30,
    "acceptedDowntime": true
  },
  "durability": {
    "confirmedWrites": {
      "rpoMinutes": 0,
      "strategy": "commit til primær database før svar",
      "basis": "BIA: et bekræftet ops-kald skal kunne spores efter svar til kalderen."
    },
    "regionFailure": {
      "rpoMinutes": 240,
      "strategy": "natlig offsite backup",
      "basis": "BIA: et regionsnedbrud er accepteret med op til fire timers tab i SMV-profilen."
    },
    "corruption": {
      "rpoMinutes": 1440,
      "strategy": "daglige snapshots med checksum",
      "basis": "BIA: korruption opdages ved verify-restore og gendannes fra seneste verificerede snapshot."
    }
  },
  "recovery": {
    "rtoMinutes": 240,
    "restoreOrder": ["database", "dummy-ok"],
    "healing": {
      "automated": false,
      "allowedActions": ["restart", "restore-from-backup"],
      "forbiddenActions": ["manual-data-edit", "disable-audit"],
      "requiresHumanApproval": ["restore-from-backup"]
    }
  },
  "replication": {
    "replicas": 1,
    "statefulMode": "stateful",
    "storageClass": "standard-rwo",
    "consistency": "strong",
    "writeMode": "single-writer",
    "activeWriters": 1,
    "upstreamSupportsMultiWriter": false
  },
  "backup": {
    "required": true,
    "mode": "external",
    "offsite": true,
    "encrypted": true,
    "restoreTested": true,
    "verifyRestoreRef": "modules/dummy-ok/conformance/evidence/verify-restore.json",
    "retentionDays": 30
  },
  "deploymentProfileCompatibility": {
    "profiles": ["single-server"],
    "haEligible": false,
    "failureDomains": 1,
    "nPlusOne": false
  },
  "serviceCommitment": {
    "state": "accepted",
    "acceptedBy": { "subject": "oidc|anna.andersen", "name": "Anna Andersen", "role": "Platform Owner" },
    "acceptedAt": "2026-09-23T08:00:00Z",
    "measured": {
      "availabilityPercent": 99.42,
