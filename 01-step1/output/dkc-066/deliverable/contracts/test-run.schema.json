{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/contracts/test-run.schema.json",
  "title": "Test Run",
  "description": "Strukturerede test-/release-resultater som separat kontrakt (ikke en scanner-silo). Hvert checkresultat bærer en navngivet ejer og en evidensreference, så en fejlet test kan vises med ansvar og bevis uden en ny formålsbygget scanner. `passed` kan ikke udledes af en manglende kørsel; `not-run` og `unknown` er distinkte.",
  "type": "object",
  "required": ["schemaVersion", "kind", "id", "generatedAt", "environment", "targetCommit", "producer", "result", "checks"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "kind": { "const": "TestRun" },
    "id": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "environment": { "enum": ["dev", "staging", "prod"] },
    "profile": { "type": "string" },
    "targetCommit": { "type": "string", "minLength": 7 },
    "artifactDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "producer": {
      "type": "object",
      "required": ["type", "name", "subject"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["ci", "runtime", "implementer", "independent-verifier"] },
        "name": { "type": "string", "minLength": 2 },
        "subject": { "type": "string", "minLength": 3 }
      }
    },
    "result": { "enum": ["passed", "failed", "skipped", "not-run", "error"] },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "status", "owner"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["pass", "fail", "skip", "not-run", "error"] },
          "owner": {
            "type": "object",
            "required": ["subject", "name", "role"],
            "additionalProperties": false,
            "properties": {
              "subject": { "type": "string", "minLength": 3 },
              "name": { "type": "string", "minLength": 2 },
              "role": { "type": "string", "minLength": 2 }
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["uri"],
              "additionalProperties": false,
              "properties": {
                "uri": { "type": "string", "minLength": 1 },
                "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
              }
            }
          },
          "reason": { "type": "string" }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["uri"],
        "additionalProperties": false,
        "properties": {
          "uri": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  }
}
