{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/contracts/disaster-recovery-plan.schema.json",
  "title": "Disaster Recovery Plan",
  "description": "DKC-042: den konkrete katastrofegendannelsesplan. Planen erklærer 3-2-1-1-0 som driftsprincip (mindst tre kopier på mindst to medier, én ekstern og én offline/immutable kopi samt mindst én verificeret restore), applikationskonsistente databasebackups med WAL-arkivering og PITR, en recovery-identitet adskilt fra primærklyngens drift, et isoleret recovery-miljø uden afhængighed af det primære IAM/DNS/secret-store, et kendt rent restorepunkt, en append-only slettejournal og en planlagt, fence-krævende failback. RPO/RTO måles for det samlede brugerflow, ikke kun databaseopstart. Skemaet håndfører formen; conformance/src/disaster-recovery.mjs og backup/src/dr håndhæver beslutningerne og kan ikke erstatte en målt øvelse mod en levende klynge.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "principle",
    "copies",
    "primaryCluster",
    "recoveryIdentity",
    "pitr",
    "recoveryEnvironment",
    "knownCleanPoint",
    "deletionJournal",
    "failback",
    "userFlow",
    "protectedBackups"
  ],
  "properties": {
    "apiVersion": { "const": "contracts.platform/v1alpha1" },
    "kind": { "const": "DisasterRecoveryPlan" },
    "metadata": {
      "type": "object",
      "required": ["name", "version", "description", "accountableHuman", "lastReviewed"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "description": { "type": "string", "minLength": 20 },
        "accountableHuman": { "$ref": "#/$defs/human" },
        "lastReviewed": { "type": "string", "format": "date" },
        "labels": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "principle": {
      "type": "object",
      "required": ["designation", "copies", "mediaTypes", "offsiteCopies", "offlineImmutableCopies", "verifiedRestores", "unrecoverableErrors"],
      "additionalProperties": false,
      "properties": {
        "designation": { "const": "3-2-1-1-0" },
        "copies": { "type": "integer", "minimum": 3 },
        "mediaTypes": { "type": "integer", "minimum": 2 },
        "offsiteCopies": { "type": "integer", "minimum": 1 },
        "offlineImmutableCopies": { "type": "integer", "minimum": 1 },
        "verifiedRestores": { "type": "integer", "minimum": 1 },
        "unrecoverableErrors": { "const": 0 }
      }
    },
    "copies": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "targetRef", "copyType", "mediaType", "failureDomain", "accessDomain", "immutable", "encrypted", "credentialsRef", "deletePermission"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
          "targetRef": { "type": "string", "minLength": 3 },
          "copyType": { "enum": ["primary", "offsite", "offline-immutable"] },
          "mediaType": { "type": "string", "minLength": 2 },
          "failureDomain": { "type": "string", "minLength": 3 },
          "accessDomain": { "type": "string", "minLength": 3 },
          "immutable": { "type": "boolean" },
          "encrypted": { "const": true },
          "credentialsRef": { "type": "string", "minLength": 3 },
          "deletePermission": { "enum": ["none", "governance-two-person", "compliance"] },
          "retentionDays": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "primaryCluster": {
      "type": "object",
      "required": ["credentialsRef", "roleId", "canDeleteProtectedBackups", "operations", "forbiddenOperations"],
      "additionalProperties": false,
      "properties": {
        "credentialsRef": { "type": "string", "minLength": 3 },
        "roleId": { "type": "string", "minLength": 2 },
        "canDeleteProtectedBackups": { "const": false },
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "forbiddenOperations": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "recoveryIdentity": {
      "type": "object",
      "required": ["profileRef", "separateFromPrimaryOperations", "humanVerifiedOnly", "twoPersonApproval", "noStandingAccess"],
      "additionalProperties": false,
      "properties": {
        "profileRef": { "type": "string", "pattern": "^[a-z0-9][a-z0-9./-]*\\.json$" },
        "separateFromPrimaryOperations": { "const": true },
        "humanVerifiedOnly": { "const": true },
        "twoPersonApproval": { "const": true },
        "noStandingAccess": { "const": true }
      }
    },
    "pitr": {
      "type": "object",
      "required": ["engine", "baseBackupSchedule", "walArchiveTarget", "pitrEnabled", "retentionHours", "consistency", "quiescence", "targetRecoveryTime", "aclReconciliation", "snapshotAloneIsInsufficient"],
      "additionalProperties": false,
      "properties": {
        "engine": { "enum": ["postgresql", "mysql", "mariadb"] },
        "baseBackupSchedule": { "type": "string", "minLength": 3 },
        "walArchiveTarget": { "type": "string", "minLength": 3 },
        "pitrEnabled": { "const": true },
        "retentionHours": { "type": "integer", "minimum": 1 },
        "consistency": { "const": "application-consistent" },
        "quiescence": {
          "type": "object",
          "required": ["method", "maxPauseSeconds", "includes"],
          "additionalProperties": false,
          "properties": {
            "method": { "type": "string", "minLength": 3 },
            "maxPauseSeconds": { "type": "integer", "minimum": 1 },
            "includes": {
              "type": "array",
              "minItems": 3,
              "uniqueItems": true,
              "items": { "enum": ["database", "objects", "config", "queue"] }
            }
          }
        },
        "targetRecoveryTime": {
          "type": "object",
          "required": ["selectable", "granularity", "boundByConfirmedWritesRpoMinutes"],
          "additionalProperties": false,
          "properties": {
            "selectable": { "const": true },
            "granularity": { "enum": ["second", "minute"] },
            "boundByConfirmedWritesRpoMinutes": { "type": "number", "minimum": 0 }
          }
        },
        "aclReconciliation": {
          "type": "object",
          "required": ["required", "method", "sources"],
          "additionalProperties": false,
          "properties": {
            "required": { "const": true },
            "method": { "type": "string", "minLength": 3 },
            "sources": {
              "type": "array",
              "minItems": 2,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 3 }
            }
          }
        },
        "snapshotAloneIsInsufficient": { "const": true }
      }
    },
    "recoveryEnvironment": {
      "type": "object",
      "required": ["isolated", "noPrimaryDependency", "networkIsolation", "manifests", "dependencies"],
      "additionalProperties": false,
      "properties": {
        "isolated": { "const": true },
        "noPrimaryDependency": { "const": true },
        "networkIsolation": { "type": "string", "minLength": 3 },
        "manifests": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 3 }
        },
        "dependencies": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": ["component", "recoveredFrom", "method"],
            "additionalProperties": false,
            "properties": {
              "component": { "enum": ["iam", "dns", "secret-store", "database", "object-storage", "queue"] },
              "recoveredFrom": { "type": "string", "minLength": 3 },
              "method": { "type": "string", "minLength": 3 }
            }
          }
        }
      }
    },
    "knownCleanPoint": {
      "type": "object",
      "required": ["backupId", "verifiedAt", "verifiedBy", "method", "evidenceRef"],
      "additionalProperties": false,
      "properties": {
        "backupId": { "type": "string", "minLength": 3 },
        "verifiedAt": { "type": "string", "format": "date-time" },
        "verifiedBy": { "$ref": "#/$defs/human" },
        "method": { "type": "string", "minLength": 3 },
        "evidenceRef": { "type": "string", "minLength": 3 }
      }
    },
    "deletionJournal": {
      "type": "object",
      "required": ["ref", "appendOnly", "hashChained", "ledgerRef"],
      "additionalProperties": false,
      "properties": {
        "ref": { "type": "string", "minLength": 3 },
        "appendOnly": { "const": true },
        "hashChained": { "const": true },
        "ledgerRef": { "type": "string", "minLength": 3 }
      }
    },
    "failback": {
      "type": "object",
      "required": ["planned", "procedure", "requiresFence", "switchoverWindow"],
      "additionalProperties": false,
      "properties": {
        "planned": { "const": true },
        "procedure": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 3 }
        },
        "requiresFence": { "const": true },
        "switchoverWindow": { "enum": ["maintenance", "immediate"] }
      }
    },
    "userFlow": {
      "type": "object",
      "required": ["id", "name", "steps", "rpoMinutes", "rtoMinutes", "includesDependencies"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^F[0-9]{1,3}$" },
        "name": { "type": "string", "minLength": 3 },
        "steps": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": ["id", "description", "component", "dependsOn"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
              "description": { "type": "string", "minLength": 3 },
              "component": { "type": "string", "minLength": 2 },
              "dependsOn": {
                "type": "array",
                "items": { "type": "string", "minLength": 2 }
              }
            }
          }
        },
        "rpoMinutes": { "type": "number", "minimum": 0 },
        "rtoMinutes": { "type": "number", "minimum": 0 },
        "includesDependencies": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": { "enum": ["iam", "dns", "secret-store", "database", "object-storage", "queue"] }
        }
      }
    },
    "protectedBackups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "copyRef", "retentionDays", "deletionGuard", "twoPersonRequired", "immutableVerified"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
          "copyRef": { "type": "string", "minLength": 2 },
          "retentionDays": { "type": "integer", "minimum": 1 },
          "deletionGuard": { "enum": ["compliance-object-lock", "governance-object-lock", "offline-airgap"] },
          "twoPersonRequired": { "const": true },
          "immutableVerified": { "const": true }
        }
      }
    }
  },
  "$defs": {
    "human": {
      "type": "object",
      "required": ["subject", "name", "role"],
      "additionalProperties": false,
      "properties": {
        "subject": { "type": "string", "minLength": 3 },
        "name": { "type": "string", "minLength": 2 },
        "role": { "type": "string", "minLength": 2 },
        "substitute": {
          "type": "object",
          "required": ["subject", "name"],
          "additionalProperties": false,
          "properties": {
            "subject": { "type": "string", "minLength": 3 },
            "name": { "type": "string", "minLength": 2 }
          }
        }
      }
    }
  }
}
