{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/contracts/log-record.schema.json",
  "title": "Log Record",
  "description": "DKC-049: én komplet, minimeret logpost for en observation, en modeludsagn, et verificeret resultat, en menneskebeslutning eller en systemhændelse. Posten bærer de fælles korrelations-ID'er (correlation, execution, incident, change, tenant, resource), den primære provenance og — for muterende handlinger — den holdbare kvittering der blev skrevet FØR mutationen. Sensordata, modeludsagn og verificerede resultater ligger i hver sin blok og må ikke blandes, så et modeludsagn aldrig kan forveksles med et verificeret resultat.",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "occurredAt",
    "recordedAt",
    "correlation",
    "scope",
    "provenance",
    "dataClassification",
    "retentionClass",
    "minimized",
    "redactions"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "kind": { "const": "LogRecord" },
    "id": { "type": "string", "minLength": 1 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "recordedAt": { "type": "string", "format": "date-time" },
    "correlation": { "$ref": "#/$defs/correlation" },
    "scope": { "$ref": "#/$defs/scope" },
    "provenance": { "enum": ["sensor", "model", "verified", "human", "system"] },
    "observation": { "$ref": "#/$defs/observation" },
    "model": { "$ref": "#/$defs/model" },
    "verification": { "$ref": "#/$defs/verification" },
    "human": { "$ref": "#/$defs/human" },
    "action": { "$ref": "#/$defs/action" },
    "receipt": { "$ref": "#/$defs/receipt" },
    "ledger": { "$ref": "#/$defs/ledger" },
    "archive": { "$ref": "#/$defs/archive" },
    "dataClassification": { "enum": ["none", "operational", "pseudonymised", "personal", "special-category", "security"] },
    "retentionClass": { "enum": ["operational", "personal", "security"] },
    "personalDataDigest": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "minimized": { "const": true },
    "redactions": { "type": "array", "items": { "type": "string" } }
  },
  "allOf": [
    {
      "if": { "properties": { "provenance": { "const": "sensor" } }, "required": ["provenance"] },
      "then": { "required": ["observation"] }
    },
    {
      "if": { "properties": { "provenance": { "const": "system" } }, "required": ["provenance"] },
      "then": { "required": ["observation"] }
    },
    {
      "if": { "properties": { "provenance": { "const": "model" } }, "required": ["provenance"] },
      "then": { "required": ["model"] }
    },
    {
      "if": { "properties": { "provenance": { "const": "verified" } }, "required": ["provenance"] },
      "then": { "required": ["verification"] }
    },
    {
      "if": { "properties": { "provenance": { "const": "human" } }, "required": ["provenance"] },
      "then": { "required": ["human"] }
    }
  ],
  "$defs": {
    "correlation": {
      "type": "object",
      "required": ["correlationId", "executionId"],
      "additionalProperties": false,
      "properties": {
        "correlationId": { "type": "string", "minLength": 1 },
        "executionId": { "type": "string", "minLength": 1 },
        "incidentId": { "type": ["string", "null"] },
        "changeId": { "type": ["string", "null"] },
        "traceId": { "type": ["string", "null"], "pattern": "^[0-9a-f]{32}$" },
        "parentId": { "type": ["string", "null"] }
      }
    },
    "scope": {
      "type": "object",
      "required": ["tenantId", "environment", "service", "resource"],
      "additionalProperties": false,
      "properties": {
        "tenantId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" },
        "environment": { "enum": ["dev", "staging", "prod"] },
        "service": { "type": "string", "minLength": 1 },
        "resource": { "type": "string", "pattern": "^res:\\/\\/[a-z0-9][a-z0-9-]{1,62}\\/[a-z][a-z0-9._-]{1,63}\\/.+$" }
      }
    },
    "observation": {
      "type": "object",
      "required": ["source", "freshness", "value"],
      "additionalProperties": false,
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "freshness": { "enum": ["fresh", "stale", "missing"] },
        "value": { "type": "object" },
        "unit": { "type": ["string", "null"] }
      }
    },
    "model": {
      "type": "object",
      "required": ["provider", "name", "promptVersion", "decisionSummary"],
      "additionalProperties": false,
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "modelVersion": { "type": ["string", "null"] },
        "promptVersion": { "type": "string", "minLength": 1 },
        "responseDigest": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "decisionSummary": { "type": "string", "minLength": 1 }
      }
    },
    "verification": {
      "type": "object",
      "required": ["verifier", "method", "artifactDigest", "result", "verifiedAt"],
      "additionalProperties": false,
      "properties": {
        "verifier": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 },
        "artifactDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "result": { "enum": ["pass", "fail", "inconclusive"] },
        "verifiedAt": { "type": "string", "format": "date-time" }
      }
    },
    "human": {
      "type": "object",
      "required": ["subject", "role", "decision", "decidedAt"],
      "additionalProperties": false,
      "properties": {
        "subject": { "type": "string", "minLength": 1 },
        "name": { "type": ["string", "null"] },
        "role": { "type": "string", "minLength": 1 },
        "decision": { "enum": ["approve", "reject", "abstain"] },
        "decidedAt": { "type": "string", "format": "date-time" }
      }
    },
    "action": {
      "type": "object",
      "required": ["mutating"],
      "additionalProperties": false,
      "properties": {
        "mutating": { "type": "boolean" },
        "tool": {
          "type": "object",
          "required": ["name", "verb", "target"],
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "verb": { "type": "string", "minLength": 1 },
            "target": { "type": "string", "minLength": 1 },
            "parameters": { "type": "object" },
            "redactions": { "type": "array", "items": { "type": "string" } }
          }
        },
        "policy": { "type": ["string", "null"] },
        "policyDigest": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "approvalDigest": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "runbookDigest": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "before": { },
        "after": { },
        "retry": { "type": "integer", "minimum": 0 },
        "fallback": { "type": ["string", "null"] }
      }
    },
    "receipt": {
      "type": "object",
      "required": ["intentId", "idempotencyId", "state", "auditEventId"],
      "additionalProperties": false,
      "properties": {
        "intentId": { "type": "string", "minLength": 1 },
        "idempotencyId": { "type": "string", "minLength": 1 },
        "state": { "enum": ["pending", "succeeded", "failed", "unknown"] },
        "auditEventId": { "type": ["string", "null"] },
        "hash": { "type": ["string", "null"] },
        "anchored": { "type": "boolean" }
      }
    },
    "ledger": {
      "type": "object",
      "required": ["stream", "seq", "prevHash", "hash"],
      "additionalProperties": false,
      "properties": {
        "stream": { "type": "string", "minLength": 1 },
        "seq": { "type": "integer", "minimum": 1 },
        "prevHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "archive": {
      "type": "object",
      "required": ["targets", "worm"],
      "additionalProperties": false,
      "properties": {
        "worm": { "type": "boolean" },
        "checkpoint": { "type": ["object", "null"] },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "failureDomain", "kind", "version", "sha256"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "failureDomain": { "type": "string", "minLength": 1 },
              "kind": { "enum": ["primary", "writable", "external", "offline"] },
              "version": { "type": "integer", "minimum": 1 },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "locked": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}
