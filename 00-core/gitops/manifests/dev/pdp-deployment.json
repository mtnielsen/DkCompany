{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "pdp",
    "namespace": "platform",
    "labels": {
      "app.kubernetes.io/name": "pdp",
      "app.kubernetes.io/managed-by": "argocd",
      "platform.example.org/module": "pdp",
      "platform.example.org/environment": "dev"
    }
  },
  "spec": {
    "replicas": 2,
    "selector": { "matchLabels": { "app.kubernetes.io/name": "pdp" } },
    "template": {
      "metadata": {
        "labels": {
          "app.kubernetes.io/name": "pdp",
          "platform.example.org/module": "pdp",
          "platform.example.org/environment": "dev"
        }
      },
      "spec": {
        "serviceAccountName": "pdp",
        "securityContext": { "runAsNonRoot": true, "seccompProfile": { "type": "RuntimeDefault" } },
        "containers": [
          {
            "name": "pdp",
            "image": "ghcr.io/example/platform-pdp@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
            "args": ["serve", "--port", "8181"],
            "ports": [{ "containerPort": 8181, "name": "http" }],
            "env": [
              { "name": "PDP_FAIL_MODE", "valueFrom": { "configMapKeyRef": { "name": "pdp-bundle", "key": "failMode" } } },
              { "name": "PDP_BUNDLE_SHA256", "valueFrom": { "configMapKeyRef": { "name": "pdp-bundle", "key": "bundleSha256" } } }
            ],
            "securityContext": {
              "readOnlyRootFilesystem": true,
              "allowPrivilegeEscalation": false,
              "capabilities": { "drop": ["ALL"] }
            },
            "readinessProbe": { "httpGet": { "path": "/healthz", "port": 8181 } },
            "livenessProbe": { "httpGet": { "path": "/healthz", "port": 8181 } },
            "resources": {
              "requests": { "cpu": "100m", "memory": "128Mi" },
              "limits": { "cpu": "500m", "memory": "256Mi" }
            }
          }
        ]
      }
    }
  }
}
